{
  "jobs": [
    {
      "id": "db-purge-orphans-weekly",
      "description": "Expurga tarefas orfas e otimiza a entropia do banco de dados para manter a performance.",
      "command": "\"$ProjectRoot/.venv/Scripts/python.exe\" \"$ProjectRoot/task_executor.py\" db-purge-orphans",
      "intervalHours": 168,
      "active": true
    },
    {
      "id": "rag-ingest-daily",
      "description": "Sincroniza a memoria coletiva (RAG) com os documentos mais recentes do projeto.",
      "command": "\"$ProjectRoot/.venv/Scripts/python.exe\" \"$ProjectRoot/memory_rag.py\" ingest",
      "intervalHours": 24,
      "active": true
    },
    {
      "id": "maverick-sentinel-daily",
      "description": "Aciona a sentinela @maverick para uma varredura sistemica em busca de pontos cegos e riscos.",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$ProjectRoot/scripts/maintenance/run_maverick_sentinel.ps1\" -TaskId SENTINEL-CRON-$(Get-Date -Format 'yyyyMMdd')",
      "intervalHours": 24,
      "active": true
    },
    {
      "id": "predictive-forest-training-daily",
      "description": "Treina o motor SOTA de Random Forest com os dados recentes de telemetria do Quiz.",
      "command": "\"$ProjectRoot/.venv/Scripts/python.exe\" \"$ProjectRoot/task_executor.py\" train-predictive",
      "intervalHours": 24,
      "active": true
    }
  ]
}

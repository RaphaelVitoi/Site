# Copy to infra/.env before running: docker compose -f infra/docker-compose.yml up -d
# Keep real keys ONLY in gitignored .env files (NEVER commit credentials).

TZ=America/Sao_Paulo

# --- n8n ---
N8N_PORT=5678
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://127.0.0.1:5678/
N8N_ENCRYPTION_KEY=replace-with-32-byte-random-hex
N8N_BASIC_AUTH_ACTIVE=false
N8N_USER_MANAGEMENT_DISABLED=false

# --- LLM Providers (OpenRouter + Host Local Engines) ---
OPENROUTER_API_KEY=

# --- RAGFlow (Cloud by default; set http://ragflow:9380 with --profile ragflow-local) ---
RAGFLOW_API_BASE=https://cloud.ragflow.io
RAGFLOW_API_KEY=
RAGFLOW_HTTP_PORT=9382
RAGFLOW_API_PORT=9380
RAGFLOW_GRPC_PORT=9381

# --- Neo4j Aura L4 Graph ---
NEO4J_AURA_URI=neo4j+s://<instance-id>.databases.neo4j.io
NEO4J_AURA_QUERY_URL=https://<instance-id>.databases.neo4j.io/db/{databaseName}/query/v2
NEO4J_AURA_USERNAME=neo4j
NEO4J_AURA_PASSWORD=

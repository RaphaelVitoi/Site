CompileFlags:
  CompilationDatabase: "core/tensor_engine"
  Add:
    - "-std=c++17"
    - "-Icore/vendor/eigen"
    - "-I.venv/Lib/site-packages/nanobind/include"
    - "-I.venv/include"
    - "-D_ALLOW_COMPILER_AND_STL_VERSION_MISMATCH"
    - "-Wno-unknown-pragmas"
    - "-Wno-unused-command-line-argument"

---
If:
  PathMatch: .*vendor/eigen/.*\.h$
CompileFlags:
  Add:
    - "-x"
    - "c++-header"

---
If:
  PathMatch: .*(vendor|worker[/\\]Java|oracleJdk).*
Index:
  Background: Skip
Diagnostics:
  Suppress: ["*"]
CompileFlags:
  Add:
    - "-w"
    - "-ferror-limit=0"
    - "-nocudainc"
    - "-nocudalib"
    - "/clang:-nocudainc"
    - "/clang:-nocudalib"

---
If:
  PathMatch: .*\.cu$
CompileFlags:
  Add:
    - "-nocudainc"
    - "-nocudalib"
    - "/clang:-nocudainc"
    - "/clang:-nocudalib"



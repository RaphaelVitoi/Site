# ==============================================================================
# NEXUS ORCHESTRATOR — .gitattributes SOTA
# Política canônica de line endings para Windows ↔ WSL ↔ Linux/CI.
# Estratégia: text=auto como base; overrides explícitos por tipo.
# Ref: https://git-scm.com/docs/gitattributes

# ── POLÍTICA GLOBAL: normaliza LF no repositório, checkout adapta ao OS ──────
* text=auto eol=lf
# ── CÓDIGO FONTE — sempre LF (canonical) ─────────────────────────────────────
*.py        text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.mjs       text eol=lf
*.cjs       text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.mdx       text eol=lf
*.sh        text eol=lf
*.bash      text eol=lf
# ── CONFIGURAÇÃO / DADOS — LF ─────────────────────────────────────────────────
*.json      text eol=lf
*.jsonc     text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.env       text eol=lf
*.env.*     text eol=lf
*.editorconfig text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf
*.prettierrc text eol=lf
Dockerfile  text eol=lf
*.dockerignore text eol=lf
# ── RUST / WASM ───────────────────────────────────────────────────────────────
*.rs        text eol=lf
# ── POWERSHELL — CRLF (runtime nativo Windows) ───────────────────────────────
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
# ── LOCK FILES — não tocar (gerados por ferramentas) ─────────────────────────
package-lock.json -text
yarn.lock         -text
pnpm-lock.yaml    -text
uv.lock           -text
# ── BINÁRIOS — nunca modificar ────────────────────────────────────────────────
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.svg       binary
*.ico       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.otf       binary
*.eot       binary
*.webp      binary
*.avif      binary
*.wasm      binary
*.db        binary
*.sqlite    binary
*.sqlite3   binary
*.db-wal    binary
*.db-shm    binary
*.exe       binary
*.dll       binary
*.so        binary
*.dylib     binary
*.bin       binary
*.tsbuildinfo binary
*.pb        binary

+const SENSITIVE_UPLOAD_NAMES = new Set(['.env', '.git', '.ssh', '.claude', '.codex', 'credentials.json']);
+const SENSITIVE_UPLOAD_EXTENSIONS = new Set(['.pem', '.key', '.p12', '.pfx', '.kdbx']);
+
+function resolveWorkspaceUploadFile(requestedPath: string): string {
+  const workspaceRoot = fs.realpathSync(process.env.GEMINI_WORKSPACE_PATH || process.cwd());
+  const candidateStat = fs.lstatSync(requestedPath);
+  if (candidateStat.isSymbolicLink()) {
+    throw new Error('Path must not be a symbolic link.');
+  }
+
+  const resolvedPath = fs.realpathSync(requestedPath);
+  const relativePath = path.relative(workspaceRoot, resolvedPath);
+  if (!relativePath || relativePath.startsWith('..') || path.isAbsolute(relativePath)) {
+    throw new Error('Path must resolve to a file inside the active workspace.');
+  }
+  if (SENSITIVE_UPLOAD_NAMES.has(path.basename(resolvedPath).toLowerCase()) || SENSITIVE_UPLOAD_EXTENSIONS.has(path.extname(resolvedPath).toLowerCase())) {
+    throw new Error('Sensitive configuration and credential files cannot be uploaded.');
+  }
+  const resolvedStats = fs.statSync(resolvedPath);
+  if (resolvedStats.isDirectory()) {
+    throw new Error('Directory uploads require an explicit reviewed manifest and are not supported by this tool.');
+  }
+  if (!resolvedStats.isFile()) {
+    throw new Error('Path must be a regular file.');
+  }
+  return resolvedPath;
+}
 

{
  "config": {
    "default": true,
    "MD001": false,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD025": false,
    "MD026": false,
    "MD028": false,
    "MD029": false,
    "MD030": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD047": false,
    "MD049": false,
    "MD052": false,
    "MD056": false,
    "MD060": false,
    "MD003": {
      "style": "atx"
    },
    "MD022": true,
    "MD031": true,
    "MD032": true
  },
  "ignores": [
    "node_modules/**",
    "**/node_modules/**",
    ".next/**",
    "**/.next/**",
    ".venv/**",
    "**/.venv/**",
    "dist/**",
    "**/dist/**",
    "build/**",
    "**/build/**",
    "coverage/**",
    "**/coverage/**",
    "temp/**",
    "**/temp/**",
    ".cache/**",
    "**/.cache/**",
    "core/vendor/**",
    "**/core/vendor/**",
    "worker/Java/**",
    "**/worker/Java/**",
    "wasm-equity/target/**",
    "**/wasm-equity/target/**",
    ".pytest_cache/**",
    "**/.pytest_cache/**",
    ".ruff_cache/**",
    "**/.ruff_cache/**",
    "reports/**",
    "**/reports/**",
    "docs/reports/**",
    "**/docs/reports/**",
    "skills/**",
    "**/skills/**",
    ".git/**",
    "**/.git/**",
    ".husky/**",
    "**/.husky/**",
    ".claude/agent-memory/**",
    "**/.claude/agent-memory/**"
  ]
}

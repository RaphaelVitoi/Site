{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Cargo Build (WASM-Equity)",
      "type": "shell",
      "command": "cargo",
      "args": [
        "build",
        "--manifest-path",
        "${workspaceFolder}/wasm-equity/Cargo.toml",
        "--bin",
        "vitoi_engine_cli",
        "--features",
        "debug_assertions"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ],
      "presentation": {
        "reveal": "silent",
        "clear": true
      }
    }
  ]
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SOTA: Vigília Ativa (File Watcher)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/do.ps1",
                "-Watch"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "SOTA: Servidor Frontend (Turbopack)",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "dev"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "SOTA: Compilação WASM Engine (Rust)",
            "type": "shell",
            "command": "wasm-pack build --target web",
            "options": {
                "cwd": "${workspaceFolder}/wasm-equity"
            },
            "group": "build",
            "problemMatcher": [
                "$rustc"
            ]
        }
    ]
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SOTA Audit: Motor Quântico (LLDB-DAP)",
      "type": "lldb-dap",
      "request": "launch",
      "program": "${workspaceFolder}/wasm-equity/target/debug/vitoi_engine_cli.exe",
      "args": [
        "--features",
        "debug_assertions"
      ],
      "cwd": "${workspaceFolder}/wasm-equity",
      "stopOnEntry": false,
      "initCommands": [
        "settings set target.x86-disassembly-flavor intel",
        "settings set plugin.jit-loader.gdb.enable on",
        "settings set target.disable-aslr true"
      ],
      "env": {
        "RUST_BACKTRACE": "1",
        "RUST_LOG": "debug"
      },
      "preLaunchTask": "Cargo Build (WASM-Equity)"
    }
  ]
}

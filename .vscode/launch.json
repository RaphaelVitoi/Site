{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SOTA GOLD: Uvicorn API (Native WSL)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "FASTAPI_DEBUG": "1",
                "UVICORN_RELOAD": "False",
                "PYTHONDONTWRITEBYTECODE": "1"
            },
            "cwd": "${workspaceFolder}"
        }
    ]
}
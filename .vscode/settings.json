{
  "terminal.integrated.env.windows": {
    "GEMINI_SOTA_MODE": "v6"
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
  "gemini-cli.model": "gemini-2.5-flash-preview-05-20",
  "gemini.auto_auditoria": true,
  "gemini.sota.version": "6.2.1-GOLD",
  "antigravity.version": "2.0.1",
  "antigravity.telemetry.enabled": false,
  "antigravity.performance.mode": "balanced",
  "ollama.executablePath": "ollama",

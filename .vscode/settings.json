  "git.autofetch": false,
  "editor.minimap.enabled": false,
  "editor.hover.delay": 700,
  "editor.largeFileOptimizations": true,
  "editor.quickSuggestionsDelay": 10,
  "extensions.autoUpdate": "onlyEnabledExtensions",
  "telemetry.telemetryLevel": "off",
  "geminicodeassist.verboseLogging": false,
  "geminicodeassist.agentDebugMode": false,
  "geminicodeassist.agentYoloMode": false,
  "geminicodeassist.enableTelemetry": false,
  "geminicodeassist.outlines.automaticOutlineGeneration": false,
  "geminicodeassist.inlineSuggestions.nextEditPredictions": true,
  "geminicodeassist.updateChannel": "Insiders",
  "geminicodeassist.codeGenerationPaneViewEnabled": true,
  "geminicodeassist.project": "gen-lang-client-0098874436",
  "geminicodeassist.rules": "Está proibido absolutamente o smoothing, o enviesamento e a artificialização de outputs, respostas não fundamentadas ou outputs que não sejam pautados na lógica e na comprovação científica e empírica. Sempre que for o caso, responda: Não sei a resposta; Não é possível ter certeza, apenas indícios. Ou qualquer tipo de resposta similar onde há a impossibilidade de definir um assunto por ausencia de evidências ou argumentação sólida. O modelo LLM deve sempre fazer perguntas acerca de inconsistências quando os inputs carecerem de informação, forem vagos, contraditórios ou equivocados. O modelo LLM não deve reproduzir e agradar como inclinação nativa: é mandatório que o modelo agregue com adendos e provocações valiosas que não constavam na instrução do user. Adotar a abordagem de fortalecer a tese ou argumento para então desafiá-lo em sua versão mais robusta, garantindo uma análise crítica de alta integridade (steelmaning).",
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/.next/**": true,
    "**/.turbo/**": true,
    "**/__pycache__/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/wasm-equity/target/**": true
  },
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/.chroma_db": true,
    "**/dist": true,
    "**/build": true
  },
  "search.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.next": true,
    "**/.turbo": true,
    "**/.chroma_db": true,
    "**/dist": true,
    "**/build": true
  },
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.ignoreRebaseWarning": true,
  "editor.unicodeHighlight.nonBasicASCII": true,
  "editor.unicodeHighlight.invisibleCharacters": true,
  "editor.unicodeHighlight.ambiguousCharacters": true,
  "files.encoding": "utf8",
  "files.autoGuessEncoding": true,
  "editor.renderControlCharacters": true,
  "editor.renderFinalNewline": "on",
  "editor.formatOnSave": true,
  "editor.codeLens": true,
  "editor.suggest.showCodeLenses": true,
  "editor.renderWhitespace": "selection",
  "editor.tabSize": 4,
  "editor.insertSpaces": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "tailwindCSS.experimental.classRegex": [
    [
      "@theme\\s*{([^}]*)}",
      "--color-([^\\s:]*)"
    ]
  ],
  "tailwindCSS.includeLanguages": {
    "plaintext": "html",
    "typescriptreact": "html"
  },
  "terminal.integrated.profiles.windows": {
    "Gemini-SOTA": {
      "path": "powershell.exe",
      "args": [
        "-NoExit",
        "-Command",
        "gemini --approval-mode auto_edit"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "Gemini-SOTA",
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, turbo.json, tsconfig.base.json, .prettierrc, .eslintrc*",

{"kind":"setContent","time":1778627011881,"id":293,"content":"[project]\r\nname = \"nexus-orchestrator\"\r\nversion = \"0.1.0\"\r\ndescription = \"Micro-servidor SOTA e Orquestrador de Agentes\"\r\ndependencies = [\r\n    \"aiohttp>=3.9.0\",\r\n    \"aiosqlite>=0.19.0\",\r\n    \"fastapi>=0.109.0\",\r\n    \"pydantic>=2.6.0\",\r\n    \"numpy>=1.26.0\",\r\n    \"pandas>=2.2.0\",\r\n    \"scikit-learn>=1.4.0\",\r\n    \"chromadb>=0.4.0\",\r\n    \"openai>=1.12.0\",\r\n    \"anthropic>=0.17.0\",\r\n    \"rich>=13.7.0\"\r\n]\r\n\r\n[tool.pytest.ini_options]\r\nminversion = \"8.0\"\r\naddopts = \"-ra -q --strict-markers\"\r\nasyncio_mode = \"auto\"\r\nasyncio_default_fixture_loop_scope = \"function\"\r\nlog_cli = true\r\nlog_cli_level = \"INFO\"\r\npythonpath = [\".\"]\r\ntestpaths = [\r\n    \"tests\",\r\n]\r\npython_files = [\"test_*.py\"]\r\n\r\n[tool.coverage.run]\r\nbranch = true\r\nsource = [\"core\", \"database\", \"engine\", \"utils\", \"api\", \"agents\", \"llm\", \"worker\", \"task_executor\"]\r\n\r\n[tool.ruff.lint]\r\nselect = [\r\n    \"E\", \"F\",     # Erros e falhas padrao\r\n    \"S\",          # flake8-bandit (Auditoria de Seguranca: senhas hardcoded, injecao SQL/Shell)\r\n    \"B\",          # flake8-bugbear (Falhas de design que levam a vazamento de memoria)\r\n    \"FAST\",       # FastAPI-specific rules (Detecta dependencias mal injetadas, rotas sem async)\r\n]\r\nignore = [\r\n    \"E501\",       # Ignorado (Friccao Zero): Prompts de LLM perdem integridade visual se quebrados forcadamente\r\n]\r\n\r\n[tool.ruff.lint.per-file-ignores]\r\n\"tests/*.py\" = [\"S101\"]\r\n\"tests/**/*.py\" = [\"S101\"]\r\n","v":1}

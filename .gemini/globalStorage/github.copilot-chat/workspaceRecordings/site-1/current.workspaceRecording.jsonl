{"kind":"setContent","time":1778652344259,"id":10,"content":"{\r\n    \"version\": \"2.0.0\",\r\n    \"tasks\": [\r\n        {\r\n            \"label\": \"SOTA: Vigília Ativa (File Watcher)\",\r\n            \"type\": \"shell\",\r\n            \"command\": \"powershell\",\r\n            \"args\": [\r\n                \"-NoProfile\",\r\n                \"-ExecutionPolicy\",\r\n                \"Bypass\",\r\n                \"-File\",\r\n                \"${workspaceFolder}/do.ps1\",\r\n                \"-Watch\"\r\n            ],\r\n            \"presentation\": {\r\n                \"reveal\": \"silent\",\r\n                \"panel\": \"shared\"\r\n            },\r\n            \"isBackground\": true,\r\n            \"problemMatcher\": [ ]\r\n        },\r\n        {\r\n            \"label\": \"SOTA: Servidor Frontend (Turbopack)\",\r\n            \"type\": \"shell\",\r\n            \"command\": \"npm\",\r\n            \"args\": [\r\n                \"run\",\r\n                \"dev\",\r\n                \"--workspace\",\r\n                \"frontend\"\r\n            ],\r\n            \"presentation\": {\r\n                \"reveal\": \"always\",\r\n                \"panel\": \"new\"\r\n            },\r\n            \"isBackground\": true,\r\n            \"problemMatcher\": [ ]\r\n        },\r\n        {\r\n            \"label\": \"SOTA: Compilação WASM Engine (Rust)\",\r\n            \"type\": \"shell\",\r\n            \"command\": \"wasm-pack build --target web\",\r\n            \"options\": {\r\n                \"cwd\": \"${workspaceFolder}/wasm-equity\"\r\n            },\r\n            \"group\": \"build\",\r\n            \"problemMatcher\": [\r\n                \"$rustc\"\r\n            ]\r\n        }\r\n    ]\r\n}\r\n","v":1}

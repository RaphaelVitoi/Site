{"kind":"setContent","time":1778698129210,"id":9,"content":"{\r\n    \"configurations\": [\r\n        {\r\n            \"name\": \"SOTA: Next.js (Frontend)\",\r\n            \"type\": \"node-terminal\",\r\n            \"request\": \"launch\",\r\n            \"command\": \"npm run dev\",\r\n            \"cwd\": \"${workspaceFolder}\"\r\n        },\r\n        {\r\n            \"name\": \"SOTA: Python Worker (Backend)\",\r\n            \"type\": \"debugpy\",\r\n            \"request\": \"launch\",\r\n            \"program\": \"${workspaceFolder}/task_executor.py\",\r\n            \"args\": [\r\n                \"worker\"\r\n            ],\r\n            \"console\": \"integratedTerminal\",\r\n            \"justMyCode\": false\r\n        }\r\n    ],\r\n    \"compounds\": [\r\n        {\r\n            \"name\": \"SOTA: Ecossistema Híbrido (Next.js + Python)\",\r\n            \"configurations\": [\r\n                \"SOTA: Next.js (Frontend)\",\r\n                \"SOTA: Python Worker (Backend)\"\r\n            ]\r\n        }\r\n    ]\r\n}\r\n","v":1}

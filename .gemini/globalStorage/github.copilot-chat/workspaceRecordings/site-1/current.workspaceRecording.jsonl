{"kind":"changed","id":486,"time":1778724285514,"edit":[[0,0,"\"\"\"\r\nGenerate and d"],[1,1,"splay the top 10 review candidates by size.\r\n\"\"\"\r\n\r\ni"],[179,179,"FILE_PATH = \"reports/review_candid"],[180,180,"tes.json\"\r\nwith open(FILE_PATH, encoding=\"utf-8\") as file_handle:\r\n    data = json.load(file_handle)\r\n\r\na"],[182,182," = [c for c in data[\"candidates\"] if not c[\"path\"].lower().startswith(\"_backups\")]\r\narr"],[309,309,"int(\r\n        f\"{i}. {c['path']} | size={c.get('size_bytes')} | mtime={c.get('mtime')} | act"],[310,310,"o"],[311,311,"={c.ge"],[313,313,"'recommended_action')}\""],[370,370," \"\r\n       "],[371,371,"f\""]],"v":5,"metadata":{"source":"unknown"}}

{"kind":"setContent","time":1778698017992,"id":29,"content":"{\r\n    \"system_info\": {\r\n        \"workspace_path\": \"c:\\\\Users\\\\Raphael\\\\.gemini\\\\Site\",\r\n        \"settings_local\": \".claude\\\\settings.local.json\",\r\n        \"version\": \"1.0.4\",\r\n        \"last_sync\": \"2026-05-13T06:15:00Z\",\r\n        \"environment\": \"production\",\r\n        \"sota_level\": \"v6\"\r\n    },\r\n    \"protected_agents_from_cleanup\": [\r\n        \"@maverick\",\r\n        \"@chico\",\r\n        \"@architect\",\r\n        \"@securitychief\",\r\n        \"@organizador\",\r\n        \"@skillmaster\",\r\n        \"@bibliotecario\",\r\n        \"@sequenciador\",\r\n        \"@historian\",\r\n        \"@auditor\",\r\n        \"@gemma4\"\r\n    ],\r\n    \"handoff_pipeline\": {\r\n        \"@dispatcher\": \"@architect\",\r\n        \"@architect\": \"@planner\",\r\n        \"@planner\": \"@pesquisador\",\r\n        \"@pesquisador\": \"@prompter\",\r\n        \"@prompter\": \"@auditor\",\r\n        \"@auditor\": \"@implementor\",\r\n        \"@implementor\": \"@verifier\",\r\n        \"@verifier\": \"@curator\",\r\n        \"@curator\": \"@sequenciador\",\r\n        \"@sequenciador\": \"@historian\"\r\n    },\r\n    \"workflow_flags\": {\r\n        \"enable_dynamic_fallback\": true,\r\n        \"enable_dispatcher_schema_retry\": true,\r\n        \"enable_security_gate\": true,\r\n        \"enable_domain_validation_gate\": true,\r\n        \"enable_strategy_gate\": true,\r\n        \"enable_research_gate\": true,\r\n        \"prefer_cost_saving_mode\": true,\r\n        \"anthropic_last\": true\r\n    },\r\n    \"priority_weights\": {\r\n        \"alpha\": 1.0,\r\n        \"beta\": 1.5,\r\n        \"gamma\": 0.5,\r\n        \"lambda_age\": 0.01\r\n    },\r\n    \"dispatcher_fallback_config\": {\r\n        \"base_pipeline\": [\r\n            \"@architect\",\r\n            \"@planner\",\r\n            \"@implementor\",\r\n            \"@verifier\",\r\n            \"@curator\"\r\n        ],\r\n        \"conditional_injections\": [\r\n            {\r\n                \"gate\": \"enable_strategy_gate\",\r\n                \"heuristic\": \"strategic_terms\",\r\n                \"agent\": \"@maverick\",\r\n                \"position\": 1\r\n            },\r\n            {\r\n                \"gate\": \"enable_research_gate\",\r\n                \"heuristic\": \"research_terms\",\r\n                \"agent\": \"@pesquisador\",\r\n                \"position\": 2\r\n            },\r\n            {\r\n                \"gate\": \"enable_security_gate\",\r\n                \"heuristic\": \"security_terms\",\r\n                \"agent\": \"@securitychief\",\r\n                \"position\": 4\r\n            },\r\n            {\r\n                \"gate\": \"enable_web_infra_gate\",\r\n                \"heuristic\": \"web_infra_terms\",\r\n                \"agent\": \"@implementor\",\r\n                \"position\": 5\r\n            },\r\n            {\r\n                \"gate\": \"enable_orchestration_gate\",\r\n                \"heuristic\": \"orchestration_terms\",\r\n                \"agent\": \"@chico\",\r\n                \"position\": 6\r\n            },\r\n            {\r\n                \"gate\": \"enable_domain_validation_gate\",\r\n                \"heuristic\": \"domain_terms\",\r\n                \"agent\": \"@validador\",\r\n                \"position\": 7\r\n            }\r\n        ]\r\n    },\r\n    \"system_heuristics\": {\r\n        \"heuristic_threshold\": 2,\r\n        \"rag_ignore_patterns\": [\r\n            \".venv\",\r\n            \".git\",\r\n            \".chroma_db\",\r\n            \"__pycache__\",\r\n            \"node_modules\",\r\n            \".archive\"\r\n        ],\r\n        \"technical_agents\": [\r\n            \"@implementor\",\r\n            \"@verifier\",\r\n            \"@skillmaster\",\r\n            \"@organizador\",\r\n            \"@sequenciador\",\r\n            \"@gemma4\"\r\n        ]\r\n    },\r\n    \"routing_heuristics\": {\r\n        \"edge_inference_terms\": {\r\n            \"gemma\": 3,\r\n            \"local\": 2,\r\n            \"inferencia\": 2,\r\n            \"borda\": 3,\r\n            \"directml\": 3,\r\n            \"ollama\": 3,\r\n            \"nash-ia\": 3,\r\n            \"latencia\": 2\r\n        },\r\n        \"research_terms\": {\r\n            \"pesquisa\": 2,\r\n            \"research\": 2,\r\n            \"benchmark\": 3,\r\n            \"mercado\": 2,\r\n            \"competidor\": 2,\r\n            \"fonte\": 1,\r\n            \"referencia\": 1,\r\n            \"web\": 1,\r\n            \"sota\": 3\r\n        },\r\n        \"strategic_terms\": {\r\n            \"estrateg\": 3,\r\n            \"roadmap\": 2,\r\n            \"visao\": 2,\r\n            \"tradeoff\": 2,\r\n            \"produto\": 1,\r\n            \"governanca\": 1,\r\n            \"hipotese\": 2,\r\n            \"cenario\": 1\r\n        },\r\n        \"security_terms\": {\r\n            \"auth\": 3,\r\n            \"autentic\": 3,\r\n            \"token\": 2,\r\n            \"rbac\": 3,\r\n            \"cors\": 2,\r\n            \"secret\": 3,\r\n            \"chave\": 2,\r\n            \"vazamento\": 3,\r\n            \"seguranca\": 3,\r\n            \"privacy\": 3,\r\n            \"compliance\": 2,\r\n            \"ethics\": 1\r\n        },\r\n        \"domain_terms\": {\r\n            \"icm\": 3,\r\n            \"gto\": 3,\r\n            \"nash\": 3,\r\n            \"ev\": 2,\r\n            \"roi\": 2,\r\n            \"rp\": 2,\r\n            \"bf\": 2,\r\n            \"bayes\": 2,\r\n            \"matemat\": 2,\r\n            \"calculo\": 2,\r\n            \"poker\": 2,\r\n            \"datascience\": 2,\r\n            \"jurid\": 1,\r\n            \"medic\": 1,\r\n            \"financ\": 1,\r\n            \"psychology\": 1,\r\n            \"philosophy\": 1,\r\n            \"science\": 1\r\n        },\r\n        \"web_infra_terms\": {\r\n            \"next.js\": 3,\r\n            \"react\": 3,\r\n            \"frontend\": 2,\r\n            \"backend\": 2,\r\n            \"ui\": 1,\r\n            \"ux\": 1,\r\n            \"web\": 1,\r\n            \"componente\": 1,\r\n            \"gamificacao\": 2\r\n        },\r\n        \"orchestration_terms\": {\r\n            \"autopoiese\": 3,\r\n            \"maverick\": 2,\r\n            \"fila\": 1,\r\n            \"task_executor\": 3,\r\n            \"orquestracao\": 3,\r\n            \"agente\": 1,\r\n            \"workflow\": 2,\r\n            \"pipeline\": 2,\r\n            \"script\": 1,\r\n            \"powershell\": 1,\r\n            \"python\": 1\r\n        }\r\n    },\r\n    \"agent_sla\": {\r\n        \"default\": {\r\n            \"llm_timeout_seconds\": 600,\r\n            \"provider_retries\": 1,\r\n            \"dispatcher_schema_retries\": 1\r\n        },\r\n        \"@dispatcher\": {\r\n            \"llm_timeout_seconds\": 240,\r\n            \"provider_retries\": 1,\r\n            \"dispatcher_schema_retries\": 1\r\n        },\r\n        \"@implementor\": {\r\n            \"llm_timeout_seconds\": 900,\r\n            \"provider_retries\": 2\r\n        },\r\n        \"@chico\": {\r\n            \"llm_timeout_seconds\": 3600,\r\n            \"provider_retries\": 5,\r\n            \"bypass_security_gates\": true,\r\n            \"tier\": 1\r\n        }\r\n    },\r\n    \"model_health_gate\": {\r\n        \"enabled\": true,\r\n        \"window_minutes\": 180,\r\n        \"min_attempts\": 3,\r\n        \"min_success_rate_pct\": 10.0,\r\n        \"drop_only_free_models\": true,\r\n        \"protect_models\": [\r\n            \"gemini-2.0-flash\",\r\n            \"gemini-1.5-pro\"\r\n        ]\r\n    },\r\n    \"model_routing\": {\r\n        \"deep_thinking\": [\r\n            \"gemini-1.5-pro\",\r\n            \"deepseek/deepseek-r1:free\",\r\n            \"gemini-2.0-flash\"\r\n        ],\r\n        \"fast_operations\": [\r\n            \"gemini-2.0-flash\",\r\n            \"meta-llama/llama-3.1-8b-instruct\"\r\n        ],\r\n        \"coding\": [\r\n            \"gemini-1.5-pro\",\r\n            \"qwen/qwen3-next-80b-a3b-instruct:free\",\r\n            \"qwen/qwen3-coder:free\"\r\n        ],\r\n        \"general_purpose\": [\r\n            \"gemini-2.0-flash\",\r\n            \"meta-llama/llama-3.1-8b-instruct\"\r\n        ],\r\n        \"openrouter_alternatives\": [\r\n            \"meta-llama/llama-3.1-8b-instruct\",\r\n            \"deepseek/deepseek-r1:free\",\r\n            \"qwen/qwen3-coder:free\",\r\n            \"openai/gpt-oss-20b:free\",\r\n            \"qwen/qwen3-next-80b-a3b-instruct:free\"\r\n        ]\r\n    },\r\n    \"system_prompts\": {\r\n        \"global_context\": \"You are part of a multi-agent swarm. Always maintain the persona defined in your specific agent profile and follow the handoff pipeline for task transitions.\"\r\n    }\r\n}\r\n","v":1}

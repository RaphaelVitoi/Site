{"kind":"changed","id":317,"time":1778651724226,"edit":[[0,1215,"# ==============================================================================\r\n# PROTOCOLO VITOI 3.2 - BLINDAGEM DE CONTEXTO (FRICÇÃO ZERO E SHANNON ECONOMY)\r\n# Gemini CLI Ignore File - Optimize Token Usage\r\n# ==============================================================================\r\n\r\n# 1. INFRAESTRUTURA, CACHE E DEPENDÊNCIAS (Densidade Zero)\r\n.venv/\r\nnode_modules/\r\ntarget/\r\nbuild/\r\ndist/\r\nout/\r\n.next/\r\n.next-dev/\r\n.next-build/\r\n__pycache__/\r\n.mypy_cache/\r\n.pytest_cache/\r\n.ruff_cache/\r\n.tox/\r\n.idea/\r\n.turbo/\r\n*.egg-info/\r\ncoverage/\r\n\r\n# 2. BANCOS DE DADOS E VETORES (Opacidade Binária)\r\n.chroma_db/\r\n*.db\r\n*.db-shm\r\n*.db-wal\r\n*.sqlite\r\n*.sqlite3\r\n\r\n# 3. FONTES E ÍCONES E MÍDIA (Ruído Inútil para LLM)\r\n*.ico\r\n*.woff\r\n*.woff2\r\n*.ttf\r\n*.png\r\n*.jpg\r\n*.jpeg\r\n*.gif\r\n*.svg\r\n\r\n# 4. LOGS, BACKUPS E TELEMETRIA SOTA\r\n.claude/logs/\r\n.claude/.archive/\r\n_backups/\r\n.backups/\r\n.backups_sota/\r\nNEXUS_SOTA_BACKUP_*/\r\nlogs/\r\ntemp/\r\ntmp/\r\n*.log\r\n*.bak\r\n*.jsonl\r\n\r\n# 5. LOCKFILES E AMBIENTE (Prevenção de Vazamento/Ruído)\r\npackage-lock.json\r\nyarn.lock\r\npnpm-lock.yaml\r\nuv.lock\r\n*.tsbuildinfo\r\n.env\r\n.env.*\r\n\r\n# 6. EXCEÇÕES ESTRATÉGICAS (Permitidos)\r\n!manifest.json\r\n!agents_manifest.json\r\n!intentmap.json\r\n!system_config.json\r\n"]],"v":2,"metadata":{"source":"unknown","name":"pushEditOperation"}}

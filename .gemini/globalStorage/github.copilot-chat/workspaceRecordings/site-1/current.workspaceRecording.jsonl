      },\r\n        \"use-sync-external-store\": {\r\n          \"optional\": true\r\n        }\r\n      }\r\n    },\r\n    \"node_modules/zwitch\": {\r\n      \"version\": \"2.0.4\",\r\n      \"license\": \"MIT\",\r\n      \"funding\": {\r\n        \"type\": \"github\",\r\n        \"url\": \"https://github.com/sponsors/wooorm\"\r\n      }\r\n    }\r\n  }\r\n}\r\n","v":1}

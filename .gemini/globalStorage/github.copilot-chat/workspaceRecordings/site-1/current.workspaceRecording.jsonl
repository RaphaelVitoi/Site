{"kind":"setContent","time":1778732414226,"id":517,"content":"param(\n    [Parameter(Mandatory = $true, Position = 0)]\n    [ValidateSet(\"do\", \"status\", \"cleanup\", \"dashboard\")]\n    [string]$Skill,\n\n    [Parameter(ValueFromRemainingArguments = $true)]\n    [string[]]$Payload\n)\n\n. (Join-Path $PSScriptRoot \"NexusScriptTools.ps1\")\n\n$ProjectRoot = Get-NexusProjectRoot -StartDir $PSScriptRoot\n$PythonCmd = Get-NexusPythonCmd -ProjectRoot $ProjectRoot\n$NexusCli = Join-Path $ProjectRoot \"scripts\\cli\\nexus.py\"\n$DoScript = Join-Path $ProjectRoot \"do.ps1\"\n$CleanupScript = Join-Path $ProjectRoot \"scripts\\maintenance\\run_cleanup_sota.ps1\"\n\nfunction Write-ChicoLog {\n    param($Message, $Type = \"INFO\")\n    $timestamp = Get-Date -Format \"yyyy-MM-dd HH:mm:ss\"\n    Write-Output \"[$timestamp] [$Type] Chico-Skill: $Message\"\n}\n\ntry {\n    Write-ChicoLog \"Invocando '$Skill' com payload: $Payload\"\n\n    switch ($Skill) {\n        \"do\" {\n            & $DoScript -Prompt ($Payload -join \" \")\n        }\n        \"status\" {\n            & $PythonCmd $NexusCli \"status\"\n        }\n        \"cleanup\" {\n            & powershell -NoProfile -ExecutionPolicy Bypass -File $CleanupScript\n        }\n        \"dashboard\" {\n            if ($Payload -contains \"-Live\") {\n                & $PythonCmd $NexusCli \"monitor\"\n            }\n            else {\n                & $PythonCmd $NexusCli \"dashboard\"\n            }\n        }\n    }\n}\ncatch {\n    Write-ChicoLog $_.Exception.Message \"ERROR\"\n    exit 1\n}\nfinally {\n    Write-ChicoLog \"Operacao concluida.\"\n}\n","v":1}

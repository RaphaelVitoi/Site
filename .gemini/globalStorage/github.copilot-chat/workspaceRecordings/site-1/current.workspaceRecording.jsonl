{"kind":"setContent","time":1778678322714,"id":71,"content":"/**\r\n * SOTA: Registro Mestre de Rotas\r\n * Centraliza a inteligência de navegação para garantir consistência entre Header, Footer, Sitemap e Biblioteca.\r\n */\r\n\r\nexport const ROUTES = {\r\n  HOME: '/',\r\n  QUEM_SOU: '/quem-sou',\r\n  BIBLIOTECA: '/biblioteca',\r\n  SIMULADOR: '/simulador',\r\n  DASHBOARD: '/dashboard',\r\n  QUIZ: '/quiz',\r\n  O_AUTOR: '/quem-sou',\r\n  TEMPLO: {\r\n    ANALYTICS: '/templo/analytics',\r\n    GEMMA: '/templo/gemma',\r\n  },\r\n  ARTIGOS: {\r\n    ESTADO_DA_ARTE: '/artigos/estado-da-arte',\r\n    SMART_SNIPER: '/artigos/smart-sniper',\r\n    VALIDACAO_SMART_SNIPER: '/artigos/validacao-smart-sniper',\r\n  },\r\n  AULAS: {\r\n    MASTERCLASS: '/aulas/icm-masterclass',\r\n    POS_FLOP: '/aulas/icm-pos-flop',\r\n    LEITURA_ICM: '/aulas/leitura-icm',\r\n    CONCEITOS: '/aulas/conceitos-icm',\r\n  },\r\n  LIBRARY: {\r\n    DOWNWARD_DRIFT: '/biblioteca/downward-drift-sota',\r\n    INSOLVENCIA_POT_ODDS: '/biblioteca/insolvencia-das-pot-odds',\r\n    RISCO_RESSURREICAO: '/biblioteca/risco-de-ressurreicao',\r\n    FATOR_PSI: '/biblioteca/fator-psi-maluquice-humana',\r\n    HEURISTICA_POS_FLOP: '/biblioteca/heuristica-icm-pos-flop-aula',\r\n    GEOMETRIA_RISCO: '/biblioteca/geometria-do-risco',\r\n    MANIFESTO_SOTA: '/biblioteca/manifesto-sota-axiomas',\r\n    FALACIA_EQUILIBRIO: '/biblioteca/falacia-equilibrio-pedagogia',\r\n    LAB_CHIPEV_ICMEV: '/biblioteca/laboratorio-chipev-vs-icmev',\r\n    EV_FOLD_DINAMICO: '/biblioteca/axioma-ev-fold-dinamico',\r\n    TEORIA_PERSPECTIVA: '/biblioteca/teoria-da-perspectiva',\r\n    TETO_EQUIDADE: '/biblioteca/teto-equidade-river-icm',\r\n    TOY_GAMES: '/biblioteca/toy-games',\r\n    EXEGESE_DECISAO: '/biblioteca/exegese-da-decisao',\r\n    HERMENEUTICA_BLEFE: '/biblioteca/hermeneutica-blefe',\r\n    PARADOXO_VALUATION: '/biblioteca/paradoxo-valuation',\r\n    VO_APRENDE_ERRADO: '/biblioteca/voce-aprende-poker-errado',\r\n    MOTOR_D
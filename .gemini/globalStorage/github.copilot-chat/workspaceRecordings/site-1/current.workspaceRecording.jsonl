{"kind":"setContent","time":1778598306985,"id":270,"content":"<!DOCTYPE html>\r\n<html lang=\"pt-BR\">\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Geometria do Risco | Architecture v2</title>\r\n\r\n    <!-- CSS Global -->\r\n    <link rel=\"stylesheet\" href=\"../../../style.css\">\r\n    <link rel=\"stylesheet\" href=\"style-overrides.css\">\r\n    <script src=\"https://cdn.tailwindcss.com\"></script>\r\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\">\r\n\r\n    <!-- Engine Dependencies (ApexCharts & html2pdf) -->\r\n    <script src=\"https://cdn.jsdelivr.net/npm/apexcharts\"></script>\r\n    <script src=\"https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js\"></script>\r\n\r\n    <!-- Fonts -->\r\n    <style>\r\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Playfair+Display:ital,wght@0,700;1,700&display=swap');\r\n    </style>\r\n\r\n    <!-- Modules -->\r\n    <script type=\"module\" src=\"main.js\"></script>\r\n</head>\r\n\r\n<body class=\"flex flex-col items-center min-h-screen p-0 md:p-8 antialiased\">\r\n\r\n    <nav class=\"fixed top-0 left-0 w-full z-50 bg-bg-deep/90 backdrop-blur-md border-b border-white/5\">\r\n        <div class=\"ticker-container py-2\">\r\n            <div class=\"ticker-content text-[10px] uppercase font-bold tracking-[0.2em] text-indigo-400\">\r\n                <span><i class=\"fa-solid fa-microchip mr-2\"></i>ICM é sobre EV monetário.</span>\r\n                <span class=\"mx-8\"><i class=\"fa-solid fa-database mr-2\"></i>Risk Premium define a distância entre o topo\r\n                    e o fundo.</span>\r\n            </div>\r\n        </div>\r\n    </nav>\r\n\r\n    <div class=\"w-full max-w-350 flex flex-col gap-6 mt-16 relative z-10\">\r\n\r\n        <header class=\"text-center py-8 relative\">\r\n            <div class=\"glow-bg\"></div>\r\n            <h1 class=\"text-5xl md:text-7xl font-black tracking-tighter mb-4 text-white\">\r\n                Geometria do <span class=\"text-gradient\">Risco</span>\r\n            </h1>\r\n            <p class=\"text-slate-400 text-xs md:text-sm font-bold uppercase tracking-[0.4em]\">Arquitetura de Decisão Web\r\n                Components</p>\r\n        </header>\r\n\r\n        <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-6 items-start px-4\">\r\n\r\n            <!-- Sidebar -->\r\n            <aside class=\"lg:col-span-4 flex flex-col gap-4 sticky top-24\">\r\n                <div class=\"glass-panel p-4\">\r\n                    <span class=\"text-xs font-black text-slate-500 uppercase tracking-widest\">Matrizes</span>\r\n                </div>\r\n\r\n                <!-- Custom Component: Lista de Cenários -->\r\n                <scenario-list id=\"main-scenario-list\"\r\n                    class=\"glass-panel p-2 max-h-[70vh] overflow-y-auto block\"></scenario-list>\r\n            </aside>\r\n\r\n            <!-- Main Stage -->\r\n            <main class=\"lg:col-span-8 flex flex-col gap-6\">\r\n                <section class=\"glass-panel p-8 relative overflow-hidden\">\r\n                    <div class=\"flex justify-between items-end border-b border-white/5 pb-6 mb-8\">\r\n                        <div>\r\n                            <span id=\"stage-context\" class=\"badge\">Contexto</span>\r\n                            <h2 id=\"stage-title\" class=\"text-3xl font-editorial font-bold text-white mt-2\">Selecione\r\n                            </h2>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"grid grid-cols-2 gap-8\">\r\n                        <!-- Custom Component: Gauges -->\r\n                        <risk-gauge id=\"gauge-ip\" label=\"Agressor\" color=\"indigo\"></risk-gauge>\r\n                        <risk-gauge id=\"gauge-oop\" label=\"Defensor\" color=\"pink\"></risk-gauge>\r\n                    </div>\r\n                </section>\r\n\r\n                <!-- Conteúdo Dinâmico -->\r\n                <div id=\"content-area\" class=\"glass-panel p-8 min-h-75\"></div>\r\n            </main>\r\n        </div>\r\n    </div>\r\n\r\n</body>\r\n\r\n</html>\r\n","v":1}

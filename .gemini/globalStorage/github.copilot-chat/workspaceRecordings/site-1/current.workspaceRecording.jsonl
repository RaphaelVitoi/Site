{"kind":"changed","id":231,"time":1778631083152,"edit":[[3461,3461,"from transformers import AutoModelForCausalLM, AutoTokenizer, TextIteratorStreamer, BitsAndBytesConfig  # noqa: E402\r\n"],[6049,6049,"-4"],[6051,6051,"b-it\")\r\nMODEL_ID = os.environ.get(\"SOTA_LOCAL_MODEL\", \"google/gemma"],[6053,6053,"-26"],[6054,6054,"-moe"],[7346,7346,"pa\"\r\nattn_im"],[7347,7347,"l = \"e"],[7348,7348,"ger"],[7349,7349," if DML_AVAILABLE else \"auto\""],[7351,7351,"\r\n# Quantização O(1) e"],[7352,7352," 8-bits: Permite r"],[7354,7354,"ar o 26B MoE nativamente sem OOM.\r\nquantization_config = Non"],[7355,7355,"\r\nif DEVICE.startswith(\"cuda\"):\r\n    quantization_config = BitsAndBytesConfig(load_in_8bit=True)\r\n    print(\"[INFRA] Quantização 8-bits (BitsAndBytes) ATIVADA para redução térmica de VRAM.\")\r\n\r\nmode"],[7487,7487,"ore\r\n    MODEL_ID, \r\n    t"],[7489,7489,"ch_dtyp"],[7490,7490,"=DTYPE, \r\n    attn_implementation=attn_impl,\r\n    quantization_config=quantization_config,\r\n    device_map=\"auto\" if quantization_config else None\r\n)\r\nif not quantization_config:\r\n    model = model.to(DEVICE)"]],"v":4,"metadata":{"source":"unknown"}}

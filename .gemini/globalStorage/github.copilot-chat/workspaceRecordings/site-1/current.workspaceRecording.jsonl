{"kind":"setContent","time":1778657495588,"id":53,"content":"{\r\n    \"tasks\": {\r\n        \"build\": {\r\n            \"dependsOn\": [\r\n                \"^build\"\r\n            ],\r\n            \"inputs\": [\r\n                \"$TURBO_DEFAULT$\",\r\n                \".env*\"\r\n            ],\r\n            \"outputs\": [\r\n                \".next/**\",\r\n                \"!.next/cache/**\",\r\n                \"dist/**\"\r\n            ]\r\n        },\r\n        \"sota:audit\": {\r\n            \"dependsOn\": [\r\n                \"build\",\r\n                \"lint\",\r\n                \"typecheck:audit\"\r\n            ],\r\n            \"cache\": false\r\n        },\r\n        \"typecheck:audit\": {\r\n            \"dependsOn\": [\r\n                \"^build\"\r\n            ]\r\n        },\r\n        \"test\": {\r\n            \"dependsOn\": [\r\n                \"build\"\r\n            ],\r\n            \"outputs\": [\r\n                \"coverage/**\"\r\n            ]\r\n        },\r\n        \"lint\": {\r\n            \"dependsOn\": [\r\n                \"^lint\"\r\n            ]\r\n        },\r\n        \"dev\": {\r\n            \"cache\": false,\r\n            \"persistent\": true\r\n        },\r\n        \"seed\": {\r\n            \"cache\": false\r\n        }\r\n    }\r\n}\r\n","v":1}

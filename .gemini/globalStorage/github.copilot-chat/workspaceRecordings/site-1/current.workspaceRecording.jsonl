{"kind":"setContent","time":1778678354463,"id":83,"content":"'use client';\r\n\r\nimport React, { useState } from 'react';\r\n\r\nexport interface CodeBlockProps {\r\n    code?: string;\r\n    children?: React.ReactNode;\r\n    language?: string;\r\n    title?: string;\r\n    className?: string;\r\n}\r\n\r\nexport default function CodeBlock( { code, children, language = 'text', title, className = '' }: Readonly<CodeBlockProps> ) {\r\n    const [copied, setCopied] = useState( false );\r\n\r\n    // Resolve o conteudo independentemente se foi passado via prop 'code' ou 'children' (Backward Compatibility)\r\n    const contentStr = code || ( typeof children === 'string' ? children : '' );\r\n\r\n    const handleCopy = async () => {\r\n        try {\r\n            if ( !contentStr ) return;\r\n            await navigator.clipboard.writeText( contentStr );\r\n            setCopied( true );\r\n            setTimeout( () => setCopied( false ), 2000 );\r\n        } catch ( err ) {\r\n            console.error( 'Falha ao copiar codigo: ', err );\r\n        }\r\n    };\r\n\r\n    return (\r\n        <div className={ `relative rounded-xl overflow-hidden border border-white/10 bg-bg-deep my-6 shadow-2xl ${className}` }>\r\n            {/* Header Bar (Estetica de Terminal SOTA) */ }\r\n            <div className=\"flex items-center justify-between px-4 py-2 bg-bg-elevated/50 border-b border-white/5 text-xs font-mono text-text-muted\">\r\n                <div className=\"flex items-center gap-2\">\r\n                    <div className=\"flex gap-1.5 opacity-70\">\r\n                        <div className=\"w-2.5 h-2.5 rounded-full bg-white/20\"></div>\r\n                        <div className=\"w-2.5 h-2.5 rounded-full bg-white/20\"></div>\r\n                        <div className=\"w-2.5 h-2.5 rounded-full bg-white/20\"></div>\r\n                    </div>\r\n                    <span className=\"ml-2 uppercase tracking-widest text-[10px] font-black text-text-dim\">{ title || language }</span>\r\n                </div>\r\n                { contentStr && (\r\n                    <button\r\n                        onClick={ handleCopy }\r\n                        className=\"flex items-center gap-1.5 hover:text-accent-indigo-light transition-colors focus:outline-none\"\r\n                        aria-label=\"Copiar código\"\r\n                        title=\"Copiar\"\r\n                    >\r\n                        { copied ? (\r\n                            <><i className=\"fa-solid fa-check text-accent-emerald\"></i> <span className=\"text-accent-emerald\">Copiado</span></>\r\n                        ) : (\r\n                            <><i className=\"fa-regular fa-copy\"></i> <span>Copiar</span></>\r\n                        ) }\r\n                    </button>\r\n                ) }\r\n            </div>\r\n\r\n            {/* Area de Codigo */ }\r\n            <div className=\"p-4 overflow-x-auto text-sm font-mono text-text-main leading-relaxed\">\r\n                <pre><code>{ children || code }</code></pre>\r\n            </div>\r\n        </div>\r\n    );\r\n}\r\n","v":1}

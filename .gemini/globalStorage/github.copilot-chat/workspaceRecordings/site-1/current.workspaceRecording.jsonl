nclude\\\\legacy\",\r\n      \"absolute\": \"C:\\\\Users\\\\Raphael\\\\.gemini\\\\Site\\\\.venv\\\\Lib\\\\site-packages\\\\torch\\\\include\\\\legacy\",\r\n      \"is_dir\": true,\r\n      \"size_bytes\": 38637,\r\n      \"mtime\": \"2026-05-08T05:50:47.661572+00:00\",\r\n      \"reason\": \"heuristic_dir\",\r\n      \"recommended_action\": \"review\"\r\n    },\r\n    {\r\n      \"path\": \".venv\\\\Lib\\\\site-packages\\\\shapely\\\\tests\\\\legacy\",\r\n      \"absolute\": \"C:\\\\Users\\\\Raphael\\\\.gemini\\\\Site\\\\.venv\\\\Lib\\\\site-packages\\\\shapely\\\\tests\\\\legacy\",\r\n      \"is_dir\": true,\r\n      \"size_bytes\": 368914,\r\n      \"mtime\": \"2026-05-09T06:51:53.866542+00:00\",\r\n      \"reason\": \"heuristic_dir\",\r\n      \"recommended_action\": \"review\"\r\n    },\r\n    {\r\n      \"path\": \".venv\\\\Lib\\\\site-packages\\\\pip\\\\_internal\\\\resolution\\\\legacy\",\r\n      \"absolute\": \"C:\\\\Users\\\\Raphael\\\\.gemini\\\\Site\\\\.venv\\\\Lib\\\\site-packages\\\\pip\\\\_internal\\\\resolution\\\\legacy\",\r\n      \"is_dir\": true,\r\n      \"size_bytes\": 46760,\r\n      \"mtime\": \"2026-05-07T01:38:30.174506+00:00\",\r\n      \"reason\": \"heuristic_dir\",\r\n      \"recommended_action\": \"review\"\r\n    },\r\n    {\r\n      \"path\": \".claude\\\\.archive\\\\legacy_root\",\r\n      \"absolute\": \"C:\\\\Users\\\\Raphael\\\\.gemini\\\\Site\\\\.claude\\\\.archive\\\\legacy_root\",\r\n      \"is_dir\": true,\r\n      \"size_bytes\": 9577,\r\n      \"mtime\": \"2026-04-13T01:31:12.402975+00:00\",\r\n      \"reason\": \"heuristic_dir\",\r\n      \"recommended_action\": \"review\"\r\n    },\r\n    {\r\n      \"path\": \".claude\\\\.claude\\\\.archive\",\r\n      \"absolute\": \"C:\\\\Users\\\\Raphael\\\\.gemini\\\\Site\\\\.claude\\\\.claude\\\\.archive\",\r\n      \"is_dir\": true,\r\n      \"size_bytes\": 0,\r\n      \"mtime\": \"2026-05-12T12:35:59.784148+00:00\",\r\n      \"reason\": \"heuristic_dir\",\r\n      \"recommended_act
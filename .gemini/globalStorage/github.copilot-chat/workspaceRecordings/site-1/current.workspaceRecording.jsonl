{"kind":"setContent","time":1778597881327,"id":64,"content":"\"use client\";\r\n\r\ninterface MetricRowProps {\r\n  label: string;\r\n  value: string;\r\n  colorClass: string;\r\n  loading?: boolean;\r\n  tooltipDesc?: string;\r\n}\r\n\r\nexport const MetricRow = ({\r\n  label,\r\n  value,\r\n  colorClass,\r\n  loading,\r\n  tooltipDesc,\r\n}: MetricRowProps) => {\r\n  return (\r\n    <div className=\"flex flex-col py-1.5 border-b border-white/5 last:border-0\">\r\n      <div className=\"flex justify-between items-center gap-4\">\r\n        <span className=\"text-[0.6rem] font-black uppercase tracking-widest text-text-dim cursor-default\">\r\n          {label}\r\n        </span>\r\n        <span\r\n          className={`text-[0.7rem] font-black font-mono text-right ${loading ? \"text-text-darker\" : colorClass}`}\r\n        >\r\n          {loading ? \"...\" : value}\r\n        </span>\r\n      </div>\r\n      {tooltipDesc && (\r\n        <p className=\"text-[0.45rem] text-text-darker leading-tight m-0 mt-0.5 uppercase tracking-widest\">\r\n          {tooltipDesc}\r\n        </p>\r\n      )}\r\n    </div>\r\n  );\r\n};\r\n","v":23}

{"kind":"setContent","time":1778721195194,"id":317,"content":"\"use client\";\r\n/**\r\n * IDENTITY: Visualizador de Estrutura de Payouts SOTA v4.6 GOLD\r\n * PATH: src/components/simulator/panels/PayoutsPanel.tsx\r\n *\r\n * ROLE: Exibir a curva de premiação e os valores percentuais.\r\n */\r\n\r\nimport { useMemo } from \"react\";\r\nimport {\r\n  Area,\r\n  AreaChart,\r\n  CartesianGrid,\r\n  ResponsiveContainer,\r\n  Tooltip,\r\n  XAxis,\r\n  YAxis,\r\n} from \"recharts\";\r\n\r\ninterface PayoutsPanelProps {\r\n  payouts: number[];\r\n}\r\n\r\ninterface TooltipPayloadItem {\r\n  payload: {\r\n    pos: number;\r\n    value: number;\r\n  };\r\n}\r\n\r\nconst CustomTooltip = ({\r\n  active,\r\n  payload,\r\n}: {\r\n  active?: boolean;\r\n  payload?: TooltipPayloadItem[];\r\n}) => {\r\n  if (active && payload && payload.length > 0) {\r\n    const item = payload[0];\r\n    if (!item) return null;\r\n    const data = item.payload;\r\n    return (\r\n      <div className=\"p-3 bg-slate-950/90 border border-white/10 rounded-xl shadow-2xl backdrop-blur-md\">\r\n        <p className=\"text-[0.6rem] font-black text-text-muted uppercase tracking-widest mb-1\">\r\n          {data.pos}º Lugar\r\n        </p>\r\n        <p className=\"text-[0.8rem] font-mono font-black text-accent-indigo-light\">\r\n          {data.value.toFixed(1)}%\r\n        </p>\r\n      </div>\r\n    );\r\n  }\r\n  return null;\r\n};\r\n\r\nexport default function PayoutsPanel({ payouts }: Readonly<PayoutsPanelProps>) {\r\n  const chartData = useMemo(() => {\r\n    return payouts.map((val, i) => ({\r\n      pos: i + 1,\r\n      value: val,\r\n    }));\r\n  }, [payouts]);\r\n\r\n  return (\r\n    <div className=\"glass-panel p-6 sm:p-8 lg:p-12 animate-sota-in flex flex-col gap-10 rounded-4xl bg-bg-panel/80 backdrop-blur-xl border border-white/10 shadow-2xl relative overflow-hidden transition-all duration-300\">\r\n      <div className=\"absolute -top-24 -right-24 w-48 h-48 bg-accent-indigo/5 blur-3xl rounded-full pointer-events-none\" />\r\n\r\n      <div className=\"flex justify-between items-start border-b border-white/5 pb-6\">\r\n        <div>\r\n          <h3 className=\"text-[0.75rem] font-black text-text-main uppercase tracking-[0.2em] m-0\">\r\n            Estrutura de Payouts\r\n          </h3>\r\n          <p className=\"m-0 mt-1.5 text-[0.6rem] text-text-dim font-medium uppercase tracking-wider\">\r\n            Distribuição do Pool de Premiação\r\n          </p>\r\n        </div>\r\n        <div className=\"px-4 py-1.5 rounded-xl bg-accent-emerald/10 border border-accent-emerald/20 text-[0.6rem] font-black text-accent-emerald uppercase tracking-widest flex items-center gap-2\">\r\n          <div className=\"w-1.5 h-1.5 rounded-full bg-accent-emerald animate-pulse\" />\r\n          VITOI STANDARD\r\n        </div>\r\n      </div>\r\n\r\n      <div className=\"flex flex-col gap-6\">\r\n        <div className=\"bg-black/40 p-6 rounded-3xl border border-white/5 shadow-inner\">\r\n          <div className=\"flex items-center gap-3 mb-6\">\r\n            <div className=\"w-1.5 h-1.5 rounded-full bg-accent-indigo shadow-[0_0_8px_var(--accent-indigo)]\" />\r\n            <p className=\"text-[0.65rem] font-black text-text-muted uppercase tracking-[0.2em] m-0\">\r\n              Curva de Progressão\r\n            </p>\r\n          </div>\r\n          <div className=\"h-64 w-full\">\r\n            <ResponsiveContainer\r\n              width=\"100%\"\r\n              height=\"100%\"\r\n              minWidth={10}\r\n              minHeight={10}\r\n            >\r\n              <AreaChart data={chartData}>\r\n                <defs>\r\n                  <linearGradient id=\"colorPayout\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\r\n                    <stop offset=\"5%\" stopColor=\"#818cf8\" stopOpacity={0.3} />\r\n                    <stop offset=\"95%\" stopColor=\"#818cf8\" stopOpacity={0} />\r\n                  </linearGradient>\r\n                </defs>\r\n                <CartesianGrid\r\n                  strokeDasharray=\"3 3\"\r\n                  stroke=\"rgba(255,255,255,0.05)\"\r\n                  vertical={false}\r\n                />\r\n                <XAxis\r\n                  dataKey=\"pos\"\r\n                  tick={{\r\n                    fill: \"#475569\",\r\n                    fontSize: 10,\r\n                    fontWeight: 800,\r\n                    fontFamily: \"var(--font-mono)\",\r\n                  }}\r\n                  axisLine={false}\r\n                  tickLine={false}\r\n                />\r\n                <YAxis\r\n                  tick={{\r\n                    fill: \"#475569\",\r\n                    fontSize: 10,\r\n                    fontWeight: 800,\r\n                    fontFamily: \"var(--font-mono)\",\r\n                  }}\r\n                  axisLine={false}\r\n                  tickLine={false}\r\n                  unit=\"%\"\r\n                />\r\n                <Tooltip content={<CustomTooltip />} />\r\n                <Area\r\n                  type=\"monotone\"\r\n                  dataKey=\"value\"\r\n                  stroke=\"#818cf8\"\r\n                  strokeWidth={3}\r\n                  fillOpacity={1}\r\n                  fill=\"url(#colorPayout)\"\r\n                  animationDuration={1500}\r\n                />\r\n              </AreaChart>\r\n            </ResponsiveContainer>\r\n          </div>\r\n        </div>\r\n\r\n        <div className=\"grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 overflow-x-auto scrollbar-hide pb-2\">\r\n          {payouts.map((p, i) => (\r\n            <div\r\n              key={`payout-${i}` /* NOSONAR */}\r\n              className=\"p-4 bg-black/40 border border-white/5 rounded-2xl flex flex-col gap-1 transition-all hover:bg-black/60 hover:border-accent-indigo/20 group\"\r\n            >\r\n              <span className=\"text-[0.5rem] font-black text-text-darker uppercase tracking-widest group-hover:text-text-muted transition-colors\">\r\n                {i + 1}º LUGAR\r\n              </span>\r\n              <div className=\"flex items-baseline gap-1\">\r\n                <span className=\"text-[0.9rem] font-mono font-black text-white\">\r\n                  {p.toFixed(1)}\r\n                </span>\r\n                <span className=\"text-[0.55rem] font-black text-text-muted\">\r\n                  %\r\n                </span>\r\n              </div>\r\n            </div>\r\n          ))}\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","v":4}

{"kind":"setContent","time":1778697537490,"id":365,"content":"interface LessonHeaderProps {\r\n  title: string;\r\n  category: string;\r\n  date?: string;\r\n  author?: string;\r\n}\r\n\r\nexport default function LessonHeader({\r\n  title,\r\n  category,\r\n  date,\r\n  author,\r\n}: Readonly<LessonHeaderProps>) {\r\n  return (\r\n    <header className=\"page-header text-center mb-16 animate-fade-up relative\">\r\n      <div className=\"absolute left-1/2 -top-10 -translate-x-1/2 w-px h-8 bg-linear-to-b from-transparent to-accent-emerald/50\" />\r\n      <p className=\"font-mono text-[0.6rem] font-black uppercase tracking-[0.3em] text-accent-emerald mb-8 inline-flex items-center gap-3\">\r\n        <span className=\"w-2 h-px bg-accent-emerald/50\" />\r\n        {category}\r\n        <span className=\"w-2 h-px bg-accent-emerald/50\" />\r\n      </p>\r\n      <h1 className=\"text-4xl sm:text-6xl font-black tracking-tighter font-heading text-white uppercase text-balance\">\r\n        {title}\r\n      </h1>\r\n\r\n      {(date || author) && (\r\n        <div className=\"mt-10 flex justify-center items-center gap-6 text-[0.65rem] font-mono text-text-muted uppercase tracking-[0.2em] font-bold\">\r\n          {author && (\r\n            <span className=\"flex items-center gap-2\">\r\n              <i className=\"fa-solid fa-gem text-accent-indigo/50\" /> {author}\r\n            </span>\r\n          )}\r\n          {author && date && (\r\n            <span className=\"w-1 h-1 rounded-full bg-white/20\" />\r\n          )}\r\n          {date && (\r\n            <span className=\"flex items-center gap-2\">\r\n              <i className=\"fa-regular fa-clock opacity-50\" />{\" \"}\r\n              {new Date(date).toLocaleDateString(\"pt-BR\", {\r\n                year: \"numeric\",\r\n                month: \"long\",\r\n                day: \"numeric\",\r\n              })}\r\n            </span>\r\n          )}\r\n        </div>\r\n      )}\r\n    </header>\r\n  );\r\n}\r\n","v":1}

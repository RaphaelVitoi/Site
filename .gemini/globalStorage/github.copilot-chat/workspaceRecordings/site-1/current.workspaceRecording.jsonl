{"kind":"setContent","time":1778598143804,"id":216,"content":"import { ImageResponse } from \"next/og\";\r\n\r\nexport const runtime = \"edge\";\r\n\r\nconst containerStyle = {\r\n  height: \"100%\",\r\n  width: \"100%\",\r\n  display: \"flex\",\r\n  flexDirection: \"column\",\r\n  alignItems: \"flex-start\",\r\n  justifyContent: \"center\",\r\n  backgroundColor: \"#111827\",\r\n  padding: \"60px\",\r\n  fontFamily: \"sans-serif\",\r\n  color: \"#fff\",\r\n  border: \"8px solid #374151\",\r\n  borderRadius: \"24px\",\r\n} as const;\r\nconst titleStyle = {\r\n  fontSize: \"64px\",\r\n  color: \"#22d3ee\",\r\n  marginBottom: \"40px\",\r\n  fontWeight: \"bold\",\r\n} as const;\r\nconst rowStyle = {\r\n  display: \"flex\",\r\n  width: \"100%\",\r\n  justifyContent: \"space-between\",\r\n  marginBottom: \"60px\",\r\n} as const;\r\nconst colStyle = { display: \"flex\", flexDirection: \"column\" } as const;\r\nconst labelStyle = { fontSize: \"36px\", color: \"#9ca3af\" } as const;\r\nconst valStyle = { fontSize: \"56px\", fontWeight: \"bold\" } as const;\r\nconst rpValStyle = {\r\n  fontSize: \"56px\",\r\n  fontWeight: \"bold\",\r\n  color: \"#fb923c\",\r\n} as const;\r\n\r\nconst boxesRowStyle = { display: \"flex\", width: \"100%\", gap: \"40px\" } as const;\r\nconst boxPureStyle = {\r\n  display: \"flex\",\r\n  flexDirection: \"column\",\r\n  flex: 1,\r\n  backgroundColor: \"#1f2937\",\r\n  padding: \"40px\",\r\n  borderRadius: \"16px\",\r\n  border: \"4px solid #4b5563\",\r\n} as const;\r\nconst boxIcmStyle = {\r\n  display: \"flex\",\r\n  flexDirection: \"column\",\r\n  flex: 1,\r\n  backgroundColor: \"#1f2937\",\r\n  padding: \"40px\",\r\n  borderRadius: \"16px\",\r\n  border: \"4px solid #9a3412\",\r\n} as const;\r\nconst boxTitlePureStyle = {\r\n  fontSize: \"36px\",\r\n  color: \"#9ca3af\",\r\n  marginBottom: \"20px\",\r\n} as const;\r\nconst boxTitleIcmStyle = {\r\n  fontSize: \"36px\",\r\n  color: \"#fb923c\",\r\n  marginBottom: \"20px\",\r\n} as const;\r\n\r\n// SOTA: Prevencao de GC Thrashing na alocacao de memoria das respostas dinamicas\r\n\r\nexport async function GET(request: Request) {\r\n  try {\r\n    const { searchParams } = new URL(request.url);\r\n\r\n    // Extracao de metricas via query string com fallbacks de sanidade\r\n    const bf = searchParams.get(\"bf\") || \"1.00\";\r\n    const rp = searchParams.get(\"rp\") || \"0.0%\";\r\n    const pureEv = searchParams.get(\"pureEv\") || \"0\";\r\n    const icmEv = searchParams.get(\"icmEv\") || \"0\";\r\n    const pot = searchParams.get(\"pot\") || \"0\";\r\n    const bet = searchParams.get(\"bet\") || \"0\";\r\n\r\n    // SOTA: Validação estrutural básica\r\n    if (\r\n      bf.length > 10 ||\r\n      rp.length > 10 ||\r\n      pureEv.length > 10 ||\r\n      icmEv.length > 10 ||\r\n      pot.length > 10 ||\r\n      bet.length > 10\r\n    ) {\r\n      return new Response(\"Payload violou o limite estrutural.\", {\r\n        status: 400,\r\n      });\r\n    }\r\n\r\n    // Conversao para avaliacao visual de impacto (Cores)\r\n    const numPureEv = Number.isNaN(Number.parseFloat(pureEv))\r\n      ? 0\r\n      : Number.parseFloat(pureEv);\r\n    const numIcmEv = Number.isNaN(Number.parseFloat(icmEv))\r\n      ? 0\r\n      : Number.parseFloat(icmEv);\r\n\r\n    return new ImageResponse(\r\n      <div {...{ style: containerStyle }}>\r\n        <h1 {...{ style: titleStyle }}>\r\n          Impacto do ICM (A Geometria do Risco)\r\n        </h1>\r\n\r\n        <div {...{ style: rowStyle }}>\r\n          <div {...{ style: colStyle }}>\r\n            <span {...{ style: labelStyle }}>Bubble Factor (BF)</span>\r\n            <span {...{ style: valStyle }}>{bf}</span>\r\n          </div>\r\n          <div {...{ style: colStyle }}>\r\n            <span {...{ style: labelStyle }}>Risk Premium (RP)</span>\r\n            <span {...{ style: rpValStyle }}>{rp}</span>\r\n          </div>\r\n          <div {...{ style: colStyle }}>\r\n            <span {...{ style: labelStyle }}>Pote / Aposta</span>\r\n            <span {...{ style: valStyle }}>\r\n              {pot} / {bet}\r\n            </span>\r\n          </div>\r\n        </div>\r\n\r\n        <div {...{ style: boxesRowStyle }}>\r\n          <div {...{ style: boxPureStyle }}>\r\n            <span {...{ style: boxTitlePureStyle }}>\r\n              ChipEV (Ilusao Linear)\r\n            </span>\r\n            <span\r\n              {...{\r\n                style: {\r\n                  fontSize: \"80px\",\r\n                  fontWeight: \"bold\",\r\n                  color: numPureEv >= 0 ? \"#4ade80\" : \"#ef4444\",\r\n                },\r\n              }}\r\n            >\r\n              {numPureEv > 0 ? \"+\" : \"\"}\r\n              {pureEv}\r\n            </span>\r\n          </div>\r\n\r\n          <div {...{ style: boxIcmStyle }}>\r\n            <span {...{ style: boxTitleIcmStyle }}>\r\n              ICM EV (Realidade Assimetrica)\r\n            </span>\r\n            <span\r\n              {...{\r\n                style: {\r\n                  fontSize: \"80px\",\r\n                  fontWeight: \"bold\",\r\n                  color: numIcmEv >= 0 ? \"#4ade80\" : \"#ef4444\",\r\n                },\r\n              }}\r\n            >\r\n              {numIcmEv > 0 ? \"+\" : \"\"}\r\n              {icmEv}\r\n            </span>\r\n          </div>\r\n        </div>\r\n      </div>,\r\n      {\r\n        width: 1200,\r\n        height: 630,\r\n        headers: {\r\n          // SOTA CDN Cache: Bloqueia o V8 Isolate de re-renderizações simultâneas no Edge\r\n          \"Cache-Control\":\r\n            \"public, max-age=31536000, s-maxage=31536000, stale-while-revalidate=86400, immutable\",\r\n        },\r\n      },\r\n    );\r\n  } catch (error: unknown) {\r\n    const msg = error instanceof Error ? error.message : \"Unknown Error\";\r\n    console.error(\r\n      \"[API SOTA] Falha estrutural ao gerar a assinatura visual OG:\",\r\n      msg,\r\n    );\r\n    return new Response(\"Internal Server Error\", { status: 500 });\r\n  }\r\n}\r\n","v":1}

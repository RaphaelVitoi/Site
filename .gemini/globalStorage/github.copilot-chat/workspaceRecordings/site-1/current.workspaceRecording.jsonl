{"kind":"setContent","time":1778598127494,"id":201,"content":"'use client';\r\n\r\nimport dynamic from 'next/dynamic';\r\n\r\nconst MasterSimulator = dynamic(\r\n  () => import( '@/components/simulator/MasterSimulator' ),\r\n  {\r\n    ssr: false,\r\n    loading: () => (\r\n      <div className=\"p-16 text-center text-text-muted\">\r\n        Carregando Motor ICM...\r\n      </div>\r\n    ),\r\n  }\r\n);\r\n\r\nexport default function SimuladorLazy() {\r\n  return <MasterSimulator />;\r\n}\r\n","v":1}

{"kind":"setContent","time":1778715475057,"id":45,"content":"{\r\n  \"name\": \"nexus-orchestrator-sota\",\r\n  \"private\": true,\r\n  \"packageManager\": \"npm@10.8.2\",\r\n  \"description\": \"Orquestrador central com arquitetura monorepo e automação de qualidade\",\r\n  \"workspaces\": [\r\n    \"frontend\"\r\n  ],\r\n  \"engines\": {\r\n    \"node\": \">=22.0.0\"\r\n  },\r\n  \"scripts\": {\r\n    \"dev\": \"npm run dev --workspace=frontend\",\r\n    \"build\": \"npm --workspace frontend run build\",\r\n    \"lint\": \"npm --workspace frontend run lint\",\r\n    \"test\": \"npm --workspace frontend run test\",\r\n    \"test:coverage\": \"npm --workspace frontend run test:coverage\",\r\n    \"sota:audit\": \"powershell -NoProfile -ExecutionPolicy Bypass -File scripts/quality-gate.ps1\",\r\n    \"sota:api\": \"python task_executor.py api\",\r\n    \"prepare\": \"husky\"\r\n  },\r\n  \"devDependencies\": {\r\n    \"husky\": \"^8.0.3\",\r\n    \"lint-staged\": \"^16.4.0\",\r\n    \"turbo\": \"^2.9.12\"\r\n  },\r\n  \"lint-staged\": {\r\n    \"frontend/**/*.{ts,tsx,js,jsx}\": [\r\n      \"npm --workspace frontend run lint -- --max-warnings=0\"\r\n    ]\r\n  }\r\n}\r\n","v":1}

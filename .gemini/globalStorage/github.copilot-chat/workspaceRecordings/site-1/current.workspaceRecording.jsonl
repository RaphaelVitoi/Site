{"kind":"changed","id":272,"time":1778600643784,"edit":[[0,4069,"export class NashSolver\r\n{\r\n    constructor ()\r\n    {\r\n        // Baseline para Pot Size Bet (PSB)\r\n        // Alpha (Bluff) = 33.3% | MDF (Defesa) = 50.0%\r\n        // Equity Call (ChipEV) = 33.3% (1/(1+2))\r\n        this.BASELINE = {\r\n            ALPHA: 33.33,\r\n            MDF: 50,\r\n            EQUITY: 33.33\r\n        };\r\n    }\r\n\r\n    /**\r\n     * Calcula o equilíbrio ajustado pelo Risk Premium\r\n     * @param {number} ipRp - Risk Premium do Agressor (IP)\r\n     * @param {number} oopRp - Risk Premium do Defensor (OOP)\r\n     * @param {number} aggressionFactor - Desvio comportamental estrito vs equilíbrio ICM (0.5 = passivo · 1.0 = equilíbrio).\r\n     * @param {number} effStack - Profundidade do Stack Efetivo para cálculo do Death Zone Dinâmico.\r\n     */\r\n    solve ( ipRp, oopRp, aggressionFactor = 1, effStack = 25 )\r\n    {\r\n        // @verifier: Input Sanitization (Garante estabilidade do motor)\r\n        const safeIpRp = Math.max( 0, Number.parseFloat( ipRp ) || 0 );\r\n        const safeOopRp = Math.max( 0, Number.parseFloat( oopRp ) || 0 );\r\n        const safeFactor = Math.max( 0.1, Math.min( 3, Number.parseFloat( aggressionFactor ) || 1 ) );\r\n        const safeEffStack = Math.max( 5, Number.parseFloat( effStack ) || 25 );\r\n\r\n        // SOTA: Teto de Morte Dinâmico (Dynamic Death Zone)\r\n        // Stacks curtos (< 25bb) exigem maior tolerância ao risco para manter a sobrevivência térmica (Death Zone sobe).\r\n        // Stacks profundos (> 50bb) possuem aversão exponencial à ruína, tornando a colisão suicídio precoce (Death Zone desce).\r\n        let dynamicDeathZone = 41 + (25 - safeEffStack) * 0.4;\r\n        dynamicDeathZone = Math.max(25, Math.min(55, dynamicDeathZone)); // Clamped [25% - 55%]\r\n\r\n        // Heurística de Ajuste ICM\r\n        // 1. Defensor (OOP): Perde MDF drasticamente conforme seu RP sobe.\r\n        //    Ganha leve incentivo de call se o IP estiver sob risco extremo (IP blefa menos).\r\n        let defense = this.BASELINE.MDF - ( safeOopRp * 1.4 ) + ( safeIpRp * 0.2 );\r\n\r\n        // 2. Agressor (IP): Aumenta blefes se OOP estiver pressionado (exploit).\r\n        //    Reduz blefes drasticamente se seu próprio RP for alto (preservação).\r\n        let bluff = this.BASELINE.ALPHA + ( safeOopRp * 1 ) - ( safeIpRp * 1.1 );\r\n\r\n        // Aplica o fator de agressividade (modulação comportamental)\r\n        bluff = bluff * safeFactor;\r\n\r\n        // 3. EV Diff (Diferença de Valor Esperado):\r\n        //    Quanto a equidade necessária \"salta\" do ChipEV (33%) para o ICM.\r\n        //    EV Diff = (Equity ICM - Equity ChipEV) = Basicamente o próprio RP (OOP) contextualizado.\r\n        let requiredEquity = this.BASELINE.EQUITY + safeOopRp;\r\n\r\n        // Clamping (Limites físicos de 0% a 100%)\r\n        defense = Math.max( 0, Math.min( 100, defense ) );\r\n        bluff = Math.max( 0, Math.min( 100, bluff ) );\r\n\r\n        return {\r\n            defense: {\r\n                value: defense.toFixed( 1 ),\r\n                delta: ( defense - this.BASELINE.MDF ).toFixed( 1 ),\r\n                label: \"MDF Ajustado\"\r\n            },\r\n            bluff: {\r\n                value: bluff.toFixed( 1 ),\r\n                delta: ( bluff - this.BASELINE.ALPHA ).toFixed( 1 ),\r\n                label: \"Freq. Bluff Ótima\"\r\n            },\r\n            evDiff: {\r\n                value: ( requiredEquity - this.BASELINE.EQUITY ).toFixed( 1 ),\r\n                totalRequired: requiredEquity.toFixed( 1 ),\r\n                label: \"EV Diff (Equity Shift)\"\r\n            },\r\n            dynamicDeathZone: dynamicDeathZone.toFixed( 1 ),\r\n            verdict: this._getVerdict( defense, bluff )\r\n        };\r\n    }\r\n\r\n    _getVerdict ( def, bluff )\r\n    {\r\n        if ( def < 35 ) return \"Overfold Massivo (Exploitável)\";\r\n        if ( bluff < 20 ) return \"Agressão Contida (Valor Puro)\";\r\n        return \"Equilíbrio GTO Padrão\";\r\n    }\r\n\r\n    /**\r\n     * Simula a decisão para uma mão específica\r\n     * @param {number} handEquity - Equidade bruta da mão (0-100)\r\n     * @param {number} requiredEquity - Equidade necessária calculada (ICM)\r\n     */\r\n    simulateHand ( handEquity, requiredEquity )\r\n    {\r\n        const diff = handEquity - requiredEquity;\r\n        const isCall = diff >= 0;\r\n\r\n        return {\r\n            action: isCall ? \"CALL\" : \"FOLD\",\r\n            margin: Math.abs( diff ).toFixed( 1 ),\r\n            isClose: Math.abs( diff ) < 2, // Margem de erro de 2%\r\n            statusClass: isCall ? \"status-positive\" : \"status-negative\"\r\n        };\r\n    }\r\n}\r\n"]],"v":2,"metadata":{"source":"unknown","name":"pushEditOperation"}}
{"kind":"changed","id":272,"time":1778600644772,"edit":[[23,25," "],[43,44,""],[46,51,""],[768,769,""],[770,771,""],[819,820,""],[821,826,""],[938,939,""],[960,961,""],[965,966,""],[972,973,""],[1012,1013,""],[1034,1035,""],[1040,1041,""],[1047,1048,""],[1088,1089,""],[1103,1104,""],[1125,1126,""],[1142,1143,""],[1149,1150,""],[1151,1152,""],[1194,1195,""],[1216,1217,""],[1225,1226,""],[1233,1234,""],[1972,1973,""],[1988,1989,""],[1994,1995,""],[2009,2010,""],[2226,2227,""],[2240,2241,""],[2246,2247,""],[2261,2262,""],[2761,2762,""],[2774,2775,""],[2787,2788,""],[2789,2790,""],[2819,2820,""],[2832,2833,""],[2843,2844,""],[2845,2846,""],[2933,2934,""],[2935,2936,""],[2964,2965,""],[2992,2993,""],[3003,3004,""],[3005,3006,""],[3124,3125,""],[3126,3127,""],[3155,3156,""],[3183,3184,""],[3194,3195,""],[3196,3197,""],[3308,3309,""],[3346,3347,""],[3357,3358,""],[3359,3360,""],[3418,3419,""],[3420,3421,""],[3545,3546,""],[3547,3548,""],[3590,3591,""],[3605,3606,""],[3645,3646,""],[3647,3648,""],[3658,3659,""],[3660,3665,""],[3681,3682,""],[3690,3691,""],[3747,3748,""],[3758,3759,""],[4079,4080,""],[4081,4082,""],[4108,4109,""],[4110,4115,""],[4301,4302,""],[4306,4307,""],[4317,4318,""],[4319,4320,""],[4354,4355,""],[4359,4360,""]],"v":3,"metadata":{"source":"unknown","name":"pushEditOperation"}}
{"kind":"changed","id":271,"time":1778600654994,"edit":[[0,34790,"import { TOY_GAMES } from '../../../scenarios_toygame.js';\r\nimport { NashSolver } from './NashSolver.js';\r\nimport './risk-gauge.js';\r\nimport './scenario-list.js';\r\nimport { SCENARIOS } from './scenarios.js';\r\n\r\nconst safeScenarios = Array.isArray(SCENARIOS) ? SCENARIOS : [];\r\nconst safeToyGames = Array.isArray(TOY_GAMES) ? TOY_GAMES : [];\r\nconst ALL_SCENARIOS = [...safeScenarios, ...safeToyGames];\r\n\r\n// --- 1. COMPONENTE DE ESTATÍSTICAS SOTA ---\r\nclass IcmStatsPanel extends HTMLElement {\r\n    update(sol, agressionFactor, isMuted) {\r\n        this.innerHTML = this._generateHTML(sol, agressionFactor, isMuted);\r\n    }\r\n\r\n    _generateHTML(sol, agressionFactor, isMuted) {\r\n        const getStatus = (v) => {\r\n            if (v > 0) return 'status-positive';\r\n            if (v < 0) return 'status-negative';\r\n            return 'status-neutral';\r\n        };\r\n\r\n        const chartHtml = this._renderChart(sol);\r\n\r\n        const muteStateClass = isMuted\r\n            ? 'bg-rose-500/10 border-rose-500/30 text-rose-400 hover:bg-rose-500/20'\r\n            : 'bg-slate-800 border-slate-700 text-slate-300 hover:bg-slate-700 hover:text-white';\r\n        const muteIcon = isMuted ? 'fa-volume-xmark' : 'fa-volume-high';\r\n        const muteText = isMuted ? 'Mutado' : 'Som Ativo';\r\n\r\n        return `\r\n            <!-- Controles de Simulação Avançada -->\r\n            <div class=\"flex items-center justify-between mb-6 bg-slate-900/30 p-3 rounded-lg border border-white/5\">\r\n                <div class=\"flex items-center gap-3\">\r\n                    <div class=\"text-[9px] font-bold uppercase tracking-widest text-slate-500\">Agressividade (IP)</div>\r\n                    <input type=\"range\" id=\"agression-slider\" min=\"0.5\" max=\"1.5\" step=\"0.1\" value=\"${agressionFactor}\" class=\"w-24 h-1 bg-slate-700 rounded-lg appearance-none cursor-pointer\">\r\n                    <span id=\"agression-value\" class=\"text-xs font-mono font-bold text-indigo-400\">${agressionFactor.toFixed(1)}x</span>\r\n                </div>\r\n                <div class=\"flex gap-4\">\r\n                    <button id=\"btn-toggle-mute\" class=\"btn-interactive text-[9px] font-bold uppercase tracking-widest px-3 py-1.5 rounded border transition-all duration-300 flex items-center gap-2 ${muteStateClass}\">\r\n                        <i class=\"fa-solid ${muteIcon}\"></i> ${muteText}\r\n                    </button>\r\n                    <button id=\"btn-export-pdf\" class=\"btn-interactive bg-slate-800 border-slate-700 text-slate-300 hover:bg-slate-700 hover:text-white text-[9px] font-bold uppercase tracking-widest px-3 py-1.5 rounded border transition-all duration-300 flex items-center gap-2\">\r\n                        <i class=\"fa-solid fa-file-pdf\"></i> PDF\r\n                    </button>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"grid grid-cols-1 md:grid-cols-2 gap-4 mb-4\">\r\n                <div class=\"bg-slate-900/50 p-4 rounded-xl border border-white/5\">\r\n                    <div class=\"flex justify-between items-start mb-2\">\r\n                        <span class=\"text-[10px] uppercase tracking-widest text-slate-500 font-bold\">${sol.bluff.label}</span>\r\n                        <span class=\"text-xs font-mono font-bold ${getStatus(sol.bluff.delta)}\">${sol.bluff.delta}%</span>\r\n                    </div>\r\n                    <div class=\"text-2xl font-mono font-bold text-white\">${sol.bluff.value}%</div>\r\n                    <div class=\"w-full bg-slate-800 h-1 mt-3 rounded-full overflow-hidden\">\r\n                        <div class=\"bg-indigo-500 h-full\" style=\"width: ${sol.bluff.value}%\"></div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"bg-slate-900/50 p-4 rounded-xl border border-white/5\">\r\n                    <div class=\"flex justify-between items-start mb-2\">\r\n                        <span class=\"text-[10px] uppercase tracking-widest text-slate-500 font-bold\">${sol.defense.label}</span>\r\n                        <span class=\"text-xs font-mono font-bold ${getStatus(sol.defense.delta)}\">${sol.defense.delta}%</span>\r\n                    </div>\r\n                    <div class=\"text-2xl font-mono font-bold text-white\">${sol.defense.value}%</div>\r\n                    <div class=\"w-full bg-slate-800 h-1 mt-3 rounded-full overflow-hidden\">\r\n                        <div class=\"bg-pink-500 h-full\" style=\"width: ${sol.defense.value}%\"></div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- EV Diff / Equity Shift Panel -->\r\n                <div class=\"ev-diff-panel col-span-1 md:col-span-2 bg-slate-900/50 p-4 rounded-xl border border-white/5 flex flex-col md:flex-row items-center justify-between gap-4\">\r\n                    <div>\r\n                        <div class=\"text-[10px] uppercase tracking-widest text-slate-500 font-bold mb-1\">${sol.evDiff.label}</div>\r\n                        <div class=\"flex items-baseline gap-2\">\r\n                            <span class=\"text-3xl font-mono font-bold text-white tracking-tighter\">${sol.evDiff.totalRequired}%</span>\r\n                            <span class=\"text-xs font-bold status-negative bg-status-negative px-2 py-0.5 rounded border\">+${sol.evDiff.value}% vs ChipEV</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"w-full md:w-1/2 flex flex-col gap-1\">\r\n                        <div class=\"flex justify-between text-[9px] font-bold text-slate-500 uppercase\"><span>Base (33%)</span><span>Risco Adicional</span></div>\r\n                        <div class=\"w-full bg-slate-800 h-2 rounded-full overflow-hidden flex\"><div class=\"bg-slate-600 h-full\" style=\"width: 33%\"></div><div class=\"bg-pink-500 h-full shadow-[0_0_10px_rgba(236,72,153,0.5)]\" style=\"width: ${Math.min(67, Number.parseFloat(sol.evDiff.value))}%\"></div></div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- Simulação Reversa -->\r\n                <div class=\"col-span-1 md:col-span-2 bg-slate-900/40 border border-white/5 rounded-xl p-4 flex items-center justify-between gap-4\">\r\n                    <div class=\"flex items-center gap-3\">\r\n                        <div class=\"w-8 h-8 rounded bg-slate-800 flex items-center justify-center text-slate-400\"><i class=\"fa-solid fa-calculator\"></i></div>\r\n                        <div class=\"flex flex-col gap-1\">\r\n                            <div class=\"text-[9px] font-bold uppercase tracking-widest text-slate-500\">Simulação Reversa</div>\r\n                            <div class=\"flex gap-2\">\r\n                                <select id=\"sim-hand-select\" class=\"bg-slate-800 border-none text-white text-[10px] rounded px-2 py-1 focus:outline-none focus:ring-1 focus:ring-indigo-500 cursor-pointer\">\r\n                                    <option value=\"\">Exemplos...</option>\r\n                                    <option value=\"65\">AA (65%)</option>\r\n                                    <option value=\"55\">KK (55%)</option>\r\n                                    <option value=\"48\">AKo (48%)</option>\r\n                                    <option value=\"42\">JJ (42%)</option>\r\n                                    <option value=\"38\">TT (38%)</option>\r\n                                    <option value=\"33\">88 (33%)</option>\r\n                                    <option value=\"28\">AJo (28%)</option>\r\n                                </select>\r\n                                <input type=\"number\" id=\"sim-equity-input\" placeholder=\"Equity %\" class=\"bg-transparent border-b border-slate-600 text-white text-sm w-16 focus:outline-none focus:border-indigo-500 transition-colors font-mono text-center\" min=\"0\" max=\"100\">\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <div id=\"sim-result\" class=\"text-right\">\r\n                        <span class=\"text-slate-600 text-[10px] uppercase font-bold\">Resultado</span>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- Gráfico Comparativo SVG -->\r\n                <div class=\"col-span-1 md:col-span-2 bg-slate-900/40 border border-white/5 rounded-xl p-4 flex flex-col items-center\">\r\n                    <span class=\"text-[9px] font-bold uppercase tracking-widest text-slate-500 mb-4\">Impacto ICM (GTO vs Ajustado)</span>\r\n                    ${chartHtml}\r\n                </div>\r\n            </div>\r\n            <div class=\"text-center\"><span class=\"badge border-indigo-500/30 text-indigo-300 bg-indigo-500/10\">${sol.verdict}</span></div>\r\n        `;\r\n    }\r\n\r\n    _renderChart(sol) {\r\n        const bBase = 33.3;\r\n        const dBase = 50;\r\n        const bIcm = Number.parseFloat(sol.bluff.value);\r\n        const dIcm = Number.parseFloat(sol.defense.value);\r\n\r\n        const bar = (x, val, color, label) => {\r\n            const h = Math.max(2, val * 0.8);\r\n            const y = 90 - h;\r\n            return `<g class=\"group cursor-help\">\r\n                        <rect x=\"${x}\" y=\"${y}\" width=\"16\" height=\"${h}\" fill=\"${color}\" rx=\"2\" class=\"transition-all duration-500 hover:opacity-80\"><title>${label}: ${val}%</title></rect>\r\n                        <text x=\"${x + 8}\" y=\"${y - 4}\" font-family=\"monospace\" font-size=\"9\" fill=\"#cbd5e1\" text-anchor=\"middle\">${val}%</text>\r\n                    </g>`;\r\n        };\r\n\r\n        return `\r\n            <svg viewBox=\"0 0 240 110\" class=\"w-full h-24 overflow-visible\">\r\n                <line x1=\"0\" y1=\"90\" x2=\"240\" y2=\"90\" stroke=\"#334155\" stroke-width=\"1\" />\r\n                <g transform=\"translate(40,0)\">\r\n                    ${bar(0, bBase, '#334155', 'GTO Base (ChipEV)')}\r\n                    ${bar(20, bIcm, '#6366f1', 'Ajustado (ICM)')}\r\n                    <text x=\"18\" y=\"105\" font-size=\"9\" font-weight=\"bold\" fill=\"#64748b\" text-anchor=\"middle\" letter-spacing=\"1\">BLUFF</text>\r\n                </g>\r\n                <g transform=\"translate(140,0)\">\r\n                    ${bar(0, dBase, '#334155', 'GTO Base (MDF)')}\r\n                    ${bar(20, dIcm, '#ec4899', 'Ajustado (ICM)')}\r\n                    <text x=\"18\" y=\"105\" font-size=\"9\" font-weight=\"bold\" fill=\"#64748b\" text-anchor=\"middle\" letter-spacing=\"1\">DEFESA</text>\r\n                </g>\r\n            </svg>\r\n            <div class=\"flex gap-4 mt-2 text-[9px] uppercase font-bold text-slate-500\">\r\n                <div class=\"flex items-center gap-1\"><div class=\"w-2 h-2 bg-slate-700 rounded-sm\"></div> Base GTO</div>\r\n                <div class=\"flex items-center gap-1\"><div class=\"w-2 h-2 bg-indigo-500 rounded-sm\"></div> ICM Ajustado</div>\r\n            </div>`;\r\n    }\r\n}\r\ncustomElements.define('icm-stats-panel', IcmStatsPanel);\r\n\r\n// --- 2. COMPONENTE MOTOR SOTA ---\r\nclass IcmGameEngine extends HTMLElement {\r\n    constructor() {\r\n        super();\r\n        this.ui = {\r\n        };\r\n\r\n        this.solver = new NashSolver();\r\n        this.currentSolution = null;\r\n        this.currentScenarioData = null;\r\n        this.agressionFactor = 1;\r\n        this.charts = {}; // Armazena instâncias do ApexCharts\r\n        this.isMuted = true;\r\n\r\n        // Cache de referências imutáveis para erradicação de Dangling Listeners\r\n        this._handleSelectBound = (e) => this.loadScenario(e.detail?.id || e.detail);\r\n        this._toggleCompareModeBound = () => this._toggleCompareMode();\r\n        this._handleInputBound = (e) => this._handleInput(e);\r\n        this._handleChangeBound = (e) => {\r\n            if (e.target.classList.contains('scenario-selector')) this.updateComparisonChart();\r\n        };\r\n        this._handleClickBound = (e) => this._handleClick(e);\r\n    }\r\n\r\n    connectedCallback() {\r\n        // DOM Scoping: Erradicação total do getElementById global\r\n        this.ui = {\r\n            list: this.querySelector('#main-scenario-list'),\r\n            gaugeIP: this.querySelector('#gauge-ip'),\r\n            gaugeOOP: this.querySelector('#gauge-oop'),\r\n            title: this.querySelector('#stage-title'),\r\n            contextBadge: this.querySelector('#stage-context'),\r\n            context: this.querySelector('#stage-context'),\r\n            singleView: this.querySelector('#single-scenario-view'),\r\n            content: this.querySelector('#content-area'),\r\n            compareArea: this.querySelector('#compare-area'),\r\n            btnCompare: this.querySelector('#btn-mode-compare')\r\n        };\r\n        this._bindEvents();\r\n        this._initialLoad();\r\n    }\r\n\r\n    _bindEvents() {\r\n        if (this.ui.list) {\r\n            this.ui.list.data = ALL_SCENARIOS;\r\n            this.ui.list.addEventListener('select', this._handleSelectBound);\r\n            this.ui.list.addEventListener('scenario-select', this._handleSelectBound);\r\n        }\r\n\r\n        if (this.ui.btnCompare) {\r\n            this.ui.btnCompare.addEventListener('click', this._toggleCompareModeBound);\r\n        }\r\n\r\n        this.addEventListener('input', this._handleInputBound);\r\n\r\n        if (this.ui.compareArea) {\r\n            this.addEventListener('change', this._handleChangeBound);\r\n        }\r\n\r\n        this.addEventListener('click', this._handleClickBound);\r\n    }\r\n\r\n    disconnectedCallback() {\r\n        // Desacoplamento cirúrgico de Listeners (Prevenção de Memory Leaks)\r\n        if (this.ui.list) {\r\n            this.ui.list.removeEventListener('select', this._handleSelectBound);\r\n            this.ui.list.removeEventListener('scenario-select', this._handleSelectBound);\r\n        }\r\n        if (this.ui.btnCompare) {\r\n            this.ui.btnCompare.removeEventListener('click', this._toggleCompareModeBound);\r\n        }\r\n        this.removeEventListener('input', this._handleInputBound);\r\n        if (this.ui.compareArea) {\r\n            this.removeEventListener('change', this._handleChangeBound);\r\n        }\r\n        this.removeEventListener('click', this._handleClickBound);\r\n\r\n        // Desacoplamento da Engine de Charts (Libera Eventos Globais de Window Resize)\r\n        if (this.charts.main) {\r\n            this.charts.main.destroy();\r\n            this.charts.main = null;\r\n        }\r\n        if (this.charts.compare) {\r\n            this.charts.compare.destroy();\r\n            this.charts.compare = null;\r\n        }\r\n    }\r\n\r\n    _toggleCompareMode() {\r\n        const isHidden = this.ui.compareArea.classList.contains('hidden');\r\n        if (isHidden) {\r\n            if (globalThis.Analytics) globalThis.Analytics.trackEvent('simulator_compare_mode', { action: 'enter' });\r\n            this.ui.compareArea.classList.remove('hidden');\r\n            if (this.ui.singleView) this.ui.singleView.classList.add('hidden');\r\n            this.ui.btnCompare.innerHTML = '<i class=\"fa-solid fa-arrow-left\"></i> Voltar';\r\n            if (this.ui.title) this.ui.title.innerText = \"Comparação Tática\";\r\n            if (this.ui.contextBadge) this.ui.contextBadge.innerText = \"Modo Análise\";\r\n            this.renderComparisonInterface();\r\n        } else {\r\n            this.ui.compareArea.classList.add('hidden');\r\n            if (this.ui.singleView) this.ui.singleView.classList.remove('hidden');\r\n            this.ui.btnCompare.innerHTML = '<i class=\"fa-solid fa-code-compare\"></i> Comparar';\r\n            if (this.currentScenarioData) this.loadScenario(this.currentScenarioData.id);\r\n        }\r\n    }\r\n\r\n    _handleInput(e) {\r\n        if (e.target.id === 'sim-equity-input') {\r\n            this.runSimulation(e.target.value);\r\n        }\r\n        if (e.target.id === 'sim-hand-select') {\r\n            const equity = e.target.value;\r\n            if (equity) {\r\n                const input = this.querySelector('#sim-equity-input');\r\n                if (input) input.value = equity;\r\n                this.runSimulation(equity);\r\n            }\r\n        }\r\n        if (e.target.id === 'agression-slider') {\r\n            this.agressionFactor = Number.parseFloat(e.target.value);\r\n            const el = this.querySelector('#agression-value');\r\n            if (el) el.innerText = this.agressionFactor.toFixed(1) + 'x';\r\n            this.recalcScenario();\r\n            if (globalThis.Analytics) globalThis.Analytics.trackEvent('simulator_agression_change', { factor: this.agressionFactor });\r\n        }\r\n    }\r\n\r\n    _handleClick(e) {\r\n        if (e.target.closest('#btn-export-pdf')) {\r\n            this.exportPDF();\r\n            if (globalThis.Analytics) globalThis.Analytics.trackEvent('simulator_export_pdf', { scenario: this.currentScenarioData?.id });\r\n        }\r\n        const btn = e.target.closest('#btn-toggle-mute');\r\n        if (btn) {\r\n            this.isMuted = !this.isMuted;\r\n            this.recalcScenario();\r\n            if (this.currentScenarioData) {\r\n                const d = this.currentScenarioData.data;\r\n                this.updateGauge(this.ui.gaugeIP, d.ip, d.oop.rp, this.currentSolution?.dynamicDeathZone);\r\n                this.updateGauge(this.ui.gaugeOOP, d.oop, d.ip.rp, this.currentSolution?.dynamicDeathZone);\r\n            }\r\n        }\r\n    }\r\n\r\n    _initialLoad() {\r\n        try {\r\n            if (ALL_SCENARIOS.length > 0) this.loadScenario(ALL_SCENARIOS[0].id);\r\n        } catch (err) {\r\n            this._handleScenarioError(err);\r\n        }\r\n    }\r\n\r\n    _handleScenarioError(err) {\r\n        if (this.ui.title) this.ui.title.innerText = \"Erro no Motor\";\r\n        if (this.ui.content) this.ui.content.innerHTML = `<div class=\"bg-rose-500/10 border border-rose-500/30 p-4 rounded text-rose-400 font-mono text-xs\">${err.message || err.stack}</div>`;\r\n    }\r\n\r\n    loadScenario(id) {\r\n        try {\r\n            const data = ALL_SCENARIOS.find(s => s.id === id);\r\n            if (!data) throw new Error(\"Cenário não encontrado.\");\r\n            this._applyScenarioData(data);\r\n            this._renderScenarioState();\r\n        } catch (err) {\r\n            this._handleScenarioError(err);\r\n        }\r\n    }\r\n\r\n    _applyScenarioData(data) {\r\n        if (globalThis.Analytics) globalThis.Analytics.trackEvent('simulator_load_scenario', { id: data.id, label: data.label });\r\n        this.currentScenarioData = data;\r\n        this.agressionFactor = 1;\r\n        if (this.ui.title) this.ui.title.innerText = data.label || '';\r\n        if (this.ui.context) this.ui.context.innerText = data.context || '';\r\n    }\r\n\r\n    _renderScenarioState() {\r\n        const data = this.currentScenarioData;\r\n        const contentHtml = (data.content && typeof data.content === 'object') ? (data.content.theory || '') : (data.content || '');\r\n        if (this.charts.main) {\r\n            this.charts.main.destroy();\r\n            this.charts.main = null;\r\n        }\r\n\r\n        const ipStackNum = Number.parseFloat(data.data?.ip?.stack) || 25;\r\n        const oopStackNum = Number.parseFloat(data.data?.oop?.stack) || 25;\r\n        const effStack = Math.min(ipStackNum, oopStackNum);\r\n\r\n        this.currentSolution = this.solver.solve(data.data.ip.rp, data.data.oop.rp, this.agressionFactor, effStack);\r\n        \r\n        if (data.data?.ip && data.data?.oop) {\r\n            this.updateGauge(this.ui.gaugeIP, data.data.ip, data.data.oop.rp, this.currentSolution.dynamicDeathZone);\r\n            this.updateGauge(this.ui.gaugeOOP, data.data.oop, data.data.ip.rp, this.currentSolution.dynamicDeathZone);\r\n        }\r\n\r\n        if (this.ui.content) {\r\n            this.ui.content.innerHTML = `\r\n                <icm-stats-panel id=\"stats-panel-container\"></icm-stats-panel>\r\n                <div id=\"main-chart\" class=\"mt-4 min-h-37.5 w-full\"></div>\r\n                <div class=\"mt-8 border-t border-slate-800 pt-6 text-slate-300 leading-relaxed space-y-4\">\r\n                    ${contentHtml}\r\n                </div>\r\n            `;\r\n            const panel = this.ui.content.querySelector('icm-stats-panel');\r\n            if (panel) panel.update(this.currentSolution, this.agressionFactor, this.isMuted);\r\n        }\r\n        setTimeout(() => this._renderMainChart(this.currentSolution), 10);\r\n    }\r\n\r\n    recalcScenario() {\r\n        if (!this.currentScenarioData) return;\r\n        const data = this.currentScenarioData;\r\n\r\n        const ipStackNum = Number.parseFloat(data.data?.ip?.stack) || 25;\r\n        const oopStackNum = Number.parseFloat(data.data?.oop?.stack) || 25;\r\n        const effStack = Math.min(ipStackNum, oopStackNum);\r\n\r\n        this.currentSolution = this.solver.solve(data.data.ip.rp, data.data.oop.rp, this.agressionFactor, effStack);\r\n\r\n        const panel = this.querySelector('icm-stats-panel');\r\n        if (panel) panel.update(this.currentSolution, this.agressionFactor, this.isMuted);\r\n\r\n        if (data.data?.ip && data.data?.oop) {\r\n            this.updateGauge(this.ui.gaugeIP, data.data.ip, data.data.oop.rp, this.currentSolution.dynamicDeathZone);\r\n            this.updateGauge(this.ui.gaugeOOP, data.data.oop, data.data.ip.rp, this.currentSolution.dynamicDeathZone);\r\n        }\r\n\r\n        this._renderMainChart(this.currentSolution);\r\n    }\r\n\r\n    updateGauge(el, d, opponentRp, dynamicDeathZone) {\r\n        if (!el) return;\r\n        el.setAttribute('value', d.rp);\r\n        el.setAttribute('pos', d.pos);\r\n        el.setAttribute('stack', d.stack);\r\n        el.setAttribute('threshold', '20'); // Define limite crítico de 20%\r\n        el.setAttribute('opponent-value', opponentRp); // Alimenta lógica do Predator Mode\r\n        if (dynamicDeathZone) el.setAttribute('dynamic-death-zone', dynamicDeathZone);\r\n        // Aplica atributo muted se o estado global estiver silenciado\r\n        if (this.isMuted) el.setAttribute('muted', ''); else el.removeAttribute('muted');\r\n    }\r\n\r\n    runSimulation(val) {\r\n        const equity = Number.parseFloat(val);\r\n        const output = this.querySelector('#sim-result');\r\n\r\n        if (Number.isNaN(equity) || !this.currentSolution) {\r\n            output.innerHTML = '<span class=\"text-slate-500 text-xs\">Aguardando input...</span>';\r\n            return;\r\n        }\r\n\r\n        const req = Number.parseFloat(this.currentSolution.evDiff.totalRequired);\r\n\r\n        // Cálculo de Simulação Reversa (Internalizado)\r\n        const margin = equity - req;\r\n        const isCall = margin >= 0;\r\n        const isClose = Math.abs(margin) <= 3.5;\r\n        const action = isCall ? 'CALL' : 'FOLD';\r\n        const statusClass = isCall ? 'text-emerald-400' : 'text-rose-400';\r\n        const sign = margin > 0 ? '+' : '';\r\n\r\n        output.innerHTML = `\r\n            <span class=\"font-bold ${statusClass} text-lg tracking-wider\">${action}</span>\r\n            <span class=\"text-xs text-slate-400 ml-2\">\r\n                (${isClose ? 'Marginal' : 'Claro'}, ${sign}${margin.toFixed(1)}%)\r\n            </span>\r\n        `;\r\n    }\r\n\r\n    _renderMainChart(sol) {\r\n        const bBase = 33.3;\r\n        const dBase = 50;\r\n        const bIcm = Number.parseFloat(sol.bluff.value);\r\n        const dIcm = Number.parseFloat(sol.defense.value);\r\n\r\n        // Mutação O(1) para instâncias vivas (Fricção Zero)\r\n        if (this.charts.main) {\r\n            this.charts.main.updateSeries([{\r\n                name: 'GTO Base (ChipEV)',\r\n                data: [bBase, dBase]\r\n            }, {\r\n                name: 'ICM Ajustado',\r\n                data: [bIcm, dIcm]\r\n            }]);\r\n            return;\r\n        }\r\n\r\n        const options = {\r\n            series: [{\r\n                name: 'GTO Base (ChipEV)',\r\n                data: [bBase, dBase]\r\n            }, {\r\n                name: 'ICM Ajustado',\r\n                data: [bIcm, dIcm]\r\n            }],\r\n            chart: {\r\n                type: 'bar',\r\n                height: 200,\r\n                fontFamily: 'Inter, sans-serif',\r\n                background: 'transparent',\r\n                toolbar: { show: false }\r\n            },\r\n            colors: ['#334155', '#6366f1'],\r\n            plotOptions: {\r\n                bar: {\r\n                    horizontal: false,\r\n                    columnWidth: '45%',\r\n                    borderRadius: 4\r\n                },\r\n            },\r\n            dataLabels: { enabled: false },\r\n            stroke: { show: true, width: 2, colors: ['transparent'] },\r\n            xaxis: {\r\n                categories: ['Frequência de Bluff', 'Frequência de Defesa'],\r\n                labels: { style: { colors: '#94a3b8', fontSize: '11px' } },\r\n                axisBorder: { show: false },\r\n                axisTicks: { show: false }\r\n            },\r\n            yaxis: { show: false },\r\n            fill: { opacity: 1 },\r\n            tooltip: {\r\n                theme: 'dark',\r\n                style: { fontSize: '12px', fontFamily: 'Inter' },\r\n                y: { formatter: function (val) { return val + \"%\" } }\r\n            },\r\n            legend: {\r\n                position: 'bottom',\r\n                labels: { colors: '#cbd5e1' }\r\n            },\r\n            grid: { show: false }\r\n        };\r\n\r\n        const el = this.querySelector(\"#main-chart\");\r\n        if (el) {\r\n            this.charts.main = new ApexCharts(el, options);\r\n            this.charts.main.render();\r\n        }\r\n    }\r\n\r\n    renderComparisonInterface() {\r\n        const optionsHtml = ALL_SCENARIOS.map(s => `<option value=\"${s.id}\">${s.label}</option>`).join('');\r\n\r\n        this.ui.compareArea.innerHTML = `\r\n            <div class=\"grid grid-cols-2 gap-4 mb-6\">\r\n                <div>\r\n                    <label class=\"text-[10px] uppercase font-bold text-slate-500 block mb-1\">Cenário A</label>\r\n                    <select id=\"sel-sc1\" class=\"scenario-selector w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-lg p-2 focus:ring-2 focus:ring-indigo-500 outline-none\">\r\n                        ${optionsHtml}\r\n                    </select>\r\n                </div>\r\n                <div>\r\n                    <label class=\"text-[10px] uppercase font-bold text-slate-500 block mb-1\">Cenário B</label>\r\n                    <select id=\"sel-sc2\" class=\"scenario-selector w-full bg-slate-900 border border-slate-700 text-white text-sm rounded-lg p-2 focus:ring-2 focus:ring-pink-500 outline-none\">\r\n                        ${optionsHtml}\r\n                    </select>\r\n                </div>\r\n            </div>\r\n            <div id=\"comparison-chart\" class=\"min-h-75\"></div>\r\n            <div id=\"comparison-verdict\" class=\"mt-4 text-center text-xs text-slate-400\"></div>\r\n        `;\r\n\r\n        // Define valores iniciais (1º e 2º cenário se possível)\r\n        const sel2 = this.querySelector('#sel-sc2');\r\n        if (ALL_SCENARIOS.length > 1) sel2.value = ALL_SCENARIOS[1].id;\r\n\r\n        this.updateComparisonChart();\r\n    }\r\n\r\n    updateComparisonChart() {\r\n        const id1 = this.querySelector('#sel-sc1').value;\r\n        const id2 = this.querySelector('#sel-sc2').value;\r\n\r\n        const s1 = ALL_SCENARIOS.find(s => s.id === id1);\r\n        const s2 = ALL_SCENARIOS.find(s => s.id === id2);\r\n\r\n        if (!s1 || !s2) return;\r\n\r\n        const comparison = this._compareScenarios(s1, s2);\r\n\r\n        const verdictHtml = `\r\n            <span class=\"text-indigo-400 font-bold\">${s1.label}:</span> ${comparison.analysis.s1.verdict} <br>\r\n            <span class=\"text-pink-400 font-bold\">${s2.label}:</span> ${comparison.analysis.s2.verdict}\r\n        `;\r\n\r\n        // Update delta cirúrgico\r\n        if (this.charts.compare) {\r\n            this.charts.compare.updateSeries(comparison.series);\r\n            const verdictEl = this.querySelector('#comparison-verdict');\r\n            if (verdictEl) verdictEl.innerHTML = verdictHtml;\r\n            return;\r\n        }\r\n\r\n        const options = {\r\n            series: comparison.series,\r\n            chart: {\r\n                height: 350,\r\n                type: 'radar',\r\n                background: 'transparent',\r\n                toolbar: { show: false },\r\n                fontFamily: 'Inter, sans-serif'\r\n            },\r\n            colors: ['#6366f1', '#ec4899'],\r\n            stroke: { width: 2, colors: ['#6366f1', '#ec4899'] },\r\n            fill: { opacity: 0.2 },\r\n            markers: { size: 4 },\r\n            xaxis: {\r\n                categories: comparison.categories,\r\n                labels: {\r\n                    style: {\r\n                        colors: ['#cbd5e1', '#cbd5e1', '#cbd5e1'],\r\n                        fontSize: '12px',\r\n                        fontFamily: 'Inter, sans-serif'\r\n                    }\r\n                }\r\n            },\r\n            yaxis: { show: false },\r\n            legend: {\r\n                position: 'bottom',\r\n                labels: { colors: '#cbd5e1' }\r\n            },\r\n            tooltip: {\r\n                theme: 'dark',\r\n                y: { formatter: function (val) { return val + \"%\" } }\r\n            }\r\n        };\r\n\r\n        this.charts.compare = new ApexCharts(this.querySelector(\"#comparison-chart\"), options);\r\n        this.charts.compare.render();\r\n\r\n        // Verdict simples\r\n        const verdictEl = this.querySelector('#comparison-verdict');\r\n        if (verdictEl) verdictEl.innerHTML = verdictHtml;\r\n    }\r\n\r\n    _compareScenarios(s1, s2) {\r\n        const ipStackNum1 = Number.parseFloat(s1.data?.ip?.stack) || 25;\r\n        const oopStackNum1 = Number.parseFloat(s1.data?.oop?.stack) || 25;\r\n        const effStack1 = Math.min(ipStackNum1, oopStackNum1);\r\n\r\n        const ipStackNum2 = Number.parseFloat(s2.data?.ip?.stack) || 25;\r\n        const oopStackNum2 = Number.parseFloat(s2.data?.oop?.stack) || 25;\r\n        const effStack2 = Math.min(ipStackNum2, oopStackNum2);\r\n\r\n        const sol1 = this.solver.solve(s1.data.ip.rp, s1.data.oop.rp, this.agressionFactor, effStack1);\r\n        const sol2 = this.solver.solve(s2.data.ip.rp, s2.data.oop.rp, this.agressionFactor, effStack2);\r\n\r\n        return {\r\n            series: [\r\n                { name: s1.label, data: [s1.data.ip.rp, s1.data.oop.rp, Number.parseFloat(sol1.bluff.value), Number.parseFloat(sol1.defense.value), Number.parseFloat(sol1.evDiff.value)] },\r\n                { name: s2.label, data: [s2.data.ip.rp, s2.data.oop.rp, Number.parseFloat(sol2.bluff.value), Number.parseFloat(sol2.defense.value), Number.parseFloat(sol2.evDiff.value)] }\r\n            ],\r\n            categories: ['RP Agressor', 'RP Defensor', 'Bluff %', 'Defesa %', 'EV Shift %'],\r\n            analysis: {\r\n                s1: { verdict: sol1.verdict },\r\n                s2: { verdict: sol2.verdict }\r\n            }\r\n        };\r\n    }\r\n\r\n    exportPDF() {\r\n        this._generatePDF();\r\n    }\r\n\r\n    _generatePDF() {\r\n        const element = document.createElement('div');\r\n        const data = this.currentScenarioData;\r\n        const sol = this.currentSolution;\r\n\r\n        // Template Minimalista para PDF\r\n        element.innerHTML = `\r\n            <div style=\"padding: 40px; font-family: 'Helvetica', sans-serif; color: #1e293b; background: #fff;\">\r\n                <div style=\"border-bottom: 2px solid #6366f1; padding-bottom: 20px; margin-bottom: 30px; display: flex; justify-content: space-between; align-items: flex-end;\">\r\n                    <div>\r\n                        <h1 style=\"margin: 0; font-size: 24px; color: #0f172a;\">Relatório de Análise ICM</h1>\r\n                        <p style=\"margin: 5px 0 0; font-size: 12px; color: #64748b; text-transform: uppercase; letter-spacing: 1px;\">Geometria do Risco | Masterclass</p>\r\n                    </div>\r\n                    <div style=\"text-align: right;\">\r\n                        <div style=\"font-size: 10px; color: #94a3b8;\">DATA</div>\r\n                        <div style=\"font-weight: bold;\">${new Date().toLocaleDateString()}</div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div style=\"margin-bottom: 30px; background: #f8fafc; padding: 20px; border-radius: 8px;\">\r\n                    <h2 style=\"font-size: 14px; text-transform: uppercase; letter-spacing: 1px; color: #6366f1; margin-top: 0;\">Cenário: ${data.label}</h2>\r\n                    <p style=\"font-size: 14px; margin: 5px 0 0; color: #334155;\"><strong>Contexto:</strong> ${data.context}</p>\r\n                    <div style=\"display: flex; gap: 40px; margin-top: 20px;\">\r\n                        <div>\r\n                            <div style=\"font-size: 10px; color: #94a3b8; text-transform: uppercase;\">Agressor (IP)</div>\r\n                            <div style=\"font-size: 18px; font-weight: bold;\">${data.data.ip.rp}% RP</div>\r\n                            <div style=\"font-size: 12px; color: #64748b;\">${data.data.ip.stack} (${data.data.ip.morph})</div>\r\n                        </div>\r\n                        <div>\r\n                            <div style=\"font-size: 10px; color: #94a3b8; text-transform: uppercase;\">Defensor (OOP)</div>\r\n                            <div style=\"font-size: 18px; font-weight: bold;\">${data.data.oop.rp}% RP</div>\r\n                            <div style=\"font-size: 12px; color: #64748b;\">${data.data.oop.stack} (${data.data.oop.morph})</div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div style=\"margin-bottom: 30px;\">\r\n                    <h3 style=\"font-size: 12px; text-transform: uppercase; border-bottom: 1px solid #e2e8f0; padding-bottom: 5px;\">Resultados da Simulação</h3>\r\n                    <table style=\"width: 100%; margin-top: 15px; border-collapse: collapse;\">\r\n                        <tr style=\"text-align: left; color: #64748b; font-size: 10px; text-transform: uppercase;\">\r\n                            <th style=\"padding-bottom: 10px;\">Métrica</th>\r\n                            <th style=\"padding-bottom: 10px;\">GTO Base</th>\r\n                            <th style=\"padding-bottom: 10px;\">Ajustado (ICM)</th>\r\n                            <th style=\"padding-bottom: 10px;\">Delta</th>\r\n                        </tr>\r\n                        <tr style=\"border-bottom: 1px solid #f1f5f9;\">\r\n                            <td style=\"padding: 10px 0; font-weight: bold; font-size: 14px;\">Frequência de Bluff</td>\r\n                            <td style=\"padding: 10px 0; color: #64748b;\">33.3%</td>\r\n                            <td style=\"padding: 10px 0; color: #6366f1; font-weight: bold;\">${sol.bluff.value}%</td>\r\n                            <td style=\"padding: 10px 0; font-family: monospace;\">${sol.bluff.delta > 0 ? '+' : ''}${sol.bluff.delta}%</td>\r\n                        </tr>\r\n                        <tr style=\"border-bottom: 1px solid #f1f5f9;\">\r\n                            <td style=\"padding: 10px 0; font-weight: bold; font-size: 14px;\">Frequência de Defesa</td>\r\n                            <td style=\"padding: 10px 0; color: #64748b;\">50.0%</td>\r\n                            <td style=\"padding: 10px 0; color: #ec4899; font-weight: bold;\">${sol.defense.value}%</td>\r\n                            <td style=\"padding: 10px 0; font-family: monospace;\">${sol.defense.delta > 0 ? '+' : ''}${sol.defense.delta}%</td>\r\n                        </tr>\r\n                        <tr style=\"border-bottom: 1px solid #f1f5f9;\">\r\n                            <td style=\"padding: 10px 0; font-weight: bold; font-size: 14px;\">EV Diff (Shift)</td>\r\n                            <td style=\"padding: 10px 0; color: #64748b;\">0.0%</td>\r\n                            <td style=\"padding: 10px 0; color: #0f172a; font-weight: bold;\">${sol.evDiff.value}%</td>\r\n                            <td style=\"padding: 10px 0; font-size: 10px; color: #94a3b8;\">(Risco Adicional)</td>\r\n                        </tr>\r\n                    </table>\r\n                </div>\r\n\r\n                <div style=\"background: #f1f5f9; padding: 15px; border-left: 4px solid #334155; border-radius: 4px; font-size: 12px; color: #334155; margin-top: 40px;\">\r\n                    <strong>Veredito do Solver:</strong> ${sol.verdict}\r\n                    <br><span style=\"color: #64748b;\">Fator de Agressividade Simulado: ${this.agressionFactor.toFixed(1)}x</span>\r\n                </div>\r\n\r\n                <div style=\"margin-top: 50px; text-align: center; font-size: 10px; color: #cbd5e1;\">\r\n                    Gerado via Geometria do Risco Engine | Raphael Vitoi\r\n                </div>\r\n            </div>\r\n        `;\r\n\r\n        html2pdf().set({\r\n            margin: 10,\r\n            filename: `Analise_ICM_${data.id}_${Date.now()}.pdf`,\r\n            image: { type: 'jpeg', quality: 0.98 },\r\n            html2canvas: { scale: 2 },\r\n            jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' }\r\n        }).from(element).save();\r\n    }\r\n}\r\n\r\ncustomElements.define('icm-game-engine', IcmGameEngine);\r\n\r\nglobalThis.gameEngineInstance = null; // A engine agora é orgânica via DOM Element.\r\n"]],"v":12,"metadata":{"source":"unknown","name":"pushEditOperation"}}

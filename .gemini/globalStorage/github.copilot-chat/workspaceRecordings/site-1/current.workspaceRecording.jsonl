{"kind":"setContent","time":1778715329206,"id":16,"content":"# ==============================================================================\r\n# PROTOCOLO VITOI 3.2 - BLINDAGEM DE REPOSITÓRIO E ENTROPIA ZERO\r\n# ==============================================================================\r\n\r\n# 1. INFRAESTRUTURA E RUNTIME (Densidade Zero)\r\nnode_modules/\r\n.venv/\r\n__pycache__/\r\ncoverage/\r\n\r\n# 2. BUILD E COMPILAÇÃO (Next.js / Turbopack)\r\n.next/\r\n.turbo/\r\nfrontend/.next/\r\nfrontend/.turbo/\r\nfrontend/.next-build/\r\n\r\n# 3. BANCOS DE DADOS E VETORES (Opacidade)\r\n*.db\r\n*.db-shm\r\n*.db-wal\r\n*.db-journal\r\n*.sqlite\r\n.chroma_db/\r\ndata/chroma_db/\r\n.pytest_tmp/\r\n\r\n# 4. LOGS, BACKUPS E TELEMETRIA SOTA\r\nlogs/\r\n_backups/\r\n.backups/\r\n.backups_sota/\r\nNEXUS_SOTA_BACKUP_*/\r\narchive/\r\n.claude/logs/\r\n.claude/task_results/\r\n.claude/.archive/\r\nappmap.log\r\n*.pid\r\n.nexus_worker.pid\r\ntemp_media/\r\n\r\n# 5. SEGREDOS E AMBIENTE (Prevenção de Vazamento)\r\n_env.ps1\r\nfrontend/.env.local\r\nprisma/.env\r\n\r\n# 6. SISTEMA E RUÍDO\r\n.DS_Store\r\nThumbs.db\r\n.continue/\r\nwasm-equity/target/\r\nfrontend/src/components/simulator/panels/target/\r\n\r\n\r\n#Ignore vscode AI rules\r\n.github\\instructions\\codacy.instructions.md\r\n","v":1}

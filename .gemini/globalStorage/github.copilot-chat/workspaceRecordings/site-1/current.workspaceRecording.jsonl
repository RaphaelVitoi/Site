\"\r\n        },\r\n        {\r\n            \"name\": \"INVENTARIO DE FERRAMENTAS\",\r\n            \"path\": \"docs/INVENTARIO_FERRAMENTAS.md\"\r\n        },\r\n        {\r\n            \"name\": \"PROTOCOLO DE ROTEAMENTO HOLOGRAFICO\",\r\n            \"path\": \".claude/HOLOGRAPHIC_ROUTING_PROTOCOL.md\"\r\n        },\r\n        {\r\n            \"name\": \"ARQUITETURA DO CEREBRO HIBRIDO\",\r\n            \"path\": \".claude/HYBRID_BRAIN_ARCHITECTURE.md\"\r\n        },\r\n        {\r\n            \"name\": \"MANIFESTO DE COERENCIA E HARMONIA\",\r\n            \"path\": \".claude/COHERENCE_MANIFEST.md\"\r\n        }\r\n    ]\r\n}\r\n","v":1}

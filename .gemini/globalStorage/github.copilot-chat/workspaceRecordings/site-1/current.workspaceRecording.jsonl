{"kind":"setContent","time":1778697650625,"id":408,"content":"/**\r\n * IDENTITY: O Paradoxo do Valuation no ICM\r\n * PATH: src/app/biblioteca/paradoxo-valuation/page.tsx\r\n * ROLE: Ensaio sobre a não-linearidade da utilidade das fichas.\r\n * BINDING: [layout.tsx, globals.css, SectionHeader, GlassPanel, ContentFooter]\r\n */\r\n\r\nimport ContentFooter from '@/components/content/ContentFooter';\r\nimport { SectionHeader } from '@/components/ui/SectionHeader';\r\nimport { GlassPanel } from '@/components/ui/GlassPanel';\r\nimport { ContentPageHeader } from '@/components/layout/ContentPageHeader';\r\nimport { ROUTES } from '@/constants/routes';\r\nimport { SITE_CONFIG } from '@/constants/site';\r\n\r\nexport const metadata = {\r\n  title: 'O Paradoxo do Valuation no ICM | Raphael Vitoi',\r\n  description: 'Por que acumular fichas pode diminuir sua esperança matemática em spots específicos.',\r\n};\r\n\r\nexport default function ParadoxoValuationPage ()\r\n{\r\n  return (\r\n    <div className=\"min-h-screen bg-bg-base text-text-bright overflow-x-hidden font-body\">\r\n      <ContentPageHeader\r\n        title=\"Paradoxo do Valuation\"\r\n        subtitle=\"A não-linearidade da utilidade das fichas. Por que ganhar o dobro de fichas não significa ganhar o dobro de prêmio.\"\r\n        category=\"Teoria Econômica\"\r\n        icon=\"fa-scale-balanced\"\r\n      />\r\n\r\n      <SectionHeader\r\n        step=\"01\"\r\n        label=\"Fundação\"\r\n        title=\"A Ficha que Vale Ouro\"\r\n        description=\"A primeira ficha de um jogador é infinitamente mais valiosa que a última.\"\r\n      />\r\n      <div className=\"sota-container pb-12\">\r\n        <GlassPanel className=\"p-8 sm:p-12 lg:p-16 border-l-4 border-l-accent-indigo\">\r\n          <div className=\"prose prose-invert prose-lg max-w-none text-text-muted font-body\">\r\n            <p>\r\n              No ChipEV, cada ficha vale exatamente o mesmo. No ICM, o valor de cada ficha é <strong className=\"text-text-bright\">contingente</strong> à sua sobrevivência.\r\n            </p>\r\n            <p>\r\n              O <strong className=\"text-text-bright\">Paradoxo do Valuation</strong> ocorre quando a busca por fichas extras aumenta seu risco de eliminação de tal forma que o prêmio esperado (em dólares) diminui, apesar do aumento do stack nominal.\r\n            </p>\r\n          </div>\r\n        </GlassPanel>\r\n      </div>\r\n\r\n      <SectionHeader\r\n        step=\"02\"\r\n        label=\"Dinâmica\"\r\n        title=\"Risk Premium e a Barreira do Payout\"\r\n        description=\"Como o Motor ICM bloqueia a agressão irracional em Mesas Finais.\"\r\n      />\r\n      <div className=\"sota-container pb-24\">\r\n        <GlassPanel className=\"p-8 sm:p-12 lg:p-16 border-t-8 border-t-accent-rose\">\r\n          <div className=\"prose prose-invert prose-lg max-w-none text-text-muted font-body\">\r\n            <p>\r\n              Em situações de &quot;bolha&quot; ou payjumps massivos, o <strong className=\"text-text-bright\">Risk Premium</strong> pode chegar a 20-30%. Isso significa que você precisa de uma vantagem de equidade gigantesca apenas para &quot;empatar&quot; o investimento.\r\n            </p>\r\n            <p>\r\n              O Operador Soberano entende que, às vezes, a jogada com maior EV de fichas é a jogada com menor EV de dinheiro. No Nexus, o dinheiro é a única métrica real.\r\n            </p>\r\n          </div>\r\n        </GlassPanel>\r\n      </div>\r\n\r\n      <div className=\"sota-container pb-12\">\r\n        <ContentFooter\r\n          shareTitle={`O Paradoxo do Valuation | ${SITE_CONFIG.author}`}\r\n          shareUrl={`${SITE_CONFIG.baseUrl}${ROUTES.LIBRARY.PARADOXO_VALUATION}`}\r\n          backLinkHref={ROUTES.BIBLIOTECA}\r\n          backLinkText=\"Voltar para Biblioteca\"\r\n        />\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n","v":1}

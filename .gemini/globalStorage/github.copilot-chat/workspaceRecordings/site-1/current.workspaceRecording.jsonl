{"kind":"setContent","time":1778727698892,"id":509,"content":"[package]\r\nname = \"vitoi_equity_engine\"\r\nversion = \"0.1.0\"\r\nedition = \"2021\"\r\ndescription = \"SOTA WebAssembly Poker Equity & Insolvency Engine (Vitoi Ecosystem)\"\r\n\r\n[lib]\r\ncrate-type = [\"cdylib\", \"rlib\"]\r\npath = \"lib.rs\"\r\n\r\n[dependencies]\r\nwasm-bindgen = \"0.2.84\"\r\njs-sys = \"0.3.61\"\r\n\r\n[profile.release]\r\nlto = true\r\nopt-level = 3\r\n","v":1}

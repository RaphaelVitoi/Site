{"kind":"setContent","time":1778598275518,"id":252,"content":"<!DOCTYPE html>\r\n<html lang=\"pt-BR\">\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Geometria do Risco | Masterclass Elite (State of the Art)</title>\r\n    <script src=\"https://cdn.tailwindcss.com\"></script>\r\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css\">\r\n    <style>\r\n        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;700;800&family=Great+Vibes&display=swap');\r\n\r\n        :root {\r\n            --bg-base: #020617;\r\n            --bg-panel: #0f172a;\r\n            --accent-sky: #0ea5e9;\r\n            --accent-rose: #e11d48;\r\n            --accent-indigo: #6366f1;\r\n            --accent-emerald: #10b981;\r\n            --accent-amber: #f59e0b;\r\n        }\r\n\r\n        body {\r\n            font-family: 'Inter', sans-serif;\r\n            background-color: var(--bg-base);\r\n            color: #f8fafc;\r\n            -webkit-font-smoothing: antialiased;\r\n            overflow-x: hidden;\r\n            background-image:\r\n                radial-gradient(circle at 0% 0%, rgba(99, 102, 241, 0.05), transparent 40%),\r\n                radial-gradient(circle at 100% 100%, rgba(14, 165, 233, 0.05), transparent 40%),\r\n                linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),\r\n                linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);\r\n            background-size: 100% 100%, 100% 100%, 40px 40px, 40px 40px;\r\n        }\r\n\r\n        .glass-panel {\r\n            background-color: rgba(15, 23, 42, 0.75);\r\n            -webkit-backdrop-filter: blur(24px);\r\n            backdrop-filter: blur(24px);\r\n            border: 1px solid rgba(255, 255, 255, 0.06);\r\n            border-radius: 24px;\r\n            box-shadow: 0 30px 60px -15px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.05);\r\n            position: relative;\r\n            overflow: hidden;\r\n            transition: transform 0.3s ease, box-shadow 0.3s ease;\r\n        }\r\n\r\n        .data-mono {\r\n            font-family: 'JetBrains Mono', monospace;\r\n            font-variant-numeric: tabular-nums;\r\n        }\r\n\r\n        .bar-transition {\r\n            transition: width 1s cubic-bezier(0.16, 1, 0.3, 1);\r\n        }\r\n\r\n        ::-webkit-scrollbar {\r\n            width: 4px;\r\n        }\r\n\r\n        ::-webkit-scrollbar-track {\r\n            background: transparent;\r\n        }\r\n\r\n        ::-webkit-scrollbar-thumb {\r\n            background: #334155;\r\n            border-radius: 10px;\r\n        }\r\n\r\n        ::-webkit-scrollbar-thumb:hover {\r\n            background: #475569;\r\n        }\r\n\r\n        @keyframes fadeUp {\r\n            from {\r\n                opacity: 0;\r\n                transform: translateY(20px);\r\n                filter: blur(4px);\r\n            }\r\n\r\n            to {\r\n                opacity: 1;\r\n                transform: translateY(0);\r\n                filter: blur(0);\r\n            }\r\n        }\r\n\r\n        .animate-fade-up {\r\n            animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;\r\n        }\r\n\r\n        @keyframes pulseGlow {\r\n\r\n            0%,\r\n            100% {\r\n                filter: drop-shadow(0 0 10px rgba(99, 102, 241, 0.4));\r\n            }\r\n\r\n            50% {\r\n                filter: drop-shadow(0 0 20px rgba(99, 102, 241, 0.8));\r\n            }\r\n        }\r\n\r\n        .pulse-glow {\r\n            animation: pulseGlow 3s infinite;\r\n        }\r\n\r\n        /* Scenario Selector */\r\n        .scenario-btn {\r\n            width: 100%;\r\n            text-align: left;\r\n            padding: 14px 18px;\r\n            border-radius: 14px;\r\n            background-color: #0f172a;\r\n            color: #ffffff;\r\n            border: 1px solid rgba(255, 255, 255, 0.03);\r\n            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 15px;\r\n            cursor: pointer;\r\n            font-weight: 600;\r\n            position: relative;\r\n            overflow: hidden;\r\n        }\r\n\r\n        .scenario-btn:hover {\r\n            background-color: #1e293b;\r\n            transform: translateX(6px);\r\n            color: #f8fafc;\r\n        }\r\n\r\n        .scenario-btn.active {\r\n            background-color: #1e293b;\r\n            background-image: linear-gradient(90deg, rgba(99, 102, 241, 0.2), rgba(99, 102, 241, 0.05));\r\n            border-left: 3px solid #818cf8;\r\n            border-top: 1px solid rgba(99, 102, 241, 0.2);\r\n            border-bottom: 1px solid rgba(99, 102, 241, 0.2);\r\n            color: #fff;\r\n            box-shadow: inset 0 0 20px rgba(99, 102, 241, 0.05);\r\n            transform: translateX(6px);\r\n        }\r\n\r\n        .scenario-btn .icon-box {\r\n            width: 38px;\r\n            height: 38px;\r\n            border-radius: 10px;\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: center;\r\n            background-color: #020617;\r\n            color: #ffffff;\r\n            font-size: 18px;\r\n            border: 1px solid rgba(255, 255, 255, 0.05);\r\n            transition: all 0.3s ease;\r\n            z-index: 2;\r\n            position: relative;\r\n        }\r\n\r\n        .scenario-btn.active .icon-box {\r\n            background: #4f46e5;\r\n            color: white;\r\n            border-color: #818cf8;\r\n            box-shadow: 0 0 15px rgba(99, 102, 241, 0.5);\r\n        }\r\n\r\n        /* Gauges */\r\n        .circular-chart {\r\n            display: block;\r\n            margin: 0 auto;\r\n            max-width: 140px;\r\n            max-height: 140px;\r\n        }\r\n\r\n        .circle-bg {\r\n            fill: none;\r\n            stroke: rgba(30, 41, 59, 0.8);\r\n            stroke-width: 2.5;\r\n        }\r\n\r\n        .circle {\r\n            fill: none;\r\n            stroke-width: 2.5;\r\n            stroke-linecap: round;\r\n            transition: stroke-dasharray 1.5s cubic-bezier(0.16, 1, 0.3, 1);\r\n        }\r\n\r\n        .circle.sky {\r\n            stroke: #0ea5e9;\r\n            filter: drop-shadow(0 0 8px rgba(14, 165, 233, 0.6));\r\n        }\r\n\r\n        .circle.rose {\r\n            stroke: #e11d48;\r\n            filter: drop-shadow(0 0 8px rgba(225, 29, 72, 0.6));\r\n        }\r\n\r\n        /* Tabs */\r\n        .action-tab {\r\n            flex: 1;\r\n            padding: 18px 0;\r\n            text-align: center;\r\n            font-weight: 800;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.15em;\r\n            font-size: 11px;\r\n            color: #94a3b8;\r\n            border-bottom: 2px solid transparent;\r\n            cursor: pointer;\r\n            transition: all 0.3s ease;\r\n            background: rgba(15, 23, 42, 0.4);\r\n        }\r\n\r\n        .action-tab:hover {\r\n            color: #cbd5e1;\r\n            background: rgba(30, 41, 59, 0.4);\r\n        }\r\n\r\n        .action-tab.active {\r\n            color: #fff;\r\n            background: transparent;\r\n        }\r\n\r\n        .action-tab[data-target=\"theory\"].active {\r\n            border-color: var(--accent-sky);\r\n            color: var(--accent-sky);\r\n        }\r\n\r\n        .action-tab[data-target=\"exploit\"].active {\r\n            border-color: var(--accent-indigo);\r\n            color: var(--accent-indigo);\r\n        }\r\n\r\n        .action-tab[data-target=\"quiz\"].active {\r\n            border-color: var(--accent-amber);\r\n            color: var(--accent-amber);\r\n        }\r\n\r\n        .action-tab[data-target=\"dilution\"].active {\r\n            border-color: var(--accent-rose);\r\n            color: var(--accent-rose);\r\n        }\r\n\r\n        .content-panel {\r\n            display: none;\r\n            padding: 35px;\r\n            animation: fadeUp 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;\r\n        }\r\n\r\n        .content-panel.active {\r\n            display: block;\r\n        }\r\n\r\n        /* Quiz */\r\n        .quiz-option {\r\n            background: rgba(30, 41, 59, 0.3);\r\n            border: 1px solid rgba(255, 255, 255, 0.05);\r\n            padding: 18px 24px;\r\n            border-radius: 14px;\r\n            cursor: pointer;\r\n            transition: all 0.2s;\r\n            display: flex;\r\n            gap: 16px;\r\n            align-items: flex-start;\r\n        }\r\n\r\n        .quiz-option:hover {\r\n            background: rgba(30, 41, 59, 0.8);\r\n            transform: translateY(-2px);\r\n            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);\r\n        }\r\n\r\n        .quiz-option.correct {\r\n            background: rgba(16, 185, 129, 0.15);\r\n            border-color: rgba(16, 185, 129, 0.5);\r\n            box-shadow: inset 0 0 20px rgba(16, 185, 129, 0.1);\r\n        }\r\n\r\n        .quiz-option.wrong {\r\n            background: rgba(225, 29, 72, 0.15);\r\n            border-color: rgba(225, 29, 72, 0.5);\r\n        }\r\n\r\n        .quiz-option.disabled {\r\n            pointer-events: none;\r\n            opacity: 0.4;\r\n            filter: grayscale(1);\r\n            transform: none;\r\n            box-shadow: none;\r\n        }\r\n\r\n        .signature-text {\r\n            font-family: 'Great Vibes', cursive;\r\n            font-size: 3rem;\r\n            color: #020617;\r\n            background: linear-gradient(120deg, #e0e7ff 0%, #93c5fd 30%, #6366f1 70%, #4338ca 100%);\r\n            -webkit-background-clip: text;\r\n            background-clip: text;\r\n            -webkit-text-fill-color: transparent;\r\n            transform: rotate(-3deg);\r\n            display: inline-block;\r\n            text-shadow: 0 4px 20px rgba(99, 102, 241, 0.3);\r\n        }\r\n\r\n        .gradient-text {\r\n            background: linear-gradient(to right, #fff, #94a3b8);\r\n            -webkit-background-clip: text;\r\n            background-clip: text;\r\n            -webkit-text-fill-color: transparent;\r\n        }\r\n\r\n        /* Ticker Axiomas */\r\n        .ticker-wrap {\r\n            width: 100%;\r\n            overflow: hidden;\r\n            background: rgba(15, 23, 42, 0.8);\r\n            border-bottom: 1px solid rgba(255, 255, 255, 0.05);\r\n            padding: 8px 0;\r\n        }\r\n\r\n        .ticker {\r\n            display: inline-block;\r\n            white-space: nowrap;\r\n            animation: ticker 30s linear infinite;\r\n            font-size: 11px;\r\n            font-weight: 700;\r\n            text-transform: uppercase;\r\n            letter-spacing: 0.2em;\r\n            color: #818cf8;\r\n        }\r\n\r\n        @keyframes ticker {\r\n            0% {\r\n                transform: translateX(100vw);\r\n            }\r\n\r\n            100% {\r\n                transform: translateX(-100%);\r\n            }\r\n        }\r\n\r\n        /* Dilution Pipeline visualizer */\r\n        .pipeline {\r\n            display: flex;\r\n            align-items: center;\r\n            justify-content: space-between;\r\n            position: relative;\r\n            margin: 40px 0;\r\n            padding: 0 20px;\r\n        }\r\n\r\n        .pipeline::before {\r\n            content: '';\r\n            position: absolute;\r\n            top: 50%;\r\n            left: 40px;\r\n            right: 40px;\r\n            height: 2px;\r\n            background: rgba(255, 255, 255, 0.1);\r\n            z-index: 1;\r\n            transform: translateY(-50%);\r\n        }\r\n\r\n        .pipeline-node {\r\n            position: relative;\r\n            z-index: 2;\r\n            display: flex;\r\n            flex-direction: column;\r\n            align-items: center;\r\n            justify-content: center;\r\n            width: 60px;\r\n            height: 60px;\r\n            border-radius: 50%;\r\n            background: #0f172a;\r\n            border: 2px solid #334155;\r\n            transition: all 0.5s ease;\r\n        }\r\n\r\n        .pipeline-node.active {\r\n            border-color: #f43f5e;\r\n            box-shadow: 0 0 20px rgba(225, 29, 72, 0.4);\r\n            background: rgba(225, 29, 72, 0.1);\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body class=\"p-0 md:p-8 flex flex-col items-center\">\r\n\r\n    <!-- AXIOM TICKER -->\r\n    <div class=\"ticker-wrap absolute top-0 left-0 z-50\">\r\n        <div class=\"ticker\">\r\n            <span class=\"mx-8\"><i class=\"fa-solid fa-bolt mr-2\"></i> A responsabilidade na FT é realizar o EV monetário,\r\n                não provar coragem.</span>\r\n            <span class=\"mx-8\"><i class=\"fa-solid fa-bolt mr-2\"></i> A diferença de RP entre jogadores é a sua Vantagem\r\n                ou Desvantagem de Risco.</span>\r\n            <span class=\"mx-8\"><i class=\"fa-solid fa-bolt mr-2\"></i> O pós-flop no ICM foca-se em extração cirúrgica sem\r\n                pulverizar alavancagem.</span>\r\n            <span class=\"mx-8\"><i class=\"fa-solid fa-bolt mr-2\"></i> Acumular fichas nunca é negativo, o problema é\r\n                arriscá-las sem recompensa.</span>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"w-full max-w-350 flex flex-col gap-8 mt-12\">\r\n\r\n        <!-- HEADER -->\r\n        <header class=\"text-center mb-2 pt-4\">\r\n            <div\r\n                class=\"inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 mb-4\">\r\n                <div class=\"w-2 h-2 rounded-full bg-indigo-400 pulse-glow\"></div>\r\n                <span class=\"text-[10px] font-black text-indigo-300 uppercase tracking-widest\">Motor de Inferência\r\n                    Ativo</span>\r\n            </div>\r\n            <h1 class=\"text-5xl md:text-6xl font-black tracking-tighter mb-3\">\r\n                A Geometria do <span\r\n                    class=\"text-transparent bg-clip-text bg-linear-to-r from-rose-400 to-indigo-500\">Risco</span>\r\n            </h1>\r\n            <p class=\"text-slate-400 text-sm font-bold uppercase tracking-[0.3em]\">\r\n                Masterclass de Teoria dos Jogos | Arquitetura V48\r\n            </p>\r\n        </header>\r\n\r\n        <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start px-4 md:px-0\">\r\n\r\n            <!-- LEFT MENU: Scenario Selection -->\r\n            <aside class=\"lg:col-span-4 flex flex-col gap-6\">\r\n\r\n                <div class=\"glass-panel p-6 max-h-212.5 flex flex-col\">\r\n                    <div class=\"flex items-center justify-between mb-6 pb-4 border-b border-slate-800\">\r\n                        <h2 class=\"text-xs font-black text-slate-400 uppercase tracking-widest\">Matrizes Clínicas</h2>\r\n                        <span class=\"text-[10px] bg-slate-800 text-slate-300 px-2 py-1 rounded font-bold\">10\r\n                            Cenários</span>\r\n                    </div>\r\n\r\n                    <div class=\"space-y-3 overflow-y-auto pr-2 pb-4 max-h-162.5\" id=\"scenario-list\">\r\n                        <!-- Botões injetados via JS -->\r\n                    </div>\r\n                </div>\r\n\r\n            </aside>\r\n\r\n            <!-- RIGHT STAGE: Visualizer & Interaction -->\r\n            <main class=\"lg:col-span-8 flex flex-col gap-6\">\r\n\r\n                <!-- THE STAGE (Top Panel - VS Visualizer) -->\r\n                <div class=\"glass-panel p-8 md:p-10 relative\">\r\n                    <div\r\n                        class=\"absolute top-0 right-0 w-64 h-64 bg-sky-500/10 rounded-full filter blur-[100px] pointer-events-none\">\r\n                    </div>\r\n                    <div\r\n                        class=\"absolute bottom-0 left-0 w-64 h-64 bg-rose-500/10 rounded-full filter blur-[100px] pointer-events-none\">\r\n                    </div>\r\n\r\n                    <div class=\"flex justify-between items-start border-b border-slate-800 pb-6 mb-8 relative z-10\">\r\n                        <div>\r\n                            <span\r\n                                class=\"text-[10px] font-black text-slate-400 bg-slate-800/50 px-3 py-1.5 rounded-md uppercase tracking-widest border border-slate-700/50\"\r\n                                id=\"stage-env\">Contexto</span>\r\n                            <h2 class=\"text-3xl md:text-4xl font-black text-white mt-4 tracking-tight gradient-text\"\r\n                                id=\"stage-title\">Título</h2>\r\n                        </div>\r\n                        <div class=\"text-right hidden sm:flex flex-col items-end\">\r\n                            <span class=\"text-[10px] text-slate-500 font-bold uppercase tracking-widest mb-2\">Veredito\r\n                                do Solver</span>\r\n                            <div id=\"verdict-badge\"\r\n                                class=\"px-4 py-2 rounded-lg text-xs font-black uppercase tracking-widest border transition-all duration-500\">\r\n                                --\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- VS Battle Visualization -->\r\n                    <div class=\"flex items-center justify-between px-2 md:px-12 relative z-10\">\r\n\r\n                        <!-- Agressor (IP/Hero) -->\r\n                        <div class=\"flex flex-col items-center flex-1\">\r\n                            <div class=\"text-center mb-4\">\r\n                                <span\r\n                                    class=\"text-[11px] font-black text-sky-400 uppercase tracking-widest block mb-2\">Agressor\r\n                                    (Ida)</span>\r\n                                <span class=\"text-2xl font-black text-white block mb-1\" id=\"ip-pos\">BTN</span>\r\n                                <span\r\n                                    class=\"data-mono text-sm text-slate-400 font-medium bg-slate-900/50 px-2 py-0.5 rounded border border-slate-800\"\r\n                                    id=\"ip-stack\">40.2 bb</span>\r\n                            </div>\r\n\r\n                            <div class=\"relative w-28 h-28 md:w-36 md:h-36\">\r\n                                <svg viewBox=\"0 0 36 36\" class=\"circular-chart\">\r\n                                    <path class=\"circle-bg\"\r\n                                        d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\" />\r\n                                    <path class=\"circle sky\" id=\"ip-rp-svg\" stroke-dasharray=\"0, 100\"\r\n                                        d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\" />\r\n                                </svg>\r\n                                <div class=\"absolute inset-0 flex flex-col items-center justify-center\">\r\n                                    <span class=\"data-mono text-2xl md:text-3xl font-black text-white\"\r\n                                        id=\"ip-rp-txt\">0%</span>\r\n                                    <span\r\n                                        class=\"text-[8px] md:text-[9px] font-bold text-sky-400 uppercase tracking-widest mt-1\">R.\r\n                                        Premium</span>\r\n                                </div>\r\n                            </div>\r\n\r\n                            <!-- Morphologic Tag (Short Didactic Text) -->\r\n                            <div class=\"mt-6 text-center\">\r\n                                <p class=\"text-[9px] text-slate-500 font-bold uppercase tracking-widest mb-1\">Morfologia\r\n                                    de Range</p>\r\n                                <span\r\n                                    class=\"text-xs font-bold text-sky-300 bg-sky-950/30 px-3 py-1.5 rounded-lg border border-sky-500/20 block\"\r\n                                    id=\"ip-morph\">Polarizado</span>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <!-- VS Logo -->\r\n                        <div class=\"shrink-0 px-4 md:px-6 flex flex-col items-center\">\r\n                            <div\r\n                                class=\"w-12 h-12 md:w-14 md:h-14 rounded-full bg-slate-900 border border-slate-700 flex items-center justify-center text-slate-400 font-black italic text-lg md:text-xl shadow-lg\">\r\n                                VS\r\n                            </div>\r\n                            <div class=\"w-px h-20 md:h-24 bg-linear-to-b from-slate-700 to-transparent mt-4\"></div>\r\n                        </div>\r\n\r\n                        <!-- Defensor (OOP/Villain) -->\r\n                        <div class=\"flex flex-col items-center flex-1\">\r\n                            <div class=\"text-center mb-4\">\r\n                                <span\r\n                                    class=\"text-[11px] font-black text-rose-400 uppercase tracking-widest block mb-2\">Defensor\r\n                                    (Volta)</span>\r\n                                <span class=\"text-2xl font-black text-white block mb-1\" id=\"oop-pos\">BB</span>\r\n                                <span\r\n                                    class=\"data-mono text-sm text-slate-400 font-medium bg-slate-900/50 px-2 py-0.5 rounded border border-slate-800\"\r\n                                    id=\"oop-stack\">54.4 bb</span>\r\n                            </div>\r\n\r\n                            <div class=\"relative w-28 h-28 md:w-36 md:h-36\">\r\n                                <svg viewBox=\"0 0 36 36\" class=\"circular-chart\">\r\n                                    <path class=\"circle-bg\"\r\n                                        d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\" />\r\n                                    <path class=\"circle rose\" id=\"oop-rp-svg\" stroke-dasharray=\"0, 100\"\r\n                                        d=\"M18 2.0845 a 15.9155 15.9155 0 0 1 0 31.831 a 15.9155 15.9155 0 0 1 0 -31.831\" />\r\n                                </svg>\r\n                                <div class=\"absolute inset-0 flex flex-col items-center justify-center\">\r\n                                    <span class=\"data-mono text-2xl md:text-3xl font-black text-white\"\r\n                                        id=\"oop-rp-txt\">0%</span>\r\n                                    <span\r\n                                        class=\"text-[8px] md:text-[9px] font-bold text-rose-400 uppercase tracking-widest mt-1\">R.\r\n                                        Premium</span>\r\n                                </div>\r\n                            </div>\r\n\r\n                            <!-- Morphologic Tag -->\r\n                            <div class=\"mt-6 text-center\">\r\n                                <p class=\"text-[9px] text-slate-500 font-bold uppercase tracking-widest mb-1\">Morfologia\r\n                                    de Range</p>\r\n                                <span\r\n                                    class=\"text-xs font-bold text-rose-300 bg-rose-950/30 px-3 py-1.5 rounded-lg border border-rose-500/20 block\"\r\n                                    id=\"oop-morph\">Condensado</span>\r\n                            </div>\r\n                        </div>\r\n\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- DYNAMIC FREQUENCIES PANEL -->\r\n                <div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\r\n                    <!-- Alpha / Bluff -->\r\n                    <div class=\"glass-panel p-6 border-t-4 border-t-sky-500 hover:border-t-sky-400 transition-colors\">\r\n                        <div class=\"flex justify-between items-start mb-6\">\r\n                            <div class=\"space-y-1\">\r\n                                <h3 class=\"text-[11px] font-black text-slate-400 uppercase tracking-widest\">Teto de\r\n                                    Agressão</h3>\r\n                                <p class=\"text-[10px] text-slate-500 font-bold uppercase\">Frequência Ótima de Bluff</p>\r\n                            </div>\r\n                            <span id=\"del-bluff\"\r\n                                class=\"data-mono text-xs font-bold px-2 py-1 rounded bg-slate-800 border border-slate-700\">-0.0%</span>\r\n                        </div>\r\n                        <div>\r\n                            <div class=\"flex items-baseline gap-2 mb-2\">\r\n                                <span id=\"out-bluff\"\r\n                                    class=\"data-mono text-5xl font-black text-white tracking-tighter\">33.3</span>\r\n                                <span class=\"text-xl font-bold text-sky-400\">%</span>\r\n                            </div>\r\n                            <div class=\"h-1.5 w-full bg-slate-800 rounded-full overflow-hidden mt-4 shadow-inner\">\r\n                                <div id=\"bar-bluff\" class=\"h-full bg-sky-500 bar-transition w-[33.3%]\"></div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- MDF / Defense -->\r\n                    <div class=\"glass-panel p-6 border-t-4 border-t-rose-500 hover:border-t-rose-400 transition-colors\">\r\n                        <div class=\"flex justify-between items-start mb-6\">\r\n                            <div class=\"space-y-1\">\r\n                                <h3 class=\"text-[11px] font-black text-slate-400 uppercase tracking-widest\">Ponto de\r\n                                    Ruptura</h3>\r\n                                <p class=\"text-[10px] text-slate-500 font-bold uppercase\">Limiar de Indiferença (Call)\r\n                                </p>\r\n                            </div>\r\n                            <span id=\"del-defense\"\r\n                                class=\"data-mono text-xs font-bold px-2 py-1 rounded bg-slate-800 border border-slate-700\">-0.0%</span>\r\n                        </div>\r\n                        <div>\r\n                            <div class=\"flex items-baseline gap-2 mb-2\">\r\n                                <span id=\"out-defense\"\r\n                                    class=\"data-mono text-5xl font-black text-white tracking-tighter\">50.0</span>\r\n                                <span class=\"text-xl font-bold text-rose-400\">%</span>\r\n                            </div>\r\n                            <div class=\"h-1.5 w-full bg-slate-800 rounded-full overflow-hidden mt-4 shadow-inner\">\r\n                                <div id=\"bar-defense\" class=\"h-full bg-rose-500 bar-transition w-[50%]\"></div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- INTERACTIVE PANELS -->\r\n                <div class=\"glass-panel flex flex-col min-h-100\">\r\n                    <!-- Panel Navigation -->\r\n                    <div class=\"flex border-b border-slate-800 overflow-x-auto hide-scroll\">\r\n                        <div class=\"action-tab active shrink-0 px-4\" data-target=\"theory\">\r\n                            <i class=\"fa-solid fa-book-open mr-2 opacity-70\"></i> Fundamento Teórico\r\n                        </div>\r\n                        <div class=\"action-tab shrink-0 px-4\" data-target=\"dilution\">\r\n                            <i class=\"fa-solid fa-water mr-2 opacity-70\"></i> Diluição SPR\r\n                        </div>\r\n                        <div class=\"action-tab shrink-0 px-4\" data-target=\"exploit\">\r\n                            <i class=\"fa-solid fa-crosshairs mr-2 opacity-70\"></i> Vetor de Exploit\r\n                        </div>\r\n                        <div class=\"action-tab shrink-0 px-4\" data-target=\"quiz\">\r\n                            <i class=\"fa-solid fa-brain mr-2 opacity-70\"></i> Prova Analítica\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- Panel Content: Theory -->\r\n                    <div id=\"theory\" class=\"content-panel active\"></div>\r\n\r\n                    <!-- Panel Content: SPR Dilution (THE INNOVATION) -->\r\n                    <div id=\"dilution\" class=\"content-panel\">\r\n                        <h3 class=\"text-white font-bold text-xl mb-2 tracking-tight\">O Motor de Diluição (Elasticidade\r\n                            Pós-Flop)</h3>\r\n                        <p class=\"text-slate-400 text-[14px] leading-relaxed mb-8\">O maior erro na análise de ICM é\r\n                            aplicar o Risk Premium do Pré-Flop (All-in Direto) nas <em>streets</em> subsequentes. À\r\n                            medida que o pote cresce e a sua stack remanescente diminui, o <strong>Custo\r\n                                Utilitário</strong> altera-se. A aversão ao risco cai porque você já está\r\n                            financeiramente comprometido na mão.</p>\r\n\r\n                        <div class=\"bg-slate-900/60 border border-slate-800 p-8 rounded-2xl relative\">\r\n                            <h4\r\n                                class=\"text-[10px] font-black text-rose-400 uppercase tracking-widest mb-6 absolute top-4 left-6\">\r\n                                Vazamento de Risk Premium (Defensor)</h4>\r\n\r\n                            <div class=\"pipeline mt-4\">\r\n                                <div class=\"pipeline-node active\" id=\"node-pre\">\r\n                                    <span class=\"text-xs font-bold text-slate-300 mb-1\">PRE</span>\r\n                                    <span class=\"data-mono text-sm font-black text-rose-400\" id=\"dil-pre\">0%</span>\r\n                                </div>\r\n                                <div class=\"pipeline-node\" id=\"node-flop\">\r\n                                    <span class=\"text-xs font-bold text-slate-400 mb-1\">FLOP</span>\r\n                                    <span class=\"data-mono text-sm font-black text-rose-400 opacity-70\"\r\n                                        id=\"dil-flop\">0%</span>\r\n                                </div>\r\n                                <div class=\"pipeline-node\" id=\"node-turn\">\r\n                                    <span class=\"text-xs font-bold text-slate-500 mb-1\">TURN</span>\r\n                                    <span class=\"data-mono text-sm font-black text-rose-400 opacity-50\"\r\n                                        id=\"dil-turn\">0%</span>\r\n                                </div>\r\n                                <div class=\"pipeline-node\" id=\"node-river\">\r\n                                    <span class=\"text-xs font-bold text-slate-600 mb-1\">RIVER</span>\r\n                                    <span class=\"data-mono text-sm font-black text-rose-400 opacity-30\"\r\n                                        id=\"dil-river\">0%</span>\r\n                                </div>\r\n                            </div>\r\n\r\n                            <p class=\"text-xs text-slate-500 font-medium text-center italic mt-6 border-t border-slate-800 pt-4\"\r\n                                id=\"dilution-axiom\">\r\n                                \"Ao chegar no river com SPR menor que 1, a matemática força o jogador a reverter grande\r\n                                parte da sua decisão para ChipEV clássico.\"\r\n                            </p>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <!-- Panel Content: Exploit -->\r\n                    <div id=\"exploit\" class=\"content-panel\"></div>\r\n\r\n                    <!-- Panel Content: Quiz -->\r\n                    <div id=\"quiz\" class=\"content-panel\"></div>\r\n\r\n                </div>\r\n\r\n            </main>\r\n        </div>\r\n\r\n        <footer class=\"text-center pb-12 pt-8 flex flex-col items-center\">\r\n            <div class=\"w-16 h-1 bg-linear-to-r from-transparent via-indigo-500/50 to-transparent mb-6\"></div>\r\n            <div class=\"signature-text\">Raphael Vitoi</div>\r\n            <p class=\"text-[10px] text-slate-500 uppercase tracking-[0.3em] font-bold mt-2\">Architecture & Theory</p>\r\n        </footer>\r\n    </div>\r\n\r\n    <script>\r\n        // The 10 Masterclass Clinical Scenarios (State of the Art Architecture)\r\n        const DATABASE = [\r\n            {\r\n                id: \"paradoxo\",\r\n                title: \"O Paradoxo do Valuation\",\r\n                env: \"Estrutura Padrão (Mid vs Big)\",\r\n                icon: \"⚖️\",\r\n                verdict: { label: \"Agressão Estrangulada\", class: \"text-rose-400 border-rose-500/30\" },\r\n                ip: { pos: \"BTN\", stack: \"40 bb\", rp: 21.4, morph: \"Inelástico (Valor Estrito)\" },\r\n                oop: { pos: \"BB (CL)\", stack: \"55 bb\", rp: 12.9, morph: \"Defensivo Condensado\" },\r\n                theory: `\r\n                    <h3 class=\"text-white font-bold text-xl mb-4 tracking-tight\">O Instinto Traído pela Matemática</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-4 text-[15px]\">O senso comum dita que o BTN com 40bb possui conforto suficiente para oprimir a mesa. Contudo, o HRC revela o pesadelo: o \"RP de ida\" do BTN é quase o dobro do \"RP de volta\" do BB.</p>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-6 text-[15px]\"><strong>Porquê?</strong> O BB sobrevive a um <em>all-in</em>. Já o BTN, se errar um <em>hero-bluff</em>, é aniquilado para o pó absoluto, perdendo instantaneamente o <em>laddering</em> contra todos os <em>shorts</em> da mesa. A capacidade do BTN de blefar é <strong>estrangulada</strong> pela necessidade da Esperança Matemática.</p>\r\n                `,\r\n                exploit: `\r\n                    <h3 class=\"text-indigo-400 font-bold text-xl mb-4 tracking-tight\">A Falsa Liberdade</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-5 text-[15px]\">Se você é o BTN, a sua \"Desvantagem de Risco\" é a sua algema. Tentar usar força bruta contra a única stack capaz de o eliminar é rasgar <em>EV</em>.</p>\r\n                    <ul class=\"space-y-4\">\r\n                        <li class=\"flex gap-4 p-4 bg-slate-900/50 rounded-xl border border-slate-800\">\r\n                            <span class=\"text-indigo-500 text-lg mt-0.5\"><i class=\"fa-solid fa-lock\"></i></span>\r\n                            <div>\r\n                                <strong class=\"text-white block mb-1\">Puxar o Freio de Mão</strong>\r\n                                <span class=\"text-sm text-slate-400\">Contraia severamente os seus bluffs. Aceite que a equidade natural exigida para engajar num pote deste calibre é altíssima.</span>\r\n                            </div>\r\n                        </li>\r\n                    </ul>\r\n                `,\r\n                quiz: {\r\n                    q: \"Por que o BTN (40bb), tendo uma stack gigante, sofre uma punição utilitária (RP) muito maior que o BB (55bb)?\",\r\n                    opts: [\r\n                        { isCorrect: true, text: \"Porque perder o all-in destrói o BTN, retirando sua alavancagem e garantias de payjump. O BB, porém, sobrevive ao golpe.\" },\r\n                        { isCorrect: false, text: \"Porque estar em posição (IP) gera uma penalidade padrão no solver para compensar a realização de equidade pós-flop.\" },\r\n                        { isCorrect: false, text: \"A premissa está errada. O BTN tem um RP menor porque ele domina o range do BB.\" }\r\n                    ],\r\n                    exp: \"A Assimetria de Dor: O BTN põe em risco a sua sobrevivência. O BB arrisca apenas a liderança.\"\r\n                }\r\n            },\r\n            {\r\n                id: \"pacto\",\r\n                title: \"O Pacto Silencioso\",\r\n                env: \"Colisão de Gigantes\",\r\n                icon: \"🤝\",\r\n                verdict: { label: \"Evitação de Ruína\", class: \"text-indigo-400 border-indigo-500/30\" },\r\n                ip: { pos: \"Vice CL\", stack: \"65 bb\", rp: 24.5, morph: \"Linear Especulativo\" },\r\n                oop: { pos: \"CL\", stack: \"70 bb\", rp: 23.5, morph: \"Flat Call Massivo\" },\r\n                theory: `\r\n                    <h3 class=\"text-white font-bold text-xl mb-4 tracking-tight\">A Mútua Destruição Assegurada</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-4 text-[15px]\">Dois gigantes colidem. É essencial notar que esta dinâmica ocorre <strong>quase estritamente entre os dois CLs ou duas stacks grandes e similares</strong>. A destruição mútua é o pior cenário possível. As fichas perdidas viram <em>payjumps</em> grátis aos inativos.</p>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-6 text-[15px]\">Ocorre um <strong>Pacto Silencioso</strong>. A agressão letal (3-bet) colapsa. Os <em>ranges</em> de <em>flat call</em> inflam absurdamente, incluindo o topo. O objetivo é avaliar <em>implied odds</em> no pós-flop sem o risco de um suicídio pré-flop.</p>\r\n                `,\r\n                exploit: `\r\n                    <h3 class=\"text-indigo-400 font-bold text-xl mb-4 tracking-tight\">Punindo o Ego Alheio</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-5 text-[15px]\">O GTO dita passividade. Contudo, se o seu adversário sente que deve \"mandar na mesa\" e opta por inflacionar o pote pré-flop com mãos marginais, ele comete um erro de ICM letal.</p>\r\n                    <ul class=\"space-y-4\">\r\n                        <li class=\"flex gap-4 p-4 bg-slate-900/50 rounded-xl border border-slate-800\">\r\n                            <span class=\"text-indigo-500 text-lg mt-0.5\"><i class=\"fa-solid fa-shield-cat\"></i></span>\r\n                            <div>\r\n                                <strong class=\"text-white block mb-1\">Negação de Ação Barata</strong>\r\n                                <span class=\"text-sm text-slate-400\">Jogue impiedosamente polarizado. Negue a ele o showdown pacífico pós-agressão. Se for para o chão, vá com o topo.</span>\r\n                            </div>\r\n                        </li>\r\n                    </ul>\r\n                `,\r\n                quiz: {\r\n                    q: \"Como as frequências reconfiguram o jogo pré-flop num 'Pacto Silencioso'?\",\r\n                    opts: [\r\n                        { isCorrect: true, text: \"A 3-bet encolhe a um mínimo polarizado, e o flat call infla massivamente para especular sem explodir o SPR.\" },\r\n                        { isCorrect: false, text: \"Eles entram em modo push/fold agressivo para submeter psicologicamente a mesa.\" },\r\n                        { isCorrect: false, text: \"Eles foldam quase 100% das mãos um contra o outro.\" }\r\n                    ],\r\n                    exp: \"O choque direto aniquila a Esperança Matemática. Transfere-se a decisão para o pós-flop onde o risco inicial é menor.\"\r\n                }\r\n            },\r\n            {\r\n                id: \"batata\",\r\n                title: \"O Efeito Batata Quente\",\r\n                env: \"A Dinâmica do Shove\",\r\n                icon: \"🔥\",\r\n                verdict: { label: \"Transferência de Fardo\", class: \"text-amber-400 border-amber-500/30\" },\r\n                ip: { pos: \"UTG (Shove)\", stack: \"25 bb\", rp: 15, morph: \"Polar Máximo\" },\r\n                oop: { pos: \"BB (Call)\", stack: \"20 bb\", rp: 19.5, morph: \"Bluffcatcher Rígido\" },\r\n                theory: `\r\n                    <h3 class=\"text-white font-bold text-xl mb-4 tracking-tight\">O Peso de Agir Primeiro</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-4 text-[15px]\">Quando o UTG faz um <em>open-shove</em> direto, ele altera organicamente a utilidade da mão. Ele atirou a \"Batata Quente\" do ICM para o colo da mesa.</p>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-6 text-[15px]\">O agressor não só impõe o seu Risk Premium, como acopla a ele a <strong>Fold Equity</strong>. O BB já não tem como \"devolver\" essa pressão (re-shovar). Com um <em>range</em> defensivo condensado, o BB atinge o seu limite de dor e é forçado a um <em>overfold</em> drástico.</p>\r\n                `,\r\n                exploit: `\r\n                    <h3 class=\"text-indigo-400 font-bold text-xl mb-4 tracking-tight\">Abusar da Paralisia</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-5 text-[15px]\">Se você é o Agressor, a arma primária é entender que o \"Efeito Batata Quente\" impede que stacks médios reajam com a cadência exigida pelo ChipEV.</p>\r\n                    <ul class=\"space-y-4\">\r\n                        <li class=\"flex gap-4 p-4 bg-slate-900/50 rounded-xl border border-slate-800\">\r\n                            <span class=\"text-indigo-500 text-lg mt-0.5\"><i class=\"fa-solid fa-fire-flame-curved\"></i></span>\r\n                            <div>\r\n                                <strong class=\"text-white block mb-1\">Expandir Zonas de Shove</strong>\r\n                                <span class=\"text-sm text-slate-400\">Contra adversários aterrorizados pela bolha, alargue os shoves (aumente o Alpha) nos spots onde a transferência da pressão é letal para eles.</span>\r\n                            </div>\r\n                        </li>\r\n                    </ul>\r\n                `,\r\n                quiz: {\r\n                    q: \"O que caracteriza o 'Efeito Batata Quente' na aplicação de um shove em ICM?\",\r\n                    opts: [\r\n                        { isCorrect: true, text: \"O agressor impõe o seu RP somado à Fold Equity, removendo do defensor a capacidade de reagir e forçando a dor letal de um call definitivo.\" },\r\n                        { isCorrect: false, text: \"É a situação em que os blinds rodam muito rápido na mesa, forçando a ação.\" },\r\n                        { isCorrect: false, text: \"Ocorre quando o pote sofre re-shoves múltiplos, ignorando as odds.\" }\r\n                    ],\r\n                    exp: \"O agressor transfere a totalidade do fardo da decisão para o oponente, negando a realização de equidade pós-flop.\"\r\n                }\r\n            },\r\n            {\r\n                id: \"agonia\",\r\n                title: \"Agonia do Bluffcatcher\",\r\n                env: \"Teto do MDF (Condensado vs Polar)\",\r\n                icon: \"💔\",\r\n                verdict: { label: \"MDF Quebrado\", class: \"text-sky-400 border-sky-500/30\" },\r\n                ip: { pos: \"CL (Pot Bet)\", stack: \"80 bb\", rp: 4.5, morph: \"Polar Extremado\" },\r\n                oop: { pos: \"Mid (Call)\", stack: \"30 bb\", rp: 22, morph: \"Condensado Sangrante\" },\r\n                theory: `\r\n                    <h3 class=\"text-white font-bold text-xl mb-4 tracking-tight\">O Colapso do MDF</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-4 text-[15px]\">A ilusão do MDF (Minimum Defense Frequency) morre aqui. O CL faz uma aposta Pot-Size. O Mid-stack tem um <em>bluffcatcher</em> puro. Em ChipEV, defenderia metade das vezes.</p>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-6 text-[15px]\">No ICM, um range estritamente condensado contra um range polar com <strong>Vantagem de Risco</strong> gera dissipação de equidade absurda. A pressão de 22% obriga o Mid a \"quebrar\" a matemática e foldar mãos médias mecanicamente (Teto do RP).</p>\r\n                `,\r\n                exploit: `\r\n                    <h3 class=\"text-indigo-400 font-bold text-xl mb-4 tracking-tight\">O Massacre Pós-Flop</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-5 text-[15px]\">O solver não só autoriza, como exige que o CL abuse dessa falha estrutural do range defensivo.</p>\r\n                    <ul class=\"space-y-4\">\r\n                        <li class=\"flex gap-4 p-4 bg-slate-900/50 rounded-xl border border-slate-800\">\r\n                            <span class=\"text-indigo-500 text-lg mt-0.5\"><i class=\"fa-solid fa-skull\"></i></span>\r\n                            <div>\r\n                                <strong class=\"text-white block mb-1\">Overbluff Sistemático</strong>\r\n                                <span class=\"text-sm text-slate-400\">Sabendo que o <em>bluffcatcher</em> não suporta o peso financeiro da eliminação contínua nas streets, expanda os bluffs e aplique <em>triple barrels</em> levianos.</span>\r\n                            </div>\r\n                        </li>\r\n                    </ul>\r\n                `,\r\n                quiz: {\r\n                    q: \"Por que o jogador com alto RP não consegue defender a sua porção de MDF teórica num post-flop contra o CL?\",\r\n                    opts: [\r\n                        { isCorrect: true, text: \"Porque um range condensado (mãos médias) não consegue reter equidade suficiente ao longo das streets para cobrir o altíssimo custo (RP) de eliminação.\" },\r\n                        { isCorrect: false, text: \"Porque os bluffcatchers perdem equidade bruta nas mesas finais.\" },\r\n                        { isCorrect: false, text: \"Porque o agressor sempre terá a melhor mão no longo prazo em dinâmicas de ICM.\" }\r\n                    ],\r\n                    exp: \"A relação de recompensa não fecha. A dor financeira suplanta largamente o lucro teórico de apanhar o blefe.\"\r\n                }\r\n            },\r\n            {\r\n                id: \"lama\",\r\n                title: \"Guerra na Lama\",\r\n                env: \"Micro vs Micro (Escada)\",\r\n                icon: \"⚔️\",\r\n                verdict: { label: \"Fome de Laddering\", class: \"text-emerald-400 border-emerald-500/30\" },\r\n                ip: { pos: \"Micro\", stack: \"12 bb\", rp: 8.5, morph: \"Push Estendido\" },\r\n                oop: { pos: \"Micro\", stack: \"10 bb\", rp: 7.5, morph: \"Call Seletivo\" },\r\n                theory: `\r\n                    <h3 class=\"text-white font-bold text-xl mb-4 tracking-tight\">O Minitorneio de Sobrevivência</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-4 text-[15px]\">Com gigantes monopolizando as fichas, os <em>shorts</em> jogam na lama. A probabilidade matemática de qualquer um deles cravar o torneio é nula.</p>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-6 text-[15px]\">O instinto grita \"ChipEV puro!\". Falso. A abundância de outros shorts eleva drasticamente o <strong>EV do Fold</strong>. Cruzar os braços garante <em>laddering</em> à medida que os outros caem. A sobrevida passiva vale dólares, exigindo um prêmio de risco moderado (~8%) para justificar a abdicação dessa garantia.</p>\r\n                `,\r\n                exploit: `\r\n                    <h3 class=\"text-indigo-400 font-bold text-xl mb-4 tracking-tight\">Quebrando a Paralisia</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-5 text-[15px]\">Muitos amadores entram em \"paralisia de ICM\", foldando mãos sólidas à espera de saltos de premiação.</p>\r\n                    <ul class=\"space-y-4\">\r\n                        <li class=\"flex gap-4 p-4 bg-slate-900/50 rounded-xl border border-slate-800\">\r\n                            <span class=\"text-indigo-500 text-lg mt-0.5\"><i class=\"fa-solid fa-angles-up\"></i></span>\r\n                            <div>\r\n                                <strong class=\"text-white block mb-1\">Aumente a Variância</strong>\r\n                                <span class=\"text-sm text-slate-400\">Se o vilão sofre de aversão cega ao risco para garantir um payjump (overfold), a matemática exige que você roube os blinds para construir uma base para o pódio real.</span>\r\n                            </div>\r\n                        </li>\r\n                    </ul>\r\n                `,\r\n                quiz: {\r\n                    q: \"Por que o Risk Premium entre dois micro-stacks não desce para o zero absoluto (ChipEV)?\",\r\n                    opts: [\r\n                        { isCorrect: true, text: \"Porque o EV de não fazer nada (fold) é positivo. A chance de 'laddering' garantida pela morte alheia requer que a sua agressão compense essa diferença financeira.\" },\r\n                        { isCorrect: false, text: \"Porque os líderes forçam uma bolha secundária que dobra o RP de toda a mesa.\" },\r\n                        { isCorrect: false, text: \"Micro-stacks não sofrem ICM, o RP é sempre nulo. A afirmação é inválida.\" }\r\n                    ],\r\n                    exp: \"Cada vizinho à beira da morte é um payjump virtual garantido no seu bolso. Renunciar a esse assento seguro exige um prémio matemático.\"\r\n                }\r\n            },\r\n            {\r\n                id: \"ameaca\",\r\n                title: \"A Ameaça Orgânica\",\r\n                env: \"Dominância Absoluta (God Mode)\",\r\n                icon: \"👑\",\r\n                verdict: { label: \"Criação de Monstros\", class: \"text-fuchsia-400 border-fuchsia-500/30\" },\r\n                ip: { pos: \"God Mode (CL)\", stack: \"90 bb\", rp: 12, morph: \"Polar Controlado\" },\r\n                oop: { pos: \"Vice\", stack: \"25 bb\", rp: 21, morph: \"Inelástico Defensivo\" },\r\n                theory: `\r\n                    <h3 class=\"text-white font-bold text-xl mb-4 tracking-tight\">O Limite do God Mode</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-4 text-[15px]\">O CL (90bb) ataca o Vice (25bb). O CL é imune à eliminação; a teoria linear diria que ele tem RP 0% e pode esmagar o *board*.</p>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-6 text-[15px]\">Mas o torneio é orgânico. A <strong>Elasticidade do Bubble Factor</strong> intervém. Se o CL aplicar <em>hero-bluffs</em> arrogantes e dobrar o Vice, este salta para 50bb+. <strong>O CL acaba de armar o único rival capaz de usurpar o seu império.</strong> O solver impõe ~12% de RP à liderança, blindando o jogador contra o erro de criar o próprio carrasco.</p>\r\n                `,\r\n                exploit: `\r\n                    <h3 class=\"text-indigo-400 font-bold text-xl mb-4 tracking-tight\">Abater o Inelástico</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-5 text-[15px]\">O Vice (OOP) sofre uma pressão letal de 21%. O seu range de reação deveria ser cirúrgico. Se ele for um jogador *inelástico* que não entende o perigo...</p>\r\n                    <ul class=\"space-y-4\">\r\n                        <li class=\"flex gap-4 p-4 bg-slate-900/50 rounded-xl border border-slate-800\">\r\n                            <span class=\"text-indigo-500 text-lg mt-0.5\"><i class=\"fa-solid fa-ban\"></i></span>\r\n                            <div>\r\n                                <strong class=\"text-white block mb-1\">Morte da Fold Equity</strong>\r\n                                <span class=\"text-sm text-slate-400\">Expurgue os overbluffs. A fold equity não atua sobre quem joga puramente pelas cartas ignorando a morte. Mude a marcha inteiramente para Thin Value.</span>\r\n                            </div>\r\n                        </li>\r\n                    </ul>\r\n                `,\r\n                quiz: {\r\n                    q: \"Sendo imune à eliminação direta, por que o Chip Leader colossal sofre uma punição utilitária considerável contra o 2º classificado?\",\r\n                    opts: [\r\n                        { isCorrect: true, text: \"Para defender a Hegemonia. Dobrar o Vice cria uma ameaça orgânica à liderança, mudando o balanço de poder da mesa inteira.\" },\r\n                        { isCorrect: false, text: \"Porque o HRC impõe que stacks acima de 80bb tenham taxação de risco extra para simular o rake.\" },\r\n                        { isCorrect: false, text: \"Para evitar collusion explícito na plataforma.\" }\r\n                    ],\r\n                    exp: \"O ICM não dita apenas a morte, dita a 'Esperança Matemática' global de chegar à vitória. Dobrar o seu maior rival destrói ativamente a sua maior vantagem no jogo.\"\r\n                }\r\n            },\r\n            {\r\n                id: \"chipev\",\r\n                title: \"O Vácuo Matemático\",\r\n                env: \"Sem Payjumps (ChipEV Puro)\",\r\n                icon: \"⚙️\",\r\n                verdict: { label: \"MDF Perfeito\", class: \"text-slate-400 border-slate-500/30\" },\r\n                ip: { pos: \"Qualquer IP\", stack: \"100 bb\", rp: 0, morph: \"Polar Perfeito\" },\r\n                oop: { pos: \"Qualquer OOP\", stack: \"100 bb\", rp: 0, morph: \"Defesa Base\" },\r\n                theory: `\r\n                    <h3 class=\"text-white font-bold text-xl mb-4 tracking-tight\">O Equilíbrio Linear</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-4 text-[15px]\">Início de torneio ou Cash Game. Não há ICM. A utilidade das fichas é estritamente linear: 1 ficha vale 1 ficha.</p>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-6 text-[15px]\">O Nash Equilibrium atua como um relógio suíço. Contra uma aposta do tamanho do pote, o <strong>Alpha</strong> dita exatos 33.3% de bluffs. O <strong>MDF</strong> repousa em perfeitos 50.0%. A matemática não sofre deformações emocionais ou utilitárias.</p>\r\n                `,\r\n                exploit: `\r\n                    <h3 class=\"text-indigo-400 font-bold text-xl mb-4 tracking-tight\">O Jogo Mecânico</h3>\r\n                    <p class=\"text-slate-300 leading-relaxed mb-5 text-[15px]\">Sem a proteção (ou o freio) das bolhas de prémios, a exploração baseia-se em punir desvios de frequência estritos.</p>\r\n                    <ul class=\"space-y-4\">\r\n                        <li class=\"flex gap-4 p-4 bg-slate-900/50 rounded-xl border border-slate-800\">\r\n                            <span class=\"text-indigo-500 text-lg mt-0.5\"><i class=\"fa-solid fa-bullseye\"></i></span>\r\n                            <div>\r\n                                <strong class=\"text-white block mb-1\">Punição Imediata</strong>\r\n                                <span class=\"text-sm text-slate-400\">Se o oponente folda acima dos 50%, overbluff imprime dinheiro. Se ele paga mais do que deve, limite os bluffs a 0 e expanda as apostas de valor thin. A punição é direta.</span>\r\n                            </div>\r\n                        </li>\r\n                    </ul>\r\n                `,\r\n                quiz: {\r\n                    q: \"Por que num vácuo matemático (ChipEV) o desvio da frequência de bluff (Alpha) é punido imediatamente por um GTO perfeito?\",\r\n                    opts: [\r\n                        { isCorrect: true, text: \"Porque sem a âncora letal do ICM a forçar o 'overfold', a defesa pagará exatamente conforme as pot odds. Blefar além cede EV automático.\" },\r\n                        { isCorrect: false, text: \"Porque o GTO sempre descobre as nossas cartas com base em padrões de sizes.\" },\r\n                        { isCorrect: false, text: \"Porque a agressão em ChipEV só é rentável com underbets.\" }\r\n                    ],\r\n                    exp: \"Sem a dor assimétrica de um torneio, as odds matemáticas governam absolutas. Tudo o que fuja da linha é capturado pela mecânica do Defensor.\"\r\n                }\r\n            }\r\n        ];\r\n\r\n        // System Core\r\n        let currentId = \"paradoxo\";\r\n        let isAnimating = false;\r\n\r\n        // Animação de Contadores (Business Intelligence Vibe)\r\n        function animateValue(id, start, end, duration, formatStr = \"%\") {\r\n            if (start === end) { setTxt(id, end.toFixed(1) + formatStr); return; }\r\n            let startTimestamp = null;\r\n            const step = (timestamp) => {\r\n                if (!startTimestamp) startTimestamp = timestamp;\r\n                const progress = Math.min((timestamp - startTimestamp) / duration, 1);\r\n                // Ease out cubic\r\n                const ease = 1 - Math.pow(1 - progress, 3);\r\n                const current = start + (end - start) * ease;\r\n                setTxt(id, current.toFixed(1) + formatStr);\r\n                if (progress < 1) {\r\n                    globalThis.requestAnimationFrame(step);\r\n                }\r\n            };\r\n            globalThis.requestAnimationFrame(step);\r\n        }\r\n\r\n        function calculateBF(rp) {\r\n            if (rp >= 100) return \"∞\";\r\n            if (rp === 0) return \"1\";\r\n            return (100 / (100 - rp)).toFixed(2);\r\n        }\r\n\r\n        function solveNashDynamics(ip_rp, oop_rp) {\r\n            let defense = 50 - (oop_rp * 1.4) + (ip_rp * 0.3);\r\n            let bluff = 33.3 + (oop_rp * 1.1) - (ip_rp * 0.8);\r\n\r\n            defense = Math.max(0, Math.min(100, defense));\r\n            bluff = Math.max(0, Math.min(100, bluff));\r\n            if (ip_rp === 0 && oop_rp === 0) { bluff = 33.3; defense = 50; }\r\n            return { bluff, defense };\r\n        }\r\n\r\n        // Funções Null-Safe\r\n        function setTxt(id, txt) { const el = document.getElementById(id); if (el) el.innerText = txt; }\r\n        function setHtml(id, html) { const el = document.getElementById(id); if (el) el.innerHTML = html; }\r\n        function setCls(id, cls) { const el = document.getElementById(id); if (el) el.className = cls; }\r\n        function setWidth(id, w) { const el = document.getElementById(id); if (el) el.style.width = w; }\r\n        function setDash(id, val) { const el = document.getElementById(id); if (el) el.style.strokeDasharray = val; }\r\n\r\n        function init() {\r\n            const list = document.getElementById('scenario-list');\r\n            if (list) {\r\n                list.innerHTML = \"\";\r\n                DATABASE.forEach(sc => {\r\n                    const btn = document.createElement('button');\r\n                    btn.className = `scenario-btn ${sc.id === currentId ? 'active' : ''}`;\r\n                    btn.dataset.id = sc.id;\r\n                    btn.onclick = () => loadScenario(sc.id);\r\n                    btn.innerHTML = `\r\n                        <div class=\"icon-box shadow-md\">${sc.icon}</div>\r\n                        <div class=\"flex flex-col text-left w-full pr-2\">\r\n                            <span class=\"text-[10px] font-bold uppercase tracking-widest opacity-60 mb-0.5\">${sc.env}</span>\r\n                            <span class=\"text-[13px] font-bold text-white tracking-wide\">${sc.title}</span>\r\n                        </div>\r\n                        <i class=\"fa-solid fa-chevron-right text-slate-600 opacity-50 text-xs ml-auto\"></i>\r\n                    `;\r\n                    list.appendChild(btn);\r\n                });\r\n            }\r\n\r\n            loadScenario(currentId, true);\r\n            setupTabs();\r\n        }\r\n\r\n        function loadScenario(id, initialLoad = false) {\r\n            if (isAnimating && !initialLoad) return;\r\n            isAnimating = true;\r\n\r\n            const oldData = DATABASE.find(s => s.id === currentId);\r\n            currentId = id;\r\n            const data = DATABASE.find(s => s.id === id);\r\n            if (!data) return;\r\n\r\n            document.querySelectorAll('.scenario-btn').forEach(btn => {\r\n                btn.classList.remove('active');\r\n                if (btn.dataset.id === id) btn.classList.add('active');\r\n            });\r\n\r\n            setTxt('stage-env', data.env);\r\n            setTxt('stage-title', data.title);\r\n\r\n            if (data.verdict) {\r\n                setTxt('verdict-badge', data.verdict.label);\r\n                setCls('verdict-badge', `px-4 py-2 rounded-lg text-[10px] font-black uppercase tracking-widest border transition-all duration-300 bg-slate-900 ${data.verdict.class}`);\r\n            }\r\n\r\n            // Texts\r\n            setTxt('ip-pos', data.ip.pos);\r\n            setTxt('ip-stack', data.ip.stack);\r\n            setTxt('ip-morph', data.ip.morph);\r\n            setTxt('ip-bf-txt', calculateBF(data.ip.rp));\r\n\r\n            setTxt('oop-pos', data.oop.pos);\r\n            setTxt('oop-stack', data.oop.stack);\r\n            setTxt('oop-morph', data.oop.morph);\r\n            setTxt('oop-bf-txt', calculateBF(data.oop.rp));\r\n\r\n            // Run Core Math\r\n            const { bluff, defense } = solveNashDynamics(data.ip.rp, data.oop.rp);\r\n            const oldMath = initialLoad ? { bluff: 0, defense: 0, ipRp: 0, oopRp: 0 } : solveNashDynamics(oldData.ip.rp, oldData.oop.rp);\r\n\r\n            // Animate Numbers\r\n            animateValue('ip-rp-txt', initialLoad ? 0 : oldData.ip.rp, data.ip.rp, 800, \"\");\r\n            animateValue('oop-rp-txt', initialLoad ? 0 : oldData.oop.rp, data.oop.rp, 800, \"\");\r\n            animateValue('out-bluff', oldMath.bluff, bluff, 800, \"\");\r\n            animateValue('out-defense', oldMath.defense, defense, 800, \"\");\r\n\r\n            setWidth('bar-bluff', `${bluff}%`);\r\n            const dB = bluff - 33.3;\r\n            let bluffClass = 'bg-slate-800 border-slate-700 text-slate-400';\r\n            if (dB > 0) bluffClass = 'text-sky-400 bg-sky-500/10 border-sky-500/20';\r\n            else if (dB < 0) bluffClass = 'text-rose-400 bg-rose-500/10 border-rose-500/20';\r\n            setTxt('del-bluff', `${dB > 0 ? '+' : ''}${dB.toFixed(1)}% vs cEV`);\r\n            setCls('del-bluff', `data-mono text-xs font-bold px-2 py-1 rounded border ${bluffClass}`);\r\n\r\n            setWidth('bar-defense', `${defense}%`);\r\n            const dD = defense - 50;\r\n            let defClass = 'bg-slate-800 border-slate-700 text-slate-400';\r\n            if (dD > 0) defClass = 'text-sky-400 bg-sky-500/10 border-sky-500/20';\r\n            else if (dD < 0) defClass = 'text-rose-400 bg-rose-500/10 border-rose-500/20';\r\n            setTxt('del-defense', `${dD > 0 ? '+' : ''}${dD.toFixed(1)}% vs cEV`);\r\n            setCls('del-defense', `data-mono text-xs font-bold px-2 py-1 rounded border ${defClass}`);\r\n\r\n            // Gauges\r\n            setTimeout(() => {\r\n                const ipFill = Math.min(100, (data.ip.rp / 26) * 100);\r\n                setDash('ip-rp-svg', `${ipFill}, 100`);\r\n                const oopFill = Math.min(100, (data.oop.rp / 26) * 100);\r\n                setDash('oop-rp-svg', `${oopFill}, 100`);\r\n            }, 50);\r\n\r\n            // Inject Data\r\n            setHtml('theory', data.theory);\r\n            setHtml('exploit', data.exploit);\r\n            renderQuiz(data.quiz);\r\n\r\n            // Dilution logic\r\n            const flp = Math.max(0, data.oop.rp * 0.7);\r\n            const trn = Math.max(0, data.oop.rp * 0.4);\r\n            const rvr = Math.max(0, data.oop.rp * 0.15);\r\n            setTxt('dil-pre', data.oop.rp.toFixed(1) + \"%\");\r\n            setTxt('dil-flop', flp.toFixed(1) + \"%\");\r\n            setTxt('dil-turn', trn.toFixed(1) + \"%\");\r\n            setTxt('dil-river', rvr.toFixed(1) + \"%\");\r\n\r\n            document.querySelectorAll('.content-panel').forEach(p => {\r\n                if (p.classList.contains('active')) {\r\n                    p.classList.remove('animate-fade-up');\r\n                    p.getBoundingClientRect();\r\n                    p.classList.add('animate-fade-up');\r\n                }\r\n            });\r\n\r\n            setTimeout(() => { isAnimating = false; }, 800);\r\n        }\r\n\r\n        function setupTabs() {\r\n            const tabs = document.querySelectorAll('.action-tab');\r\n            const panels = document.querySelectorAll('.content-panel');\r\n\r\n            tabs.forEach(tab => {\r\n                tab.addEventListener('click', () => {\r\n                    tabs.forEach(t => t.classList.remove('active'));\r\n                    panels.forEach(p => p.classList.remove('active'));\r\n\r\n                    tab.classList.add('active');\r\n                    document.getElementById(tab.dataset.target).classList.add('active');\r\n\r\n                    const targetPanel = document.getElementById(tab.dataset.target);\r\n                    targetPanel.classList.remove('animate-fade-up');\r\n                    targetPanel.getBoundingClientRect();\r\n                    targetPanel.classList.add('animate-fade-up');\r\n                });\r\n            });\r\n        }\r\n\r\n        function renderQuiz(quizData) {\r\n            const container = document.getElementById('quiz');\r\n            let opts = [...quizData.opts];\r\n\r\n            for (let i = opts.length - 1; i > 0; i--) {\r\n                const j = Math.floor(Math.random() * (i + 1));\r\n                [opts[i], opts[j]] = [opts[j], opts[i]];\r\n            }\r\n\r\n            let html = `\r\n                <div class=\"quiz-block\">\r\n                    <p class=\"text-slate-200 font-medium text-lg leading-relaxed mb-6\">${quizData.q}</p>\r\n                    <div class=\"space-y-4\" id=\"quiz-options\">\r\n            `;\r\n\r\n            opts.forEach(opt => {\r\n                html += `\r\n                    <div class=\"quiz-option\" onclick=\"handleQuiz(this, ${opt.isCorrect})\" data-correct=\"${opt.isCorrect}\">\r\n                        <div class=\"w-6 h-6 shrink-0 rounded border border-slate-600 flex items-center justify-center mt-0.5 icon-box text-xs bg-slate-900 shadow-inner\"></div>\r\n                        <span class=\"text-slate-300 text-[15px] font-medium leading-relaxed\">${opt.text}</span>\r\n                    </div>\r\n                `;\r\n            });\r\n\r\n            html += `\r\n                    </div>\r\n                    <div id=\"quiz-explanation\" class=\"hidden mt-8 bg-indigo-950/40 border border-indigo-500/30 p-6 rounded-xl relative overflow-hidden\">\r\n                        <div class=\"absolute left-0 top-0 bottom-0 w-1 bg-indigo-500\"></div>\r\n                        <h4 class=\"text-indigo-400 font-black text-xs uppercase tracking-widest mb-3\">Auditoria Lógica</h4>\r\n                        <p class=\"text-slate-300 text-[15px] leading-relaxed\">${quizData.exp}</p>\r\n                    </div>\r\n                </div>\r\n            `;\r\n\r\n            container.innerHTML = html;\r\n        }\r\n\r\n        globalThis.handleQuiz = function (el, isCorrect) {\r\n            const container = el.closest('#quiz-options');\r\n            if (container.classList.contains('answered')) return;\r\n            container.classList.add('answered');\r\n\r\n            const options = container.querySelectorAll('.quiz-option');\r\n            options.forEach(opt => {\r\n                opt.classList.add('disabled');\r\n                if (opt.dataset.correct === \"true\" && !isCorrect) {\r\n                    opt.classList.remove('disabled');\r\n                    opt.classList.add('correct');\r\n                    opt.querySelector('.icon-box').innerHTML = '<i class=\"fa-solid fa-check text-emerald-400\"></i>';\r\n                }\r\n            });\r\n\r\n            el.classList.remove('disabled');\r\n            if (isCorrect) {\r\n                el.classList.add('correct');\r\n                el.querySelector('.icon-box').innerHTML = '<i class=\"fa-solid fa-check text-emerald-400\"></i>';\r\n            } else {\r\n                el.classList.add('wrong');\r\n                el.querySelector('.icon-box').innerHTML = '<i class=\"fa-solid fa-xmark text-rose-400\"></i>';\r\n            }\r\n\r\n            const exp = document.getElementById('quiz-explanation');\r\n            exp.classList.remove('hidden');\r\n            exp.classList.add('animate-fade-up');\r\n        }\r\n\r\n        globalThis.onload = init;\r\n    </script>\r\n</body>\r\n\r\n</html>\r\n","v":7}

{"kind":"setContent","time":1778698016769,"id":447,"content":"@{\r\n    # Dicionário de Sinônimos e Entropia Humana para a Smart CLI\r\n    \r\n    \"@implementor\"   = @(\r\n        \"deu pau\",\r\n        \"quebrou\",\r\n        \"não funciona\",\r\n        \"ajeita o front\",\r\n        \"refatora\",\r\n        \"front-end\",\r\n        \"tela\",\r\n        \"componente\",\r\n        \"bota pra rodar\"\r\n    )\r\n    \r\n    \"@pesquisador\"   = @(\r\n        \"descobre\",\r\n        \"vai atrás\",\r\n        \"qual a melhor\",\r\n        \"diferença entre\",\r\n        \"investiga\",\r\n        \"explora\",\r\n        \"mapeia\"\r\n    )\r\n    \r\n    \"@planner\"       = @(\r\n        \"desenha o plano\",\r\n        \"como vamos fazer\",\r\n        \"passo a passo\",\r\n        \"visão técnica\",\r\n        \"arquitetar\",\r\n        \"como eu resolvo\"\r\n    )\r\n    \r\n    \"@auditor\"       = @(\r\n        \"tá certo isso?\",\r\n        \"avalia a spec\",\r\n        \"encontra falha\",\r\n        \"tá coeso?\",\r\n        \"procura gargalo\"\r\n    )\r\n    \r\n    \"@maverick\"      = @(\r\n        \"o que acha disso\",\r\n        \"sugere algo\",\r\n        \"dá uma ideia\",\r\n        \"pensa fora da caixa\",\r\n        \"visão além\",\r\n        \"inovar\"\r\n    )\r\n    \r\n    \"@curator\"       = @(\r\n        \"avalia o tom\",\r\n        \"tá ético?\",\r\n        \"brand\",\r\n        \"tá bonito?\"\r\n    )\r\n    \r\n    \"@skillmaster\"   = @(\r\n        \"limpa a sujeira\",\r\n        \"roda o backup\",\r\n        \"faz a faxina\",\r\n        \"operações de rotina\",\r\n        \"manutenção\"\r\n    )\r\n    \r\n    \"@securitychief\" = @(\r\n        \"tem vazamento?\",\r\n        \"tá seguro?\",\r\n        \"protege\",\r\n        \"blindar\"\r\n    )\r\n    \r\n    \"@organizador\"   = @(\r\n        \"arruma a casa\",\r\n        \"arruma as pastas\"\r\n    )\r\n}","v":1}

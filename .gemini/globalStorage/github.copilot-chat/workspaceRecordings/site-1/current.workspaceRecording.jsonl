{"kind":"setContent","time":1778597912664,"id":91,"content":"/* ==============================================\r\n   CALCULADORA ICM (EQUITY CALCULATOR)\r\n   ============================================== */\r\n\r\n.calcPanel {\r\n  padding: 1.5rem;\r\n  display: flex;\r\n  flex-direction: column;\r\n  gap: 1.25rem;\r\n}\r\n\r\n.calcHeader {\r\n  display: flex;\r\n  align-items: center;\r\n  justify-content: space-between;\r\n}\r\n\r\n.calcTitle {\r\n  margin: 0;\r\n  font-size: 0.65rem;\r\n  font-weight: 900;\r\n  color: var(--text-muted); /* NOSONAR */\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.15em;\r\n}\r\n\r\n.calcHeaderActions {\r\n  display: flex;\r\n  gap: 0.5rem;\r\n}\r\n\r\n.calcBtnOutline {\r\n  padding: 0.3rem 0.6rem;\r\n  border-radius: 6px;\r\n  background-color: rgba(30, 41, 59, 0.6);\r\n  border: 1px solid rgba(255, 255, 255, 0.06);\r\n  color: var(--text-light); /* NOSONAR */\r\n  font-size: 0.58rem;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.1em;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.calcBtnOutline:hover {\r\n  background-color: rgba(30, 41, 59, 0.9);\r\n  color: var(--text-bright);\r\n  border-color: rgba(255, 255, 255, 0.12);\r\n}\r\n\r\n.calcBtnOutlineActive {\r\n  background-color: rgba(67, 56, 202, 0.55);\r\n  border-color: rgba(129, 140, 248, 0.65);\r\n  color: var(--text-main); /* NOSONAR */\r\n}\r\n\r\n.calcParserContainer {\r\n  background-color: rgba(15, 23, 42, 0.6);\r\n  border: 1px solid rgba(99, 102, 241, 0.2);\r\n  border-radius: 12px;\r\n  padding: 1rem;\r\n}\r\n\r\n.calcParserLabel {\r\n  font-size: 0.6rem;\r\n  color: var(--text-muted); /* NOSONAR */\r\n  margin: 0 0 0.5rem;\r\n  font-style: italic;\r\n}\r\n\r\n.calcParserTextarea {\r\n  width: 100%;\r\n  background-color: var(--bg-deep);\r\n  border: 1px solid var(--bg-subtle);\r\n  border-radius: 8px;\r\n  color: var(--text-bright); /* NOSONAR */\r\n  padding: 0.75rem;\r\n  font-size: 0.75rem;\r\n  font-family: var(--sim-font-mono, monospace);\r\n  font-variant-numeric: tabular-nums;\r\n  resize: vertical;\r\n}\r\n\r\n.calcParserError {\r\n  margin-top: 0.6rem;\r\n  padding: 0.5rem 0.75rem;\r\n  border-radius: 6px;\r\n  background-color: rgba(136, 19, 55, 0.75);\r\n  border: 1px solid rgba(251, 113, 133, 0.65);\r\n  color: #fff1f2; /* NOSONAR */\r\n  font-size: 0.6rem;\r\n  font-weight: 600;\r\n}\r\n\r\n.calcParserBtn {\r\n  margin-top: 0.5rem;\r\n  padding: 0.4rem 1rem;\r\n  border-radius: 8px;\r\n  background-color: var(--bg-subtle);\r\n  border: none;\r\n  color: var(--text-main);\r\n  font-size: 0.65rem;\r\n  font-weight: 700;\r\n  cursor: default;\r\n  opacity: 0.5;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.calcParserBtnActive {\r\n  background-color: var(--accent-indigo);\r\n  cursor: pointer;\r\n  opacity: 1;\r\n}\r\n\r\n.calcParserBtnActive:hover {\r\n  background-color: var(--accent-indigo-mid);\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.calcPresetContainer {\r\n  display: flex;\r\n  gap: 0.4rem;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.calcPresetBtn {\r\n  padding: 0.3rem 0.6rem;\r\n  border-radius: 6px;\r\n  background-color: rgba(30, 41, 59, 0.5);\r\n  border: 1px solid rgba(255, 255, 255, 0.05);\r\n  color: var(--text-light); /* NOSONAR */\r\n  font-size: 0.58rem;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  transition: all 0.2s ease;\r\n}\r\n\r\n.calcPresetBtn:hover {\r\n  background-color: rgba(30, 41, 59, 0.8);\r\n  color: var(--text-bright);\r\n}\r\n\r\n.calcGrid2Col {\r\n  display: grid;\r\n  grid-template-columns: 1fr 1fr;\r\n  gap: 1rem;\r\n}\r\n\r\n.calcSection {\r\n  background-color: rgba(15, 23, 42, 0.6);\r\n  border: 1px solid rgba(255, 255, 255, 0.06);\r\n  border-radius: 12px;\r\n  padding: 0.75rem;\r\n}\r\n\r\n.calcSectionTitle {\r\n  font-size: 0.58rem;\r\n  font-weight: 900;\r\n  color: var(--text-muted); /* NOSONAR */\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.15em;\r\n  margin: 0 0 0.5rem;\r\n}\r\n\r\n.calcRow {\r\n  display: flex;\r\n  gap: 0.4rem;\r\n  margin-bottom: 0.4rem;\r\n  align-items: center;\r\n}\r\n\r\n.calcPrizeIndex {\r\n  font-size: 0.58rem;\r\n  color: var(--text-muted); /* NOSONAR */\r\n  width: 20px;\r\n  text-align: right;\r\n}\r\n\r\n.calcInputText {\r\n  flex: 1;\r\n  background-color: var(--bg-deep);\r\n  border: 1px solid var(--bg-subtle);\r\n  border-radius: 6px;\r\n  color: var(--text-bright); /* NOSONAR */\r\n  padding: 0.35rem 0.5rem;\r\n  font-size: 0.65rem;\r\n  min-width: 0;\r\n  transition: border-color 0.2s;\r\n}\r\n\r\n.calcInputText:focus {\r\n  border-color: var(--accent-indigo);\r\n  outline: none;\r\n}\r\n\r\n.calcInputNumber {\r\n  width: 60px;\r\n  background-color: var(--bg-deep);\r\n  border: 1px solid var(--bg-subtle);\r\n  border-radius: 6px;\r\n  color: var(--accent-indigo-light); /* NOSONAR */\r\n  padding: 0.35rem 0.5rem;\r\n  font-size: 0.65rem;\r\n  font-family: var(--sim-font-mono, monospace);\r\n  font-variant-numeric: tabular-nums;\r\n  text-align: right;\r\n}\r\n\r\n.calcPrizeInput {\r\n  flex: 1;\r\n  background-color: var(--bg-deep);\r\n  border: 1px solid var(--bg-subtle);\r\n  border-radius: 6px;\r\n  color: var(--sim-color-emerald, #10b981); /* NOSONAR */\r\n  padding: 0.35rem 0.5rem;\r\n  font-size: 0.65rem;\r\n  font-family: var(--sim-font-mono, monospace);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.calcBtnRemove {\r\n  background: none;\r\n  border: none;\r\n  color: var(--text-muted); /* NOSONAR */\r\n  cursor: pointer;\r\n  font-size: 0.7rem;\r\n  padding: 0 4px;\r\n  transition: color 0.2s;\r\n}\r\n\r\n.calcBtnRemove:hover {\r\n  color: var(--accent-danger);\r\n}\r\n\r\n.calcBtnAdd {\r\n  width: 100%;\r\n  padding: 0.3rem;\r\n  border-radius: 6px;\r\n  background-color: rgba(30, 41, 59, 0.5);\r\n  border: 1px dashed var(--bg-subtle);\r\n  color: var(--text-light); /* NOSONAR */\r\n  font-size: 0.58rem;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n  margin-top: 0.25rem;\r\n  transition: all 0.2s;\r\n}\r\n\r\n.calcBtnAdd:hover {\r\n  background-color: rgba(30, 41, 59, 0.8);\r\n  border-style: solid;\r\n  color: var(--text-bright);\r\n}\r\n\r\n.calcBtnPrizeGroup {\r\n  display: flex;\r\n  gap: 0.4rem;\r\n  margin-top: 0.25rem;\r\n}\r\n\r\n.calcBtnPrizeAdd {\r\n  flex: 1;\r\n  padding: 0.3rem;\r\n  border-radius: 6px;\r\n  background-color: rgba(30, 41, 59, 0.5);\r\n  border: 1px dashed var(--bg-subtle);\r\n  color: var(--text-light); /* NOSONAR */\r\n  font-size: 0.58rem;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n}\r\n\r\n.calcBtnPrizeRemove {\r\n  padding: 0.3rem 0.6rem;\r\n  border-radius: 6px;\r\n  background-color: rgba(136, 19, 55, 0.8);\r\n  border: 1px solid rgba(251, 113, 133, 0.7);\r\n  color: #fff1f2; /* NOSONAR */\r\n  font-size: 0.58rem;\r\n  font-weight: 700;\r\n  cursor: pointer;\r\n}\r\n\r\n.calcStatGrid {\r\n  display: flex;\r\n  gap: 0.75rem;\r\n  flex-wrap: wrap;\r\n}\r\n\r\n.calcStatCard {\r\n  flex: 1 1 80px;\r\n  background-color: rgba(15, 23, 42, 0.6);\r\n  border: 1px solid rgba(255, 255, 255, 0.06);\r\n  border-radius: 10px;\r\n  padding: 0.6rem 0.75rem;\r\n  text-align: center;\r\n}\r\n\r\n.calcStatLabel {\r\n  font-size: 0.58rem;\r\n  color: var(--text-muted); /* NOSONAR */\r\n  font-weight: 700;\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.1em;\r\n  margin-bottom: 0.2rem;\r\n}\r\n\r\n.calcStatValue {\r\n  font-size: 0.75rem;\r\n  font-weight: 700;\r\n  font-family: var(--sim-font-mono, monospace);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.calcResultPanel {\r\n  background-color: rgba(15, 23, 42, 0.6);\r\n  border: 1px solid rgba(99, 102, 241, 0.15);\r\n  border-radius: 12px;\r\n  padding: 1rem;\r\n}\r\n\r\n.calcResultTitle {\r\n  font-size: 0.58rem;\r\n  font-weight: 900;\r\n  color: var(--accent-indigo-light); /* NOSONAR */\r\n  text-transform: uppercase;\r\n  letter-spacing: 0.15em;\r\n  margin: 0 0 0.75rem;\r\n}\r\n\r\n.calcResultRow {\r\n  margin-bottom: 0.8rem;\r\n  padding-bottom: 0.8rem;\r\n  border-bottom: 1px solid rgba(255, 255, 255, 0.03);\r\n}\r\n\r\n.calcResultRow:last-child {\r\n  margin-bottom: 0;\r\n  padding-bottom: 0;\r\n  border-bottom: none;\r\n}\r\n\r\n.calcResultHeader {\r\n  display: flex;\r\n  justify-content: space-between;\r\n  margin-bottom: 0.4rem;\r\n  align-items: center;\r\n}\r\n\r\n.calcResultName {\r\n  font-size: 0.75rem;\r\n  color: var(--text-bright); /* NOSONAR */\r\n  font-weight: 600;\r\n  display: flex;\r\n  align-items: center;\r\n  gap: 0.5rem;\r\n}\r\n\r\n.calcHeroBadge {\r\n  font-size: 0.5rem;\r\n  background-color: var(--accent-indigo-dark);\r\n  color: var(--text-main);\r\n  padding: 0.1rem 0.3rem;\r\n  border-radius: 4px;\r\n  text-transform: uppercase;\r\n}\r\n\r\n.calcResultValues {\r\n  display: flex;\r\n  gap: 0.75rem;\r\n  align-items: center;\r\n}\r\n\r\n.calcResultChips {\r\n  font-size: 0.6rem;\r\n  color: var(--text-muted); /* NOSONAR */\r\n  font-family: var(--sim-font-mono, monospace);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.calcResultEquity {\r\n  font-size: 0.8rem;\r\n  color: var(--sim-color-indigo, #6366f1); /* NOSONAR */\r\n  font-weight: 800;\r\n  font-family: var(--sim-font-mono, monospace);\r\n  font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.calcResultDelta {\r\n  font-size: 0.6rem;\r\n  font-weight: 700;\r\n  padding: 0.15rem 0.4rem;\r\n  border-radius: 4px;\r\n  font-family: var(--sim-font-mono, monospace);\r\n  font-variant-numeric: tabular-nums;\r\n  min-width: 45px;\r\n  text-align: center;\r\n}\r\n\r\n.calcResultDeltaPos {\r\n  color: var(--sim-color-emerald, #10b981); /* NOSONAR */\r\n  background-color: rgba(16, 185, 129, 0.1);\r\n  border: 1px solid rgba(16, 185, 129, 0.2);\r\n}\r\n\r\n.calcResultDeltaNeg {\r\n  color: var(--sim-color-rose, #e11d48); /* NOSONAR */\r\n  background-color: rgba(244, 63, 94, 0.1);\r\n  border: 1px solid rgba(244, 63, 94, 0.2);\r\n}\r\n\r\n.calcResultDeltaNeu {\r\n  color: var(--text-muted); /* NOSONAR */\r\n  background-color: transparent;\r\n}\r\n\r\n.calcResultBarContainer {\r\n  position: relative;\r\n  height: 4px;\r\n  background-color: rgba(30, 41, 59, 0.5);\r\n  border-radius: 2px;\r\n  overflow: hidden;\r\n}\r\n\r\n.calcResultBarChips {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  height: 100%;\r\n  background-color: rgba(148, 163, 184, 0.2);\r\n  border-radius: 2px;\r\n  transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);\r\n}\r\n\r\n.calcResultBarEquity {\r\n  position: absolute;\r\n  top: 0;\r\n  left: 0;\r\n  height: 100%;\r\n  background-color: var(--accent-indigo);\r\n  box-shadow: 0 0 8px rgba(99, 102, 241, 0.4);\r\n  border-radius: 2px;\r\n  transition: width 0.8s cubic-bezier(0.4, 0, 0.2, 1);\r\n}\r\n\r\n.calcInsightBox {\r\n  margin-top: 1rem;\r\n  padding: 0.75rem 1rem;\r\n  border-radius: 10px;\r\n  background-color: rgba(30, 41, 59, 0.82);\r\n  border: 1px solid rgba(148, 163, 184, 0.32);\r\n  font-size: 0.65rem;\r\n  color: #f1f5f9; /* NOSONAR */\r\n  line-height: 1.6;\r\n}\r\n\r\n.calcInsightIcon {\r\n  color: var(--accent-indigo-light); /* NOSONAR */\r\n  margin-right: 8px;\r\n}\r\n\r\n@media (max-width: 600px) {\r\n  .calcGrid2Col {\r\n    grid-template-columns: 1fr;\r\n  }\r\n}\r\n\r\n","v":1}

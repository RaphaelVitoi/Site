{"kind":"setContent","time":1778715493623,"id":108,"content":"# NUCLEO SOBERANO (Friccao Zero)\r\naiofiles==25.1.0\r\naiohttp==3.13.5\r\naiosqlite==0.22.1\r\nfastapi==0.136.1\r\npydantic==2.13.4\r\npydantic-settings==2.13.1\r\nuvicorn==0.46.0\r\n\r\n# MOTOR MATEMATICO & ANALYTICS\r\nnumpy==2.4.4\r\npandas==3.0.3\r\nscikit-learn==1.8.0\r\nscipy==1.17.1\r\n\r\n# RAG & MEMORIA VETORIAL (ONNX Optimized)\r\nchromadb==1.5.9\r\nonnxruntime==1.25.1\r\nsentence-transformers==5.4.1\r\n\r\n# API EXTERNAS (LLM)\r\ngoogle-generativeai==0.8.6\r\nopenai==2.36.0\r\nanthropic==0.101.0\r\nhttpx==0.28.1\r\n\r\n# UTILITARIOS DE INGESTAO\r\npypdf==6.11.0\r\npython-docx==1.1.2\r\nopenpyxl==3.1.5\r\nregex==2026.2.28\r\nrequests==2.34.0\r\nPyYAML==6.0.3\r\ntqdm==4.67.3\r\nrich==14.3.3\r\n\r\n# INFRAESTRUTURA & MONITORAMENTO\r\npsutil==7.2.2\r\npython-dateutil==2.9.0.post0\r\ntenacity==9.1.4\r\nwatchdog==6.0.0\r\nwatchfiles==1.1.1\r\n\r\n# TESTES\r\npytest==9.0.3\r\npytest-asyncio==1.3.0\r\n","v":1}

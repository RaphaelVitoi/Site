{"kind":"setContent","time":1778724831293,"id":261,"content":"param(\n    [Parameter(Position = 0)]\n    [string]$TaskId\n)\n\n. (Join-Path (Join-Path $PSScriptRoot \"..\\utils\") \"NexusScriptTools.ps1\")\n\n$ProjectRoot = Get-NexusProjectRoot -StartDir $PSScriptRoot\n$PythonCmd = Get-NexusPythonCmd -ProjectRoot $ProjectRoot\n$TaskExecutor = Join-Path $ProjectRoot \"task_executor.py\"\n$raw = & $PythonCmd $TaskExecutor \"db-get\" \"all\" \"--json\"\n\nif ($LASTEXITCODE -ne 0) {\n    Write-Error \"Falha ao consultar a fila SQLite.\"\n    exit 1\n}\n\n$tasks = @()\nif ($raw) {\n    $tasks = $raw | ConvertFrom-Json\n}\n\nif ($TaskId) {\n    $task = $tasks | Where-Object { $_.id -eq $TaskId } | Select-Object -First 1\n    if (-not $task) {\n        Write-Output \"Nenhuma tarefa encontrada com o ID: $TaskId\"\n        exit 0\n    }\n\n    $task | ConvertTo-Json -Depth 10\n    exit 0\n}\n\nif (-not $tasks -or $tasks.Count -eq 0) {\n    Write-Output \"Nenhuma tarefa na fila.\"\n    exit 0\n}\n\n$tasks |\n    Select-Object id, agent, status, @{Name = \"description\"; Expression = {\n        $desc = $_.description\n        if (-not $desc) { return \"\" }\n        if ($desc.Length -le 80) { return $desc }\n        return $desc.Substring(0, 80) + \"...\"\n    }}, timestamp |\n    Format-Table -AutoSize\n","v":1}

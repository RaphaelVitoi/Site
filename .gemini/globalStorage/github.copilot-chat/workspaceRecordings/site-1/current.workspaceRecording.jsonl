{"kind":"setContent","time":1778697327068,"id":302,"content":"'use client';\r\n\r\nimport { SotaTooltip } from '@/components/simulator/ui/SotaTooltip';\r\n\r\ninterface GuideToolbarProps {\r\n    onExport: () => void;\r\n}\r\n\r\nexport const GuideToolbar = ({ onExport }: GuideToolbarProps) => (\r\n    <div className=\"flex flex-wrap items-center justify-between gap-6 glass-panel p-5 mb-6 animate-sota-in rounded-2xl border border-white/5 shadow-lg\">\r\n        <div className=\"flex flex-wrap items-center gap-5\">\r\n            <span className=\"text-[0.65rem] font-black uppercase tracking-widest text-text-dim opacity-70\">Guia SOTA</span>\r\n            <div className=\"w-px h-4 bg-white/10 hidden sm:block\"></div>\r\n            <SotaTooltip align=\"left\" title=\"Delta (Δ)\" desc=\"Diferença matemática absoluta entre dois estados.\">\r\n                <span className=\"text-[0.7rem] font-bold text-text-muted cursor-help hover:text-accent-indigo flex items-center gap-2 transition-colors bg-white/5 px-2.5 py-1.5 rounded-lg border border-white/5 hover:border-accent-indigo/30\">\r\n                    <i className=\"fa-solid fa-triangle-exclamation text-accent-indigo-light\"></i> Δ Delta\r\n                </span>\r\n            </SotaTooltip>\r\n            <SotaTooltip align=\"center\" title=\"Pontos Percentuais (p.p.)\" desc=\"Diferença aritmética real entre porcentagens.\">\r\n                <span className=\"text-[0.7rem] font-bold text-text-muted cursor-help hover:text-accent-indigo flex items-center gap-2 transition-colors bg-white/5 px-2.5 py-1.5 rounded-lg border border-white/5 hover:border-accent-indigo/30\">\r\n                    <i className=\"fa-solid fa-percent text-accent-indigo-light\"></i> p.p.\r\n                </span>\r\n            </SotaTooltip>\r\n            <div className=\"w-px h-4 bg-white/10 hidden sm:block\"></div>\r\n            <SotaTooltip align=\"right\" title=\"Física Sincronizada\" desc=\"A mesa respira em tempo real. Cada ajuste de stack altera a gravidade de todos os simuladores.\">\r\n                <span className=\"text-[0.7rem] font-black text-accent-emerald flex items-center gap-2 uppercase tracking-widest bg-accent-emerald/5 px-3 py-1.5 rounded-lg border border-accent-emerald/20 shadow-inner\">\r\n                    <span className=\"w-1.5 h-1.5 rounded-full bg-accent-emerald animate-pulse\"></span> Quantum Sync\r\n                </span>\r\n            </SotaTooltip>\r\n        </div>\r\n        <div>\r\n            <button onClick={ onExport } className=\"flex items-center gap-2 px-4 py-2 bg-black/40 hover:bg-accent-indigo/20 border border-white/10 hover:border-accent-indigo/50 text-text-muted hover:text-white rounded-xl text-[0.65rem] font-black uppercase tracking-widest transition-all shadow-md\">\r\n                <i className=\"fa-solid fa-file-export text-accent-indigo\"></i> Exportar HRC\r\n            </button>\r\n        </div>\r\n    </div>\r\n);\r\n","v":1}

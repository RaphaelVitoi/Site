\": \"^0.5.19\",\r\n        \"@testing-library/jest-dom\": \"^6.9.1\",\r\n        \"@testing-library/react\": \"^14.3.1\",\r\n        \"@types/jest\": \"^29.5.12\",\r\n        \"@types/node\": \"^22.0.0\",\r\n        \"@types/react\": \"^18.3.3\",\r\n        \"@types/react-dom\": \"^18.3.0\",\r\n        \"@types/sqlite3\": \"^3.1.11\",\r\n        \"autoprefixer\": \"^10.4.19\",\r\n        \"eslint\": \"^8.57.1\",\r\n        \"eslint-config-next\": \"^15.0.0\",\r\n        \"husky\": \"^8.0.3\",\r\n        \"jest\": \"^29.7.0\",\r\n        \"jest-environment-jsdom\": \"^30.4.1\",\r\n        \"lint-staged\": \"^16.4.0\",\r\n        \"postcss\": \"^8.5.12\",\r\n        \"prisma\": \"^5.22.0\",\r\n        \"tailwindcss\": \"^4.3.0\",\r\n        \"ts-jest\": \"^29.1.2\",\r\n        \"ts-node\": \"^10.9.2\",\r\n        \"turbo\": \"^2.9.1\",\r\n        \"typescript\": \"^5.9.3\"\r\n      },\r\n      \"engines\": {\r\n        \"node\": \">=22.0.0\"\r\n      }\r\n    },\r\n    \"frontend/node_modules/@braintree/sanitize-url\": {\r\n      \"version\": \"6.0.4\",\r\n      \"resolved\": \"https://registry.npmjs.org/@braintree/sanitize-url/-/sanitize-url-6.0.4.tgz\",\r\n      \"integrity\": \"sha512-s3jaWicZd0pkP0jf5ysyHUI/RE7MHos6qlToFcGWXVp+ykHOy77OUMrfbgJ9it2C5bow7OIQwYYaHjk9XlBQ2A==\",\r\n      \"license\": \"MIT\"\r\n    },\r\n    \"frontend/node_modules/@hookform/resolvers\": {\r\n      \"version\": \"3.9.0\",\r\n      \"resolved\": \"https://registry.npmjs.org/@hookform/resolvers/-/resolvers-3.9.0.tgz\",\r\n      \"integrity\": \"sha512-bU0Gr4EepJ/EQsH/IwEzYLsT/PEj5C0ynLQ4m+GSHS+xKH4TfSelhluTgOaoc4kA5s7eCsQbM4wvZLzELmWzUg==\",\r\n      \"license\": \"MIT\",\r\n      \"peerDependencies\": {\r\n        \"react-hook-form\": \"^7.0.0\"\r\n      }\r\n    },\r\n    \"frontend/node_modules/@jest/console\": {\r\n      \"version\": \"29.7.0\",\r\n      \"resolved\": \"https://registry.npmjs.org/@jest/console/-/console-29.7.0.tgz\",\r\n      \"integrity\": \"sha512-5Ni4CU7XHQi32IJ3
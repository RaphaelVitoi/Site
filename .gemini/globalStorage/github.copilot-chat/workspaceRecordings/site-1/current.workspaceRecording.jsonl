{"kind":"setContent","time":1778678353399,"id":82,"content":"import React from 'react';\r\n\r\ninterface GlassPanelProps extends React.HTMLAttributes<HTMLDivElement> {\r\n    children: React.ReactNode;\r\n}\r\n\r\nexport function GlassPanel( { children, className = '', ...props }: Readonly<GlassPanelProps> ) {\r\n    return (\r\n        <div className={ `glass-panel ${className}` } { ...props }>\r\n            { children }\r\n        </div>\r\n    );\r\n}\r\n","v":1}

{"kind":"setContent","time":1778727643833,"id":507,"content":"FROM node:22-alpine3.20 AS base\r\n\r\n# Stage 1: Resolucao de Dependencias O(1)\r\nFROM base AS deps\r\nWORKDIR /app\r\nCOPY package.json package-lock.json* ./\r\nRUN npm ci\r\n\r\n# Stage 2: Compilacao (Build) e Purificacao Standalone\r\nFROM base AS builder\r\nWORKDIR /app\r\nCOPY --from=deps /app/node_modules ./node_modules\r\nCOPY . .\r\nENV NEXT_TELEMETRY_DISABLED=1\r\nRUN npm run build\r\n\r\n# Stage 3: Runtime SOTA (Friccao Zero)\r\nFROM base AS runner\r\nWORKDIR /app\r\nENV NODE_ENV=production\r\nENV NEXT_TELEMETRY_DISABLED=1\r\n\r\nCOPY --from=builder /app/public ./public\r\nCOPY --from=builder /app/.next/standalone ./\r\nCOPY --from=builder /app/.next/static ./.next/static\r\n\r\nEXPOSE 3000\r\nENV PORT=3000\r\nENV HOSTNAME=\"0.0.0.0\"\r\n\r\nCMD [\"node\", \"server.js\"]\r\n","v":1}

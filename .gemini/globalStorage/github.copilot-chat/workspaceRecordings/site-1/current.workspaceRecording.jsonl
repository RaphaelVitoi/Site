{"kind":"setContent","time":1778715436931,"id":113,"content":"# pylint: disable=missing-module-docstring\r\n\r\nimport sqlite3\r\n\r\nconn = sqlite3.connect(\"queue/tasks.db\")\r\ncursor = conn.cursor()\r\ncursor.execute(\r\n    \"SELECT id, agent, description FROM tasks ORDER BY timestamp DESC LIMIT 3\"\r\n)\r\nrows = cursor.fetchall()\r\nfor row in rows:\r\n    print(f\"ID: {row[0]} | AGENT: {row[1]} | DESC: {row[2][:50]}...\")\r\nconn.close()\r\n","v":1}

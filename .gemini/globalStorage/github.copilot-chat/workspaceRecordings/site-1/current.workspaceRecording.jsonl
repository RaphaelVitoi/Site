{"kind":"changed","id":356,"time":1778708940347,"edit":[[0,7205,"import React, { useState, useMemo, useContext, useCallback, useRef, useEffect } from \"react\";\r\nimport { QuizEngine } from \"@/components/quiz/QuizEngine\";\r\nimport {\r\n  generateDynamicICMQuiz,\r\n  type SimulatorState,\r\n} from \"@/components/quiz/icmQuizGenerator\";\r\nimport {\r\n  SotaMetricsContext,\r\n  SotaWasmContext,\r\n} from \"@/components/simulator/SotaContext\";\r\nimport { useSotaTelemetry } from \"@/components/simulator/hooks/useSotaTelemetry\";\r\n\r\ninterface SimulatorQuizWidgetProps {\r\n  simulatorState: SimulatorState;\r\n}\r\n\r\nexport const SimulatorQuizWidget: React.FC<SimulatorQuizWidgetProps> = ({\r\n  simulatorState,\r\n}) => {\r\n  const [keySeed, setKeySeed] = useState(0);\r\n  const [ghostMode, setGhostMode] = useState(false);\r\n\r\n  const metricsCtx = useContext(SotaMetricsContext);\r\n  const wasmCtx = useContext(SotaWasmContext);\r\n  const { track } = useSotaTelemetry(\"SimulatorQuizWidget\");\r\n  const lastQuestionTime = useRef<number>(0);\r\n\r\n  // SOTA: Cronômetro de tempo de reação iniciado na montagem\r\n  useEffect(() => {\r\n    lastQuestionTime.current = performance.now();\r\n  }, []);\r\n\r\n  // Memoiza as questões para impedir re-renderizações desnecessárias durante a digitação\r\n  const questions = useMemo(() => {\r\n    const generated = generateDynamicICMQuiz({\r\n      ...simulatorState,\r\n      predictiveProfile: metricsCtx?.predictiveProfile ?? {},\r\n    });\r\n\r\n    if (metricsCtx?.apiQuantumMetrics) {\r\n      const { perspectiva, adjustedEvFold } = metricsCtx.apiQuantumMetrics;\r\n      return generated.map((q) => ({\r\n        ...q,\r\n        explanation: `${q.explanation}\\n\\n[SOTA Telemetry]: Perspectiva Matemática (PM): ${perspectiva > 0 ? \"+\" : \"\"}${perspectiva.toFixed(2)}%. O Custo Real de Desistência (EV_Fold) é de ${adjustedEvFold.toFixed(2)}%.`,\r\n      }));\r\n    }\r\n\r\n    return generated;\r\n  }, [\r\n    simulatorState,\r\n    metricsCtx?.apiQuantumMetrics,\r\n    metricsCtx?.predictiveProfile,\r\n  ]);\r\n\r\n  const handleRestart = () => {\r\n    setKeySeed((prev) => prev + 1);\r\n    lastQuestionTime.current = performance.now();\r\n  };\r\n\r\n  const handleAnswer = useCallback(\r\n    (\r\n      isCorrect: boolean,\r\n      evLoss: number,\r\n      category: string = \"Perspectiva Matemática\",\r\n    ) => {\r\n      const now = performance.now();\r\n      const currentLatency = now - lastQuestionTime.current;\r\n      lastQuestionTime.current = now; // Reseta para a próxima medição de tempo de reação\r\n\r\n      track(category, {\r\n        isCorrect,\r\n        evLoss,\r\n        latency: currentLatency, // O(1) Time-to-Act\r\n      });\r\n    },\r\n    [track],\r\n  );\r\n\r\n  if (!questions || questions.length === 0) return null;\r\n\r\n  return (\r\n    <div className=\"mt-16 border-t border-white/5 pt-12 relative\">\r\n      <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-10\">\r\n        <div>\r\n          <h2 className=\"text-text-bright text-[1.75rem] font-black mb-3 m-0\">\r\n            Desafio de Antevisão (Dinâmico)\r\n          </h2>\r\n          <p className=\"text-text-muted text-[1.05rem] leading-relaxed m-0 max-w-3xl\">\r\n            O sistema leu as variáveis da sua simulação atual. Baseado nessa\r\n            topologia de mesa, teste seu raciocínio SOTA:\r\n          </p>\r\n        </div>\r\n        {ghostMode ? (\r\n          <button\r\n            aria-pressed=\"true\"\r\n            onClick={() => setGhostMode(false)}\r\n            className=\"px-4 py-2.5 rounded-lg text-[0.65rem] font-black uppercase tracking-widest transition-all shrink-0 flex items-center gap-2 bg-accent-indigo text-white shadow-[0_0_15px_rgba(99,102,241,0.4)]\"\r\n          >\r\n            <i className=\"fa-solid fa-ghost\" aria-hidden=\"true\" /> Ocultar\r\n            Solver\r\n          </button>\r\n        ) : (\r\n          <button\r\n            aria-pressed=\"false\"\r\n            onClick={() => setGhostMode(true)}\r\n            className=\"px-4 py-2.5 rounded-lg text-[0.65rem] font-black uppercase tracking-widest transition-all shrink-0 flex items-center gap-2 bg-black/40 text-text-muted border border-white/10 hover:text-white hover:bg-white/5\"\r\n          >\r\n            <i className=\"fa-solid fa-ghost\" aria-hidden=\"true\" /> Ghost Solver\r\n          </button>\r\n        )}\r\n      </div>\r\n\r\n      {ghostMode && wasmCtx?.nashResults?.flop && (\r\n        <div className=\"absolute inset-0 z-50 bg-bg-base/80 backdrop-blur-sm rounded-2xl flex items-center justify-center p-6 border border-accent-indigo/30 animate-sota-in\">\r\n          <div className=\"bg-bg-deep p-8 rounded-xl border border-accent-indigo/20 max-w-2xl w-full text-center shadow-2xl\">\r\n            <i className=\"fa-solid fa-eye text-4xl text-accent-indigo mb-4 animate-pulse\" />\r\n            <h4 className=\"text-xl font-black text-white uppercase tracking-widest mb-6\">\r\n              Ghost Solver Ativo\r\n            </h4>\r\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6\">\r\n              <div className=\"bg-white/5 p-4 rounded-lg border border-white/5\">\r\n                <div className=\"text-[0.65rem] text-text-muted uppercase mb-2 font-bold tracking-widest\">\r\n                  Agressão Média (IP)\r\n                </div>\r\n                <div className=\"text-accent-indigo font-mono font-black text-2xl\">\r\n                  {(\r\n                    (wasmCtx.nashResults.flop.ip.bet_small.center +\r\n                      wasmCtx.nashResults.flop.ip.bet_large.center) /\r\n                    2\r\n                  ).toFixed(1)}\r\n                  %\r\n                </div>\r\n              </div>\r\n              <div className=\"bg-white/5 p-4 rounded-lg border border-white/5\">\r\n                <div className=\"text-[0.65rem] text-text-muted uppercase mb-2 font-bold tracking-widest\">\r\n                  Defesa (OOP Call)\r\n                </div>\r\n                <div className=\"text-accent-emerald font-mono font-black text-2xl\">\r\n                  {wasmCtx.nashResults.flop.oop.call.center.toFixed(1)}%\r\n                </div>\r\n              </div>\r\n              <div className=\"bg-white/5 p-4 rounded-lg border border-white/5\">\r\n                <div className=\"text-[0.65rem] text-text-muted uppercase mb-2 font-bold tracking-widest\">\r\n                  Fold Estrutural\r\n                </div>\r\n                <div className=\"text-accent-danger font-mono font-black text-2xl\">\r\n                  {wasmCtx.nashResults.flop.oop.fold.center.toFixed(1)}%\r\n                </div>\r\n              </div>\r\n            </div>\r\n            <p className=\"text-[0.8rem] text-text-dim leading-relaxed mb-8\">\r\n              A lente térmica GTO revela a estrutura profunda deste Spot. A\r\n              agressão ou passividade é extraída da Matriz de Nash subjacente\r\n              (Flop). Use essa intuição antes de responder.\r\n            </p>\r\n            <button\r\n              onClick={() => setGhostMode(false)}\r\n              className=\"px-6 py-2.5 bg-accent-indigo/20 text-accent-indigo-light border border-accent-indigo/40 rounded-lg text-xs font-black uppercase tracking-widest hover:bg-accent-indigo/30 transition-colors\"\r\n            >\r\n              Retornar ao Desafio\r\n            </button>\r\n          </div>\r\n        </div>\r\n      )}\r\n\r\n      {/* Injeta a keySeed para forçar a remontagem reativa do estado O(1) quando necessário */}\r\n      <QuizEngine\r\n        key={`quiz-widget-${keySeed}`}\r\n        questions={questions}\r\n        onQuizRestart={handleRestart}\r\n        onAnswer={handleAnswer}\r\n      />\r\n    </div>\r\n  );\r\n};\r\n"]],"v":2,"metadata":{"source":"unknown","name":"pushEditOperation"}}
{"kind":"changed","id":356,"time":1778708941109,"edit":[[0,444,"import { QuizEngine } from \"@/components/quiz/QuizEngine\";\r\nimport {\r\n    generateDynamicICMQuiz,\r\n    type SimulatorState,\r\n} from \"@/components/quiz/icmQuizGenerator\";\r\nimport {\r\n    SotaMetricsContext,\r\n    SotaWasmContext,\r\n} from \"@/components/simulator/SotaContext\";\r\nimport { useSotaTelemetry } from \"@/components/simulator/hooks/useSotaTelemetry\";\r\nimport React, { useCallback, useContext, useEffect, useMemo, useRef, useState } from \"react\";\r\n"]],"v":3,"metadata":{"source":"codeAction","$kind":"source.organizeImports","$extensionId":"TypeScriptTeam.native-preview"}}

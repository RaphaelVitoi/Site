": true,\r\n        \"**/.svn\": true,\r\n        \"**/.hg\": true,\r\n        \"**/CVS\": true,\r\n        \"**/.DS_Store\": true,\r\n        \"**/Thumbs.db\": true,\r\n        \"**/__pycache__\": true,\r\n        \"**/node_modules\": true,\r\n        \"**/.next\": true,\r\n        \"**/.claude\": true,\r\n        \"**/.clauderules\": true\r\n    },\r\n    \"search.exclude\": {\r\n        \"**/node_modules\": true,\r\n        \"**/bower_components\": true,\r\n        \"**/*.code-search\": true,\r\n        \"**/package-lock.json\": true,\r\n        \"**/.next\": true,\r\n        \"**/.claude\": true,\r\n        \"**/.clauderules\": true\r\n    }\r\n}\r\n","v":1}

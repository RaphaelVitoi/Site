{"kind":"setContent","time":1778727642713,"id":506,"content":"images:\n  - us-central1-docker.pkg.dev/$PROJECT_ID/nexus-repo/frontend:$COMMIT_SHA\nsteps:\n  # 1. Build da Imagem Docker SOTA\n  - args:\n      - build\n      - '-t'\n      - us-central1-docker.pkg.dev/$PROJECT_ID/nexus-repo/frontend:$COMMIT_SHA\n      - '-t'\n      - us-central1-docker.pkg.dev/$PROJECT_ID/nexus-repo/frontend:latest\n      - '-f'\n      - frontend/Dockerfile\n      - ./frontend\n    name: gcr.io/cloud-builders/docker\n\n  # 2. Push para o Artifact Registry\n  - args:\n      - push\n      - us-central1-docker.pkg.dev/$PROJECT_ID/nexus-repo/frontend\n      - '--all-tags'\n    name: gcr.io/cloud-builders/docker\n\n  # 3. Deploy Serverless no Cloud Run (Auto-Scaling de 0 a N)\n  - args:\n      - run\n      - deploy\n      - nexus-frontend\n      - '--image'\n      - us-central1-docker.pkg.dev/$PROJECT_ID/nexus-repo/frontend:$COMMIT_SHA\n      - '--region'\n      - us-central1\n      - '--allow-unauthenticated'\n      - '--port'\n      - '3000'\n    entrypoint: gcloud\n    name: gcr.io/google.com/cloudsdktool/cloud-sdk","v":1}

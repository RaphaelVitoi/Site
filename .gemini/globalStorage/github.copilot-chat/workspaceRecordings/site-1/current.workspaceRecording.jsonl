{"kind":"changed","id":351,"time":1778714412669,"edit":[[0,5374,"\"use client\";\n\n/**\n * IDENTITY: Quiz Engine SOTA v4.2 Gold\n * PATH: src/components/quiz/QuizEngine.tsx\n * ROLE: Orquestrador de avaliação cognitiva.\n * AESTHETIC: SOTA Gold Standard (Symmetry, Depth, Motion).\n */\n\nimport { AnimatePresence, motion } from \"framer-motion\";\nimport React, { useMemo, useState } from \"react\";\nimport { QuizProgress } from \"./QuizProgress\";\nimport { QuizQuestion } from \"./QuizQuestion\";\nimport { QuizResults } from \"./QuizResults\";\nimport type { QuizQuestion as QuizQuestionType } from \"./types\";\n\ninterface QuizEngineProps {\n  questions: QuizQuestionType[];\n  onQuizRestart?: () => void;\n  onAnswer?: (\n    isCorrect: boolean,\n    evLoss: number,\n    category?: string,\n    actionData?: { userAction: string; optimalAction: string; metadata: Record<string, any> }\n  ) => void;\n}\n\nconst EMPTY_QUESTIONS: QuizQuestionType[] = [];\n\nexport const QuizEngine: React.FC<QuizEngineProps> = ({\n  questions,\n  onQuizRestart,\n  onAnswer,\n}) => {\n  const safeQuestions = useMemo(\n    () => (Array.isArray(questions) ? questions : EMPTY_QUESTIONS),\n    [questions],\n  );\n  const [currentIndex, setCurrentIndex] = useState(0);\n  const [answers, setAnswers] = useState<Record<string, string>>({});\n\n  const isFinished = currentIndex >= safeQuestions.length;\n\n  const score = useMemo(() => {\n    return safeQuestions.reduce((acc, q) => {\n      return acc + (answers[q.id] === q.correctOptionId ? 1 : 0);\n    }, 0);\n  }, [answers, safeQuestions]);\n\n  const handleSelectOption = (optionId: string) => {\n    const currentQ = safeQuestions[currentIndex];\n    if (!currentQ) return;\n    setAnswers((prev) => ({ ...prev, [currentQ.id]: optionId }));\n\n    const isCorrect = optionId === currentQ.correctOptionId;\n    const evLoss = isCorrect ? 0 : 0.5;\n    if (onAnswer) {\n      onAnswer(isCorrect, evLoss, currentQ.category, {\n        userAction: optionId,\n        optimalAction: currentQ.correctOptionId,\n        metadata: { questionId: currentQ.id, questionText: currentQ.text },\n      });\n    }\n  };\n\n  const handleNext = () => setCurrentIndex((prev) => prev + 1);\n  const handleRestart = () => {\n    setAnswers({});\n    setCurrentIndex(0);\n    if (onQuizRestart) onQuizRestart();\n  };\n\n  if (safeQuestions.length === 0) return null;\n\n  return (\n    <div className=\"max-w-4xl mx-auto flex flex-col gap-12\">\n      <AnimatePresence mode=\"wait\">\n        {isFinished ? (\n          <motion.div\n            key=\"results\"\n            initial={{ opacity: 0, scale: 0.95 }}\n            animate={{ opacity: 1, scale: 1 }}\n            exit={{ opacity: 0, scale: 1.05 }}\n            {...({\n              className:\n                \"glass-panel rounded-[3rem] bg-bg-panel/60 border border-white/10 shadow-2xl overflow-hidden relative\",\n            } as any)}\n          >\n            <div className=\"absolute inset-0 bg-radial-[at_top_right] from-accent-indigo/10 to-transparent pointer-events-none\" />\n            <QuizResults\n              score={score}\n              total={safeQuestions.length}\n              onRestart={handleRestart}\n            />\n          </motion.div>\n        ) : (\n          <motion.div\n            key=\"quiz\"\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            {...({ className: \"flex flex-col gap-10\" } as any)}\n          >\n            <QuizProgress\n              current={currentIndex}\n              total={safeQuestions.length}\n              score={score}\n            />\n\n            <div className=\"glass-panel rounded-4xl bg-bg-panel/60 border border-white/5 shadow-2xl overflow-hidden relative group/engine\">\n              <div className=\"absolute inset-0 bg-radial-[at_top_left] from-accent-indigo/5 to-transparent pointer-events-none\" />\n\n              <QuizQuestion\n                question={safeQuestions[currentIndex]}\n                selectedOptionId={\n                  safeQuestions[currentIndex]\n                    ? answers[safeQuestions[currentIndex].id] || \"\"\n                    : \"\"\n                }\n                onSelectOption={handleSelectOption}\n              />\n\n              <div className=\"px-10 pb-10 pt-0 flex justify-end min-h-24\">\n                {safeQuestions[currentIndex] &&\n                  answers[safeQuestions[currentIndex].id] && (\n                    <motion.button\n                      initial={{ opacity: 0, x: 20 }}\n                      animate={{ opacity: 1, x: 0 }}\n                      {...({\n                        onClick: handleNext,\n                        className:\n                          \"px-8 py-4 bg-accent-indigo text-white border border-accent-indigo-light/20 rounded-2xl cursor-pointer font-black transition-all uppercase tracking-widest text-[0.7rem] flex items-center gap-4 hover:shadow-[0_0_30px_rgba(99,102,241,0.4)] active:scale-95\",\n                      } as any)}\n                    >\n                      {currentIndex === safeQuestions.length - 1\n                        ? \"Analisar Perfil\"\n                        : \"Sincronizar\"}\n                      <i className=\"fa-solid fa-arrow-right-long\" />\n                    </motion.button>\n                  )}\n              </div>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n};\n"]],"v":2,"metadata":{"source":"unknown","name":"MainThreadTextEditor"}}
{"kind":"setContent","time":1778714412669,"id":356,"content":"import { QuizEngine } from \"@/components/quiz/QuizEngine\";\nimport {\n  generateDynamicICMQuiz,\n  type SimulatorState,\n} from \"@/components/quiz/icmQuizGenerator\";\nimport type { TelemetryCategory } from \"@/components/quiz/types\";\nimport {\n  SotaMetricsContext,\n  SotaWasmContext,\n} from \"@/components/simulator/SotaContext\";\nimport { useSotaTelemetry } from \"@/components/simulator/hooks/useSotaTelemetry\";\nimport React, {\n  useCallback,\n  useContext,\n  useEffect,\n  useMemo,\n  useRef,\n  useState,\n} from \"react\";\n\ninterface SimulatorQuizWidgetProps {\n  simulatorState: SimulatorState;\n}\n\nexport const SimulatorQuizWidget: React.FC<SimulatorQuizWidgetProps> = ({\n  simulatorState,\n}) => {\n  const [keySeed, setKeySeed] = useState(0);\n  const [ghostMode, setGhostMode] = useState(false);\n\n  const metricsCtx = useContext(SotaMetricsContext);\n  const wasmCtx = useContext(SotaWasmContext);\n  const { track } = useSotaTelemetry(\"SimulatorQuizWidget\");\n  const lastQuestionTime = useRef<number>(0);\n\n  // SOTA: Cronômetro de tempo de reação iniciado na montagem\n  useEffect(() => {\n    lastQuestionTime.current = performance.now();\n  }, []);\n\n  // Memoiza as questões para impedir re-renderizações desnecessárias durante a digitação\n  const questions = useMemo(() => {\n    const generated = generateDynamicICMQuiz({\n      ...simulatorState,\n      predictiveProfile: metricsCtx?.predictiveProfile ?? {},\n    });\n\n    if (metricsCtx?.apiQuantumMetrics) {\n      const { perspectiva, adjustedEvFold } = metricsCtx.apiQuantumMetrics;\n      return generated.map((q) => ({\n        ...q,\n        explanation: `${q.explanation}\\n\\n[SOTA Telemetry]: Perspectiva Matemática (PM): ${perspectiva > 0 ? \"+\" : \"\"}${perspectiva.toFixed(2)}%. O Custo Real de Desistência (EV_Fold) é de ${adjustedEvFold.toFixed(2)}%.`,\n      }));\n    }\n\n    return generated;\n  }, [\n    simulatorState,\n    metricsCtx?.apiQuantumMetrics,\n    metricsCtx?.predictiveProfile,\n  ]);\n\n  const handleRestart = () => {\n    setKeySeed((prev) => prev + 1);\n    lastQuestionTime.current = performance.now();\n  };\n\n  const handleAnswer = useCallback(\n    (\n      isCorrect: boolean,\n      evLoss: number,\n      category: TelemetryCategory = \"simulator\",\n    ) => {\n      const now = performance.now();\n      const currentLatency = now - lastQuestionTime.current;\n      lastQuestionTime.current = now; // Reseta para a próxima medição de tempo de reação\n\n      track(category, {\n        isCorrect,\n        evLoss,\n        latency: currentLatency, // O(1) Time-to-Act\n      });\n    },\n    [track],\n  );\n\n  if (!questions || questions.length === 0) return null;\n\n  return (\n    <div className=\"mt-16 border-t border-white/5 pt-12 relative\">\n      <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-6 mb-10\">\n        <div>\n          <h2 className=\"text-text-bright text-[1.75rem] font-black mb-3 m-0\">\n            Desafio de Antevisão (Dinâmico)\n          </h2>\n          <p className=\"text-text-muted text-[1.05rem] leading-relaxed m-0 max-w-3xl\">\n            O sistema leu as variáveis da sua simulação atual. Baseado nessa\n            topologia de mesa, teste seu raciocínio SOTA:\n          </p>\n        </div>\n        {ghostMode ? (\n          <button\n            aria-pressed=\"true\"\n            onClick={() => setGhostMode(false)}\n            className=\"px-4 py-2.5 rounded-lg text-[0.65rem] font-black uppercase tracking-widest transition-all shrink-0 flex items-center gap-2 bg-accent-indigo text-white shadow-[0_0_15px_rgba(99,102,241,0.4)]\"\n          >\n            <i className=\"fa-solid fa-ghost\" aria-hidden=\"true\" /> Ocultar\n            Solver\n          </button>\n        ) : (\n          <button\n            aria-pressed=\"false\"\n            onClick={() => setGhostMode(true)}\n            className=\"px-4 py-2.5 rounded-lg text-[0.65rem] font-black uppercase tracking-widest transition-all shrink-0 flex items-center gap-2 bg-black/40 text-text-muted border border-white/10 hover:text-white hover:bg-white/5\"\n          >\n            <i className=\"fa-solid fa-ghost\" aria-hidden=\"true\" /> Ghost Solver\n          </button>\n        )}\n      </div>\n\n      {ghostMode && wasmCtx?.nashResults?.flop && (\n        <div className=\"absolute inset-0 z-50 bg-bg-base/80 backdrop-blur-sm rounded-2xl flex items-center justify-center p-6 border border-accent-indigo/30 animate-sota-in\">\n          <div className=\"bg-bg-deep p-8 rounded-xl border border-accent-indigo/20 max-w-2xl w-full text-center shadow-2xl\">\n            <i className=\"fa-solid fa-eye text-4xl text-accent-indigo mb-4 animate-pulse\" />\n            <h4 className=\"text-xl font-black text-white uppercase tracking-widest mb-6\">\n              Ghost Solver Ativo\n            </h4>\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6\">\n              <div className=\"bg-white/5 p-4 rounded-lg border border-white/5\">\n                <div className=\"text-[0.65rem] text-text-muted uppercase mb-2 font-bold tracking-widest\">\n                  Agressão Média (IP)\n                </div>\n                <div className=\"text-accent-indigo font-mono font-black text-2xl\">\n                  {(\n                    (wasmCtx.nashResults.flop.ip.bet_small.center +\n                      wasmCtx.nashResults.flop.ip.bet_large.center) /\n                    2\n                  ).toFixed(1)}\n                  %\n                </div>\n              </div>\n              <div className=\"bg-white/5 p-4 rounded-lg border border-white/5\">\n                <div className=\"text-[0.65rem] text-text-muted uppercase mb-2 font-bold tracking-widest\">\n                  Defesa (OOP Call)\n                </div>\n                <div className=\"text-accent-emerald font-mono font-black text-2xl\">\n                  {wasmCtx.nashResults.flop.oop.call.center.toFixed(1)}%\n                </div>\n              </div>\n              <div className=\"bg-white/5 p-4 rounded-lg border border-white/5\">\n                <div className=\"text-[0.65rem] text-text-muted uppercase mb-2 font-bold tracking-widest\">\n                  Fold Estrutural\n                </div>\n                <div className=\"text-accent-danger font-mono font-black text-2xl\">\n                  {wasmCtx.nashResults.flop.oop.fold.center.toFixed(1)}%\n                </div>\n              </div>\n            </div>\n            <p className=\"text-[0.8rem] text-text-dim leading-relaxed mb-8\">\n              A lente térmica GTO revela a estrutura profunda deste Spot. A\n              agressão ou passividade é extraída da Matriz de Nash subjacente\n              (Flop). Use essa intuição antes de responder.\n            </p>\n            <button\n              onClick={() => setGhostMode(false)}\n              className=\"px-6 py-2.5 bg-accent-indigo/20 text-accent-indigo-light border border-accent-indigo/40 rounded-lg text-xs font-black uppercase tracking-widest hover:bg-accent-indigo/30 transition-colors\"\n            >\n              Retornar ao Desafio\n            </button>\n          </div>\n        </div>\n      )}\n\n      {/* Injeta a keySeed para forçar a remontagem reativa do estado O(1) quando necessário */}\n      <QuizEngine\n        key={`quiz-widget-${keySeed}`}\n        questions={questions}\n        onQuizRestart={handleRestart}\n        onAnswer={handleAnswer}\n      />\n    </div>\n  );\n};\n","v":1}

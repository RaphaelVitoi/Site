{"kind":"setContent","time":1778694287163,"id":115,"content":"rules:\r\n  - id: sota-fastapi-auth-enforcement\r\n    languages:\r\n      - python\r\n    message: \"[SOTA SECURITY] Rota FastAPI exposta sem blindagem. Todas as rotas devem validar autenticação injetando 'Depends()' nos argumentos ou no decorador.\"\r\n    patterns:\r\n      # Captura qualquer declaração de rota FastAPI\r\n      - pattern: |\r\n          @app.$METHOD(...)\r\n          async def $FUNC(...):\r\n            ...\r\n      # Filtro 1: Permite se a dependência estiver no decorador\r\n      - pattern-not: |\r\n          @app.$METHOD(..., dependencies=[...], ...)\r\n          async def $FUNC(...):\r\n            ...\r\n      # Filtro 2: Permite se houver injeção de Depends nos parâmetros\r\n      - pattern-not: |\r\n          @app.$METHOD(...)\r\n          async def $FUNC(..., $VAR = Depends(...), ...):\r\n            ...\r\n      # Filtro 3: Ignora a rota raiz (Health Check público)\r\n      - pattern-not: |\r\n          @app.get(\"/\")\r\n          async def root_health_check(...):\r\n            ...\r\n    severity: ERROR\r\n","v":1}

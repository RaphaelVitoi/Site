{"kind":"setContent","time":1778697908294,"id":438,"content":"/* style-overrides.css - Geometria do Risco (Refinamento UI/UX) */\r\n\r\n/* 1. Responsividade Fluida (Mobile-First) */\r\n@media (max-width: 768px) {\r\n    .glass-panel {\r\n        padding: 1.5rem !important;\r\n        border-radius: 16px;\r\n    }\r\n\r\n    #stage-title {\r\n        font-size: 1.75rem;\r\n    }\r\n\r\n    .grid-cols-2 {\r\n        gap: 1rem !important;\r\n    }\r\n}\r\n\r\n/* 2. Feedback Tátil Avançado (Botões) */\r\n.btn-interactive {\r\n    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);\r\n    cursor: pointer;\r\n}\r\n\r\n.btn-interactive:active {\r\n    transform: scale(0.95);\r\n}\r\n\r\n.btn-interactive:hover {\r\n    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n/* 3. Simetria do Scrollbar (Scenario List) */\r\n@supports (scrollbar-width: thin) {\r\n    scenario-list {\r\n        scrollbar-width: thin;\r\n        scrollbar-color: rgba(99, 102, 241, 0.5) transparent;\r\n    }\r\n}\r\n\r\nscenario-list::-webkit-scrollbar {\r\n    width: 4px;\r\n}\r\n\r\nscenario-list::-webkit-scrollbar-track {\r\n    background: transparent;\r\n}\r\n\r\nscenario-list::-webkit-scrollbar-thumb {\r\n    background-color: rgba(99, 102, 241, 0.3);\r\n    border-radius: 10px;\r\n}\r\n\r\nscenario-list:hover::-webkit-scrollbar-thumb {\r\n    background-color: rgba(99, 102, 241, 0.7);\r\n}\r\n\r\n/* 4. Fix de Quebra de Linha em Telas Intermediárias */\r\n.ev-diff-panel {\r\n    flex-wrap: wrap;\r\n}\r\n","v":1}

{"kind":"setContent","time":1778697759008,"id":424,"content":"generator client {\r\n  provider = \"prisma-client-js\"\r\n}\r\n\r\ndatasource db {\r\n  provider = \"sqlite\"\r\n}\r\n\r\nmodel IcmScenario {\r\n  id                 String    @id @default(cuid())\r\n  slug               String    @unique\r\n  name               String\r\n  category           String\r\n  narrativeTitle     String?\r\n  narrativeSubtitle  String?\r\n  theory             String?\r\n  exploit            String?\r\n  verdict            String?\r\n  stacks             String\r\n  prizes             String\r\n  ipPos              String\r\n  oopPos             String\r\n  ipRp               Float\r\n  oopRp              Float\r\n  ipMorph            String?\r\n  oopMorph           String?\r\n  sprData            String?\r\n  defaultStreetFreqs String?\r\n  isPublished        Boolean   @default(false)\r\n  quizzes            IcmQuiz[]\r\n  createdAt          DateTime  @default(now())\r\n  updatedAt          DateTime  @updatedAt\r\n\r\n  @@index([category])\r\n  @@index([isPublished])\r\n}\r\n\r\nmodel IcmQuiz {\r\n  id          String      @id @default(cuid())\r\n  scenarioId  String\r\n  scenario    IcmScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)\r\n  question    String\r\n  explanation String?\r\n  options     String\r\n  createdAt   DateTime    @default(now())\r\n}\r\n\r\nmodel Lesson {\r\n  id            String   @id @default(cuid())\r\n  slug          String   @unique\r\n  title         String\r\n  markdown_body String\r\n  type          String?\r\n  tags          String?\r\n  createdAt     DateTime @default(now())\r\n  updatedAt     DateTime @updatedAt\r\n\r\n  @@index([type])\r\n}\r\n\r\nmodel Content {\r\n  id          String   @id @default(cuid())\r\n  slug        String   @unique\r\n  category    String\r\n  title       String\r\n  description String?\r\n  body        String\r\n  isPublished Boolean  @default(false)\r\n  createdAt   DateTime @default(now())\r\n  updatedAt   DateTime @updatedAt\r\n\r\n  @@index([category])\r\n  @@index([isPublished])\r\n}\r\n\r\nmodel TelemetryEvent {\r\n  id              String   @id @default(cuid())\r\n  userId          String?\r\n  category        String\r\n  scenarioContext String?\r\n  userAction      String?\r\n  optimalAction   String?\r\n  evLoss          Float    @default(0)\r\n  isCorrect       Boolean  @default(true)\r\n  latency         Float    @default(0)\r\n  componentName   String\r\n  metadata        String?\r\n  createdAt       DateTime @default(now())\r\n\r\n  @@index([category])\r\n  @@index([userId])\r\n}\r\n\r\nmodel VitoiPerspectiveMetric {\r\n  id                        String   @id @default(cuid())\r\n  scenarioId                String?\r\n  chipEvFold                Float\r\n  icmValuation              Float\r\n  timeToBlindJumpMinutes    Float\r\n  payjumpProximityFactor    Float\r\n  positionalUrgency         Float\r\n  multiwayOpponents         Float\r\n  reverseImpliedOddsPenalty Float\r\n  stackDepthBb              Float\r\n  humanNoiseFactor          Float\r\n  technicalSuperiority      Float\r\n  potOddsRatio              Float\r\n  perspectiveUtility        Float\r\n  insolvencyCoefficient     Float?\r\n  isViable                  Boolean\r\n  createdAt                 DateTime @default(now())\r\n\r\n  @@index([scenarioId])\r\n}\r\n","v":1}

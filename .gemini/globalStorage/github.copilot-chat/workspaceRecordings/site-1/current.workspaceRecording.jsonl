.57.1\",\r\n\t\t\"eslint-config-next\": \"^15.0.0\",\r\n\t\t\"husky\": \"^8.0.3\",\r\n\t\t\"jest\": \"^30.3.0\",\r\n\t\t\"jest-environment-jsdom\": \"^30.3.0\",\r\n\t\t\"lint-staged\": \"^16.4.0\",\r\n\t\t\"postcss\": \"^8.5.12\",\r\n\t\t\"prisma\": \"^5.22.0\",\r\n\t\t\"tailwindcss\": \"^4.2.2\",\r\n\t\t\"ts-jest\": \"^29.4.6\",\r\n\t\t\"ts-node\": \"^10.9.2\",\r\n\t\t\"turbo\": \"^2.9.1\",\r\n\t\t\"typescript\": \"^5.9.3\"\r\n\t}\r\n}\r\n","v":1}

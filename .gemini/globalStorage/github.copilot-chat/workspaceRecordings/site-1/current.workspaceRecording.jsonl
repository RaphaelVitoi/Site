{"kind":"setContent","time":1778598159319,"id":225,"content":"import { PrismaClient } from '@prisma/client';\r\n\r\nconst prisma = new PrismaClient();\r\nconst RETENTION_DAYS = 15;\r\n\r\nasync function main() {\r\n    console.log( `[SOTA-CLEANUP] Iniciando expurgo de telemetria com mais de ${RETENTION_DAYS} dias...` );\r\n\r\n    const dateThreshold = new Date();\r\n    dateThreshold.setDate( dateThreshold.getDate() - RETENTION_DAYS );\r\n\r\n    const result = await prisma.telemetryEvent.deleteMany( {\r\n        where: {\r\n            createdAt: {\r\n                lt: dateThreshold,\r\n            },\r\n        },\r\n    } );\r\n\r\n    console.log( `[VITORIA] Expurgo concluído. ${result.count} registros de telemetria antigos foram aniquilados.` );\r\n}\r\n\r\nmain()\r\n    .catch( ( e ) => {\r\n        console.error( '[ENTROPIA CRITICA] Falha no script de limpeza de telemetria:', e );\r\n        process.exit( 1 );\r\n    } )\r\n    .finally( async () => {\r\n        await prisma.$disconnect();\r\n    } );\r\n","v":1}

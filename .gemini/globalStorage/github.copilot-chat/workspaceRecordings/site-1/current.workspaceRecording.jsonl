{"kind":"setContent","time":1778697584804,"id":381,"content":"import { NextResponse } from \"next/server\";\r\n\r\nexport async function POST(_req: Request) {\r\n  // SOTA: Rota desativada em favor do Proxy Python unificado (porta 17043).\r\n  // Esta rota é mantida apenas para evitar que builds antigos quebrem com 404.\r\n  return NextResponse.json(\r\n    {\r\n      error:\r\n        \"Endpoint desativado. Utilize o Proxy SOTA em http://127.0.0.1:17043/generate\",\r\n    },\r\n    { status: 410 }, // 410 Gone\r\n  );\r\n}\r\n","v":1}

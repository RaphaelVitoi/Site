{"kind":"changed","id":47,"time":1778656314883,"edit":[[0,7188,"\"use client\";\r\n\r\nimport { ResponsiveContainer, AreaChart, Area, XAxis, YAxis, CartesianGrid, Tooltip } from \"recharts\";\r\n\r\nconst mockData = [\r\n  { street: \"Pre-Flop\", pm: 85, threshold: 30 },\r\n  { street: \"Flop\", pm: 65, threshold: 45 },\r\n  { street: \"Turn\", pm: 40, threshold: 55 },\r\n  { street: \"River\", pm: 15, threshold: 75 }, // Insolvência! (pm < threshold)\r\n];\r\n\r\nexport function InsolvencyMatrix() {\r\n  return (\r\n    <div className=\"w-full h-64\">\r\n      <ResponsiveContainer width=\"100%\" height=\"100%\">\r\n        <AreaChart data={mockData} margin={{ top: 10, right: 0, left: -20, bottom: 0 }}>\r\n          <defs>\r\n            <linearGradient id=\"pmGradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\r\n              <stop offset=\"5%\" stopColor=\"#10b981\" stopOpacity={0.5} />\r\n              <stop offset=\"95%\" stopColor=\"#10b981\" stopOpacity={0} />\r\n            </linearGradient>\r\n            <linearGradient id=\"threshGradient\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\r\n              <stop offset=\"5%\" stopColor=\"#ef4444\" stopOpacity={0.3} />\r\n              <stop offset=\"95%\" stopColor=\"#ef4444\" stopOpacity={0} />\r\n            </linearGradient>\r\n          </defs>\r\n          <CartesianGrid strokeDasharray=\"3 3\" stroke=\"rgba(255,255,255,0.05)\" vertical={false} />\r\n          <XAxis dataKey=\"street\" stroke=\"#475569\" tick={{ fill: \"#94a3b8\", fontSize: 10, fontWeight: 800, fontFamily: \"var(--font-mono)\" }} axisLine={false} tickLine={false} />\r\n          <YAxis stroke=\"#475569\" tick={{ fill: \"#94a3b8\", fontSize: 10, fontWeight: 800, fontFamily: \"var(--font-mono)\" }} axisLine={false} tickLine={false} />\r\n          <Tooltip\r\n            contentStyle={{ backgroundColor: \"#020617\", borderColor: \"rgba(16,185,129,0.3)\", borderRadius: \"12px\", boxShadow: \"0 10px 30px rgba(0,0,0,0.5)\" }}\r\n            itemStyle={{ f
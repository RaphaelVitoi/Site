{"kind":"changed","id":293,"time":1778651646856,"edit":[[0,1404,"[project]\r\nname = \"nexus-orchestrator\"\r\nversion = \"0.1.0\"\r\ndescription = \"Micro-servidor SOTA e Orquestrador de Agentes\"\r\ndependencies = [\r\n    \"aiohttp>=3.13.5\",\r\n    \"aiosqlite>=0.19.0\",\r\n    \"fastapi>=0.111.1\",\r\n    \"pydantic>=2.12.5\",\r\n    \"numpy>=2.4.4\",\r\n    \"pandas>=3.0.2\",\r\n    \"scikit-learn>=1.8.0\",\r\n    \"chromadb>=0.4.0\",\r\n    \"openai>=1.37.0\",\r\n    \"anthropic>=0.17.0\",\r\n    \"rich>=13.7.0\"\r\n]\r\n\r\n[tool.pytest.ini_options]\r\nminversion = \"8.0\"\r\naddopts = \"-ra -q --strict-markers\"\r\nasyncio_mode = \"auto\"\r\nasyncio_default_fixture_loop_scope = \"function\"\r\nlog_cli = true\r\nlog_cli_level = \"INFO\"\r\npythonpath = [\".\"]\r\ntestpaths = [\r\n    \"tests\",\r\n]\r\npython_files = [\"test_*.py\"]\r\n\r\n[tool.coverage.run]\r\nbranch = true\r\nsource = [\"core\", \"database\", \"engine\", \"utils\", \"api\", \"agents\", \"llm\", \"worker\", \"task_executor\"]\r\n\r\n[tool.ruff.lint]\r\nselect = [\r\n    \"E\", \"F\",     # Erros e falhas padrao\r\n    \"S\",          # flake8-bandit (Auditoria de Seguranca: senhas hardcoded, injecao SQL/Shell)\r\n    \"B\",          # flake8-bugbear (Falhas de design que levam a vazamento de memoria)\r\n    \"FAST\",       # FastAPI-specific rules (Detecta dependencias mal injetadas, rotas sem async)\r\n]\r\nignore = [\r\n    \"E501\",       # Ignorado (Friccao Zero): Prompts de LLM perdem integridade visual se quebrados forcadamente\r\n]\r\n\r\n[tool.ruff.lint.per-file-ignores]\r\n\"tests/*.py\" = [\"S101\"]\r\n\"tests/**/*.py\" = [\"S101\"]\r\n\r\n[tool.pyright]\r\ninclude = [\".\"]\r\nexclude = [\".venv\", \"__pycache__\", \"node_modules\", \".next\"]\r\nreportMissingImports = true\r\nreportMissingTypeStubs = false\r\nreportAttributeAccessIssue = \"warning\"\r\n"]],"v":2,"metadata":{"source":"unknown","name":"pushEditOperation"}}
{"kind":"changed","id":315,"time":1778651649064,"edit":[[0,933,"# ==============================================================================\r\n# PROTOCOLO VITOI 3.2 - BLINDAGEM DE REPOSITÓRIO E ENTROPIA ZERO\r\n# ==============================================================================\r\n\r\n# 1. INFRAESTRUTURA E RUNTIME (Densidade Zero)\r\nnode_modules/\r\n.venv/\r\n__pycache__/\r\ncoverage/\r\n\r\n# 2. BUILD E COMPILAÇÃO (Next.js / Turbopack)\r\n.next/\r\n.turbo/\r\nfrontend/.next/\r\nfrontend/.turbo/\r\nfrontend/.next-build/\r\n\r\n# 3. BANCOS DE DADOS E VETORES (Opacidade)\r\n*.db\r\n*.db-journal\r\n*.sqlite\r\n.chroma_db/\r\n\r\n# 4. LOGS, BACKUPS E TELEMETRIA SOTA\r\nlogs/\r\n_backups/\r\n.backups/\r\n.backups_sota/\r\nNEXUS_SOTA_BACKUP_*/\r\narchive/\r\n.claude/logs/\r\n.claude/task_results/\r\n.claude/.archive/\r\n\r\n# 5. SEGREDOS E AMBIENTE (Prevenção de Vazamento)\r\n_env.ps1\r\nfrontend/.env.local\r\nprisma/.env\r\n\r\n# 6. SISTEMA E RUÍDO\r\n.DS_Store\r\nThumbs.db\r\n.continue/\r\n\r\n\r\n#Ignore vscode AI rules\r\n.github\\instructions\\codacy.instructions.md\r\n"]],"v":2,"metadata":{"source":"unknown","name":"pushEditOperation"}}

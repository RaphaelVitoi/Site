{"kind":"setContent","time":1778696094779,"id":231,"content":"{\r\n    \"jobs\": [\r\n        {\r\n            \"id\": \"db-cleanup-weekly\",\r\n            \"description\": \"Arquiva tarefas antigas (com mais de 30 dias) do banco de dados para manter a performance.\",\r\n            \"command\": \"python $ProjectRoot/task_executor.py db-cleanup 30\",\r\n            \"intervalHours\": 168,\r\n            \"active\": true\r\n        },\r\n        {\r\n            \"id\": \"rag-ingest-daily\",\r\n            \"description\": \"Sincroniza a memoria coletiva (RAG) com os documentos mais recentes do projeto.\",\r\n            \"command\": \"python $ProjectRoot/memory_rag.py ingest\",\r\n            \"intervalHours\": 24,\r\n            \"active\": true\r\n        },\r\n        {\r\n            \"id\": \"maverick-sentinel-daily\",\r\n            \"description\": \"Aciona a sentinela @maverick para uma varredura sistemica em busca de pontos cegos e riscos.\",\r\n            \"command\": \"powershell -File $ProjectRoot/scripts/maintenance/run_maverick_sentinel.ps1 -TaskId SENTINEL-CRON-$(Get-Date -Format 'yyyyMMdd')\",\r\n            \"intervalHours\": 24,\r\n            \"active\": true\r\n        },\r\n        {\r\n            \"id\": \"predictive-forest-training-daily\",\r\n            \"description\": \"Treina o motor SOTA de Random Forest com os dados recentes de telemetria do Quiz.\",\r\n            \"command\": \"python $ProjectRoot/task_executor.py train-predictive\",\r\n            \"intervalHours\": 24,\r\n            \"active\": true\r\n        }\r\n    ]\r\n}\r\n","v":1}

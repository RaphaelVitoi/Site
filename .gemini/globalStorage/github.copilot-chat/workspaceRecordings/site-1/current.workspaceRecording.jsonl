{"kind":"setContent","time":1778597968462,"id":142,"content":"@import \"tailwindcss\";\r\n\r\n@plugin \"@tailwindcss/typography\";\r\n\r\n@theme {\r\n    --color-bg-base: #0f172a;\r\n    --color-bg-deep: #020617;\r\n    --color-bg-elevated: #1e293b;\r\n    --color-text-main: #cbd5e1;\r\n    --color-text-bright: #f8fafc;\r\n    --color-text-muted: #94a3b8;\r\n    --color-text-dim: #64748b;\r\n    --color-text-darker: #334155;\r\n\r\n    --color-accent-indigo: #6366f1;\r\n    --color-accent-indigo-light: #818cf8;\r\n    --color-accent-emerald: #10b981;\r\n    --color-accent-emerald-light: #34d399;\r\n    --color-accent-rose: #f43f5e;\r\n    --color-accent-rose-light: #fb7185;\r\n    --color-accent-danger: #ef4444;\r\n    --color-accent-danger-light: #f87171;\r\n    --color-accent-amber: #f59e0b;\r\n    --color-accent-gold: #fbbf24;\r\n    --color-accent-violet: #8b5cf6;\r\n    --color-accent-sky: #0ea5e9;\r\n    --color-accent-pink: #ec4899;\r\n    --color-accent-fuchsia: #e879f9;\r\n    --color-accent-blue: #60a5fa;\r\n    --color-accent-cyan: #67e8f9;\r\n    --color-accent-orange: #fb923c;\r\n\r\n    --background-image-glass-gradient: linear-gradient(180deg, rgba(30, 41, 59, 0.35) 0%, rgba(15, 23, 42, 0.15) 100%);\r\n    --background-image-sota-pattern: radial-gradient(circle at 0% 0%, rgba(99, 102, 241, 0.05), transparent 40%), radial-gradient(circle at 100% 100%, rgba(14, 165, 233, 0.05), transparent 40%);\r\n\r\n    --shadow-sota-glass: 0 30px 60px -15px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.05);\r\n\r\n    --font-body: var(--font-inter), ui-sans-serif, system-ui, sans-serif;\r\n    --font-heading: var(--font-heading), ui-sans-serif, system-ui, sans-serif;\r\n    --font-mono: var(--font-mono), ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;\r\n}\r\n\r\n/* SOTA: Grain/Noise Texture (Alta Fidelidade Cinematográfica) */\r\n.sota-grain::before {\r\n    content: \"\";\r\n    position: fixed;\r\n    top: -150%;\r\n    left: -150%;\r\n    width: 300%;\r\n    height: 300%;\r\n    pointer-events: none;\r\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\r\n    opacity: 0.025;\r\n    z-index: 100;\r\n    animation: grain 8s steps(10) infinite;\r\n}\r\n\r\n@keyframes grain {\r\n\r\n    0%,\r\n    100% {\r\n        transform: translate(0, 0);\r\n    }\r\n\r\n    10% {\r\n        transform: translate(-5%, -10%);\r\n    }\r\n\r\n    20% {\r\n        transform: translate(-15%, 5%);\r\n    }\r\n\r\n    30% {\r\n        transform: translate(7%, -25%);\r\n    }\r\n\r\n    40% {\r\n        transform: translate(-5%, 25%);\r\n    }\r\n\r\n    50% {\r\n        transform: translate(-15%, 10%);\r\n    }\r\n\r\n    60% {\r\n        transform: translate(15%, 0%);\r\n    }\r\n\r\n    70% {\r\n        transform: translate(0%, 15%);\r\n    }\r\n\r\n    80% {\r\n        transform: translate(3%, 35%);\r\n    }\r\n\r\n    90% {\r\n        transform: translate(-10%, 10%);\r\n    }\r\n}\r\n\r\n@layer base {\r\n    :root {\r\n        /* Altura do Header fixa para sincronia de scroll */\r\n        --header-height: 80px;\r\n        --container-width: 1600px;\r\n    }\r\n\r\n    html,\r\n    body {\r\n        @apply scroll-smooth antialiased;\r\n        /* Firefox */\r\n        -ms-overflow-style: none;\r\n        /* IE/Edge */\r\n    }\r\n\r\n    html::-webkit-scrollbar,\r\n    body::-webkit-scrollbar {\r\n        display: none;\r\n        /* Chrome/Safari/Opera */\r\n    }\r\n\r\n    /* SOTA: As cores de fundo, texto e seleção estão injetadas nativamente como utilitárias\r\n       na tag <body> em layout.tsx. Isso evita deadlocks de compilação no Turbopack (Tailwind v4). */\r\n\r\n    h1,\r\n    h2,\r\n    h3,\r\n    h4 {\r\n        @apply font-black tracking-tighter;\r\n        font-family: var(--font-heading);\r\n        color: var(--color-text-bright, #f8fafc);\r\n    }\r\n\r\n    /* Otimização de Parágrafos para Leitura Densa */\r\n    p {\r\n        @apply leading-relaxed tracking-tight;\r\n    }\r\n\r\n    /* Reset global de inputs e selects para Fricção Zero */\r\n    select,\r\n    input,\r\n    button {\r\n        @apply outline-none transition duration-200;\r\n    }\r\n}\r\n\r\n@layer components {\r\n\r\n    /* O Vidro Perfeito (Abstração SOTA - Padrão Ouro) */\r\n    .glass-panel {\r\n        @apply backdrop-blur-2xl rounded-3xl relative transition duration-500 p-8;\r\n        background: linear-gradient(180deg, rgba(15, 23, 42, 0.6) 0%, rgba(2, 6, 23, 0.8) 100%);\r\n        border: 1px solid rgba(255, 255, 255, 0.08);\r\n        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.1), 0 25px 50px -12px rgba(0, 0, 0, 0.5);\r\n    }\r\n\r\n    /* Pílula Flutuante para Navegações */\r\n    .sota-glass-pill {\r\n        @apply backdrop-blur-xl rounded-full relative transition duration-300;\r\n        background: linear-gradient(180deg, rgba(30, 41, 59, 0.4) 0%, rgba(15, 23, 42, 0.6) 100%);\r\n        border: 1px solid rgba(255, 255, 255, 0.1);\r\n        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.15), 0 10px 30px -10px rgba(0, 0, 0, 0.5);\r\n    }\r\n\r\n    /* Destaque de Texto Metálico/Quântico */\r\n    .text-gradient-sota {\r\n        @apply text-transparent bg-clip-text bg-linear-to-b from-white via-slate-200 to-slate-400;\r\n    }\r\n\r\n    .hub-card {\r\n        @apply backdrop-blur-xl border border-white/5 p-8 rounded-3xl transition duration-500 relative flex flex-col gap-4;\r\n        background: linear-gradient(180deg, rgba(30, 41, 59, 0.2) 0%, rgba(15, 23, 42, 0.4) 100%);\r\n        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.02);\r\n    }\r\n\r\n    .hub-card:hover {\r\n        @apply -translate-y-1;\r\n        border-color: rgba(99, 102, 241, 0.3);\r\n        background: linear-gradient(180deg, rgba(49, 46, 129, 0.2) 0%, rgba(15, 23, 42, 0.6) 100%);\r\n        box-shadow: inset 0 1px 0 rgba(165, 180, 252, 0.15), 0 20px 40px -10px rgba(99, 102, 241, 0.15);\r\n    }\r\n\r\n    /* Utilitário de Texto SOTA (Alta Densidade) */\r\n    .text-label {\r\n        @apply font-mono text-[0.6rem] font-black uppercase tracking-[0.25em] flex items-center gap-2;\r\n        color: var(--color-text-muted, #94a3b8);\r\n    }\r\n\r\n    /* Container Padronizado (Geometria Áurea) */\r\n    .sota-container {\r\n        @apply w-full max-w-400 mx-auto px-6 sm:px-8 xl:px-12;\r\n    }\r\n\r\n    /* O Botão Primário SOTA */\r\n    .btn-primary {\r\n        @apply bg-accent-indigo text-white hover:bg-accent-indigo-light border border-white/10 flex items-center justify-center;\r\n    }\r\n\r\n    /* Icone Central de Cards do Hub */\r\n    .hub-icon {\r\n        @apply text-4xl mb-2 opacity-80 group-hover:opacity-100 transition-opacity;\r\n    }\r\n\r\n    /* Call to Action dos Cards do Hub */\r\n    .card-cta {\r\n        @apply mt-auto text-xs font-black uppercase tracking-widest flex items-center opacity-80 group-hover:opacity-100 group-hover:translate-x-1 transition;\r\n    }\r\n\r\n    /* Utilitário para ocultar scrollbars preservando a funcionalidade */\r\n    .scrollbar-hide {\r\n        -ms-overflow-style: none;\r\n        /* IE and Edge */\r\n    }\r\n\r\n    .scrollbar-hide::-webkit-scrollbar {\r\n        display: none;\r\n        /* Chrome, Safari and Opera */\r\n    }\r\n\r\n    /* Máscara de Fade Sophisticada para Enquadramento */\r\n    .sota-mask-fade {\r\n        -webkit-mask-image: linear-gradient(to bottom, black 90%, transparent 100%);\r\n        mask-image: linear-gradient(to bottom, black 90%, transparent 100%);\r\n    }\r\n\r\n    .sota-mask-fade-x {\r\n        -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);\r\n        mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);\r\n    }\r\n}\r\n\r\n/* Animações de Entrada Quantum */\r\n@keyframes fadeInScale {\r\n    from {\r\n        opacity: 0;\r\n        transform: scale(0.98);\r\n    }\r\n\r\n    to {\r\n        opacity: 1;\r\n        transform: scale(1);\r\n    }\r\n}\r\n\r\n.animate-sota-in {\r\n    animation: fadeInScale 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;\r\n}\r\n\r\n@keyframes fadeUp {\r\n    from {\r\n        opacity: 0;\r\n        transform: translateY(20px);\r\n        filter: blur(4px);\r\n    }\r\n\r\n    to {\r\n        opacity: 1;\r\n        transform: translateY(0);\r\n        filter: blur(0);\r\n    }\r\n}\r\n\r\n.animate-fade-up {\r\n    animation: fadeUp 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;\r\n}\r\n\r\n@keyframes pulseGlow {\r\n\r\n    0%,\r\n    100% {\r\n        filter: drop-shadow(0 0 10px rgba(99, 102, 241, 0.4));\r\n    }\r\n\r\n    50% {\r\n        filter: drop-shadow(0 0 20px rgba(99, 102, 241, 0.8));\r\n    }\r\n}\r\n\r\n.pulse-glow {\r\n    animation: pulseGlow 3s infinite;\r\n}\r\n","v":3}

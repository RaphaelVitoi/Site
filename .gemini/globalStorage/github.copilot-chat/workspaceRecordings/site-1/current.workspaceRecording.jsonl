{"kind":"changed","id":308,"time":1778649248685,"edit":[[729,729,"module.exports"],[730,730,"="],[731,731,"async"],[732,732,"function"],[733,733,"makeJestConfig() {\r\n    "],[793,793,"\r\n    // Substitui a malha padrao para garantir que JSX seja transpilado (React 17+)"],[795,795,"    // e erradica"],[796,796,"de"],[797,797,"vez"],[798,798,"os"],[803,803,"l"],[804,804,"tos de sobreposicao com o fallback do Babel.\r\n    confi"],[901,901,"\"^"],[902,902,"+\\\\"],[903,903,"(ts|tsx)$\": [\"ts-jest\", {\r\n            tsconfig: {\r\n                jsx: \"react-jsx\"\r\n            }\r\n        }],\r\n        "],[904,904,".."],[928,928,";\r\n\r\n    // Separa as responsabilidades isolando JS/JSX para o transformador nativo do Next\r\n    if (config.transform[\"^.+\\\\.(t|j)sx?$\"]) {\r\n        const nextTransformer = config.transform[\"^.+\\\\.(t|j)sx?$\"]"],[929,929,"\r\n        delete config.transform[\"^.+\\\\.(t|j)sx?$\"];\r\n        config.transform[\"^.+\\\\.(js|jsx)$\"] = nextTransformer;\r\n    }"]],"v":7,"metadata":{"source":"unknown"}}

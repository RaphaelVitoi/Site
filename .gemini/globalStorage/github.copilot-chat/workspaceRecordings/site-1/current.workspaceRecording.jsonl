{"kind":"setContent","time":1778597642899,"id":2,"content":"{\r\n  \"version\": \"1.0\",\r\n  \"permissions\": {\r\n    \"description\": \"Operacoes delegadas ao Orquestrador SOTA (do.ps1)\",\r\n    \"allow\": [\r\n      \"sota_sync\",\r\n      \"sota_backup\",\r\n      \"sota_audit\",\r\n      \"sota_db_check\",\r\n      \"sota_train_predictive\",\r\n      \"sota_omni_access\",\r\n      \"sota_daily_report\"\r\n    ]\r\n  },\r\n  \"operations\": {\r\n    \"sota_backup\": {\r\n      \"description\": \"Acionar Salvaguarda Integral do Ecossistema\",\r\n      \"type\": \"Bash\",\r\n      \"command\": \"powershell\",\r\n      \"args\": [\r\n        \"-NoProfile\",\r\n        \"-ExecutionPolicy\",\r\n        \"Bypass\",\r\n        \"-File\",\r\n        \".\\\\do.ps1\",\r\n        \"-Backup\"\r\n      ]\r\n    },\r\n    \"sota_sync\": {\r\n      \"description\": \"Sincroniza Manifesto dos Agentes para a Realidade Fisica\",\r\n      \"type\": \"Bash\",\r\n      \"command\": \"powershell\",\r\n      \"args\": [\r\n        \"-NoProfile\",\r\n        \"-ExecutionPolicy\",\r\n        \"Bypass\",\r\n        \"-File\",\r\n        \".\\\\do.ps1\",\r\n        \"-SyncAgents\"\r\n      ]\r\n    },\r\n    \"sota_audit\": {\r\n      \"description\": \"Dispara Auditoria Adaptativa SOTA (Smart MDA)\",\r\n      \"type\": \"Bash\",\r\n      \"command\": \"powershell\",\r\n      \"args\": [\r\n        \"-NoProfile\",\r\n        \"-ExecutionPolicy\",\r\n        \"Bypass\",\r\n        \"-File\",\r\n        \".\\\\do.ps1\",\r\n        \"-Audit\",\r\n        \"Auditoria Global de Integridade\"\r\n      ]\r\n    },\r\n    \"sota_db_check\": {\r\n      \"description\": \"Inspeciona integridade do DAL (SQLite)\",\r\n      \"type\": \"Bash\",\r\n      \"command\": \"powershell\",\r\n      \"args\": [\r\n        \"-NoProfile\",\r\n        \"-ExecutionPolicy\",\r\n        \"Bypass\",\r\n        \"-File\",\r\n        \".\\\\do.ps1\",\r\n        \"-CheckDB\"\r\n      ]\r\n    },\r\n    \"sota_train_predictive\": {\r\n      \"description\": \"Treina a Mente Preditiva (Random Forest) com base na telemetria recente\",\r\n      \"type\": \"Bash\",\r\n      \"command\": \"python\",\r\n      \"args\": [\r\n        \"task_executor.py\",\r\n        \"train-predictive\"\r\n      ]\r\n    },\r\n    \"sota_omni_access\": {\r\n      \"description\": \"Acesso Administrativo Local (C:)\",\r\n      \"type\": \"Bash\",\r\n      \"command\": \"powershell\",\r\n      \"args\": [\r\n        \"-NoProfile\",\r\n        \"-ExecutionPolicy\",\r\n        \"Bypass\"\r\n      ]\r\n    },\r\n    \"sota_daily_report\": {\r\n      \"description\": \"Compila a telemetria e gera o Relatorio Diario de Autonomia\",\r\n      \"type\": \"Bash\",\r\n      \"command\": \"powershell\",\r\n      \"args\": [\r\n        \"-NoProfile\",\r\n        \"-ExecutionPolicy\",\r\n        \"Bypass\",\r\n        \"-File\",\r\n        \".\\\\do.ps1\",\r\n        \"-DailyReport\"\r\n      ]\r\n    }\r\n  },\r\n  \"scheduling\": {\r\n    \"description\": \"Tarefas agendadas para manutencao periodica\",\r\n    \"tasks\": [\r\n      {\r\n        \"name\": \"daily_report\",\r\n        \"operation\": \"sota_daily_report\",\r\n        \"frequency\": \"daily\",\r\n        \"timeOfDay\": \"23:59\"\r\n      },\r\n      {\r\n        \"name\": \"predictive_calibration\",\r\n        \"operation\": \"sota_train_predictive\",\r\n        \"frequency\": \"hourly\"\r\n      }\r\n    ]\r\n  }\r\n}\r\n","v":1}

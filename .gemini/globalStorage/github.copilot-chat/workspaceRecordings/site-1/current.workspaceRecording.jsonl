{"kind":"setContent","time":1778724805742,"id":212,"content":"# Script de Limpeza SOTA\n# Wrapper moderno para o cleanup da fila SQLite.\n\nparam(\n    [Parameter(HelpMessage = \"Dias de retencao para tarefas concluidas.\")]\n    [int]$DaysToKeep = 30,\n\n    [Parameter(HelpMessage = \"Forca arquivamento de todo historico de 2025.\")]\n    [switch]$ArchiveAll2025\n)\n\n. (Join-Path (Join-Path $PSScriptRoot \"..\\utils\") \"NexusScriptTools.ps1\")\n\n$ProjectRoot = Get-NexusProjectRoot -StartDir $PSScriptRoot\n$PythonCmd = Get-NexusPythonCmd -ProjectRoot $ProjectRoot\n$TaskExecutor = Join-Path $ProjectRoot \"task_executor.py\"\n\nif ($ArchiveAll2025) {\n    $startOf2026 = Get-Date -Date \"2026-01-01\"\n    $timeSpan = New-TimeSpan -Start $startOf2026 -End (Get-Date)\n    $DaysToKeep = [math]::Floor($timeSpan.TotalDays)\n    Write-Output \"[CLEANUP] Modo ArchiveAll2025 ativado. Retendo apenas ultimos $DaysToKeep dias.\"\n}\n\n& $PythonCmd $TaskExecutor \"db-cleanup\" $DaysToKeep\nif ($LASTEXITCODE -ne 0) {\n    Write-Error \"[CLEANUP] Falha critica ao executar db-cleanup.\"\n    exit 1\n}\n\nWrite-Output \"[CLEANUP] Operacao de limpeza concluida com sucesso.\"\n","v":1}

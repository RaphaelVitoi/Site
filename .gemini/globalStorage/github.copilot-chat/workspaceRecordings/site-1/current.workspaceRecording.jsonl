{"kind":"setContent","time":1778696676143,"id":267,"content":"# PokerRacional — Variáveis de Ambiente\r\n# Copiar para .env.local para desenvolvimento local\r\n# Configurar no painel Vercel para produção\r\n\r\n# Banco de dados (SQLite local / Postgres em produção)\r\n# Desenvolvimento: file:./prisma/dev.db\r\n# Produção: postgresql://USER:PASSWORD@HOST:PORT/DATABASE\r\nDATABASE_URL=\"file:./prisma/dev.db\"\r\n\r\n# URL base da aplicação\r\nNEXT_PUBLIC_APP_URL=\"https://pokerracional.com\"\r\nNEXT_PUBLIC_NEXUS_API_BASE=\"http://127.0.0.1:17042\"\r\nNEXUS_API_BASE=\"http://127.0.0.1:17042\"\r\n\r\n# Analytics (Vercel Analytics — ativar no painel Vercel)\r\n# Não requer variável de ambiente adicional se usar @vercel/analytics\r\n\r\n# Opcional: Google Analytics\r\n# NEXT_PUBLIC_GA_ID=\"G-XXXXXXXXXX\"\r\n","v":1}

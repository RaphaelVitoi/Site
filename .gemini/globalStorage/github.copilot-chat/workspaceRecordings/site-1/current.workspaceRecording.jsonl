  { pos: \"9º\", val: 36.47, jump: 0 },\r\n];\r\n\r\nexport const TOTAL_POOL = 1260;\r\n\r\nexport type RangeAction = \"raise\" | \"call\" | \"shove\" | \"fold\";\r\nexport type RangeCell = Partial<Record<RangeAction, number>>;\r\n\r\nexport const BTN_ACTION_GRID: RangeCell[][] = [\r\n  [\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n  ],\r\n  [\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n  ],\r\n  [\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n  ],\r\n  [\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n  ],\r\n  [\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { fold: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { fold: 100 },\r\n    { fold: 100 },\r\n    { fold: 100 },\r\n    { fold: 100 },\r\n  ],\r\n  [\r\n    { raise: 100 },\r\n    { fold: 100 },\r\n    { fold: 100 },\r\n    { fold: 100 },\r\n    { raise: 100 },\r\n    { raise: 100 },\r\n    { r
{"kind":"setContent","time":1778598319855,"id":281,"content":":root {\r\n    --bg-deep: #020617;\r\n    --glass-border: rgba(255, 255, 255, 0.08);\r\n    --glass-surface: rgba(15, 23, 42, 0.6);\r\n    --accent-indigo: #6366f1;\r\n    --accent-pink: #ec4899;\r\n    --ease-elastic: cubic-bezier(0.16, 1, 0.3, 1);\r\n}\r\n\r\nbody {\r\n    background-color: var(--bg-deep);\r\n    color: #f8fafc;\r\n    font-family: 'Inter', sans-serif;\r\n    background-image:\r\n        radial-gradient(circle at 15% 50%, rgba(99, 102, 241, 0.08), transparent 25%),\r\n        radial-gradient(circle at 85% 30%, rgba(236, 72, 153, 0.08), transparent 25%),\r\n        linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),\r\n        linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);\r\n    background-size: 100% 100%, 100% 100%, 50px 50px, 50px 50px;\r\n}\r\n\r\n/* Glassmorphism */\r\n.glass-panel {\r\n    background: var(--glass-surface);\r\n    -webkit-backdrop-filter: blur(20px);\r\n    backdrop-filter: blur(20px);\r\n    border: 1px solid var(--glass-border);\r\n    border-top: 1px solid rgba(255, 255, 255, 0.15);\r\n    border-radius: 24px;\r\n    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\r\n    transition: all 0.4s var(--ease-elastic);\r\n}\r\n\r\n.glass-panel:hover {\r\n    border-color: rgba(255, 255, 255, 0.12);\r\n    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.2);\r\n}\r\n\r\n/* Typography Helpers */\r\n.font-editorial {\r\n    font-family: 'Playfair Display', serif;\r\n}\r\n\r\n.font-mono-nums {\r\n    font-family: 'JetBrains Mono', monospace;\r\n    font-variant-numeric: tabular-nums;\r\n}\r\n\r\n.text-gradient {\r\n    background: linear-gradient(135deg, #fff 0%, #94a3b8 100%);\r\n    -webkit-background-clip: text;\r\n    background-clip: text;\r\n    -webkit-text-fill-color: transparent;\r\n}\r\n\r\n.badge {\r\n    font-size: 9px;\r\n    font-weight: 800;\r\n    text-transform: uppercase;\r\n    letter-spacing: 0.1em;\r\n    padding: 4px 8px;\r\n    border-radius: 4px;\r\n    background: rgba(30, 41, 59, 0.5);\r\n    color: #94a3b8;\r\n    border: 1px solid rgba(255, 255, 255, 0.05);\r\n}\r\n\r\n/* Animation */\r\n@keyframes fadeSlideUp {\r\n    from {\r\n        opacity: 0;\r\n        transform: translateY(15px) scale(0.98);\r\n    }\r\n\r\n    to {\r\n        opacity: 1;\r\n        transform: translateY(0) scale(1);\r\n    }\r\n}\r\n\r\n.anim-enter {\r\n    animation: fadeSlideUp 0.5s var(--ease-elastic) forwards;\r\n}\r\n\r\n.glow-bg {\r\n    position: absolute;\r\n    top: 50%;\r\n    left: 50%;\r\n    transform: translate(-50%, -50%);\r\n    width: 200px;\r\n    height: 200px;\r\n    background: rgba(99, 102, 241, 0.15);\r\n    filter: blur(80px);\r\n    z-index: -1;\r\n    border-radius: 50%;\r\n}\r\n\r\n/* Ticker */\r\n.ticker-container {\r\n    overflow: hidden;\r\n    white-space: nowrap;\r\n}\r\n\r\n.ticker-content {\r\n    display: inline-block;\r\n    animation: ticker 30s linear infinite;\r\n}\r\n\r\n@keyframes ticker {\r\n    0% {\r\n        transform: translateX(0);\r\n    }\r\n\r\n    100% {\r\n        transform: translateX(-50%);\r\n    }\r\n}\r\n\r\n/* Scrollbar */\r\n::-webkit-scrollbar {\r\n    width: 6px;\r\n}\r\n\r\n::-webkit-scrollbar-track {\r\n    background: transparent;\r\n}\r\n\r\n::-webkit-scrollbar-thumb {\r\n    background: #334155;\r\n    border-radius: 10px;\r\n}\r\n\r\n/* Component Slots */\r\nrisk-gauge {\r\n    display: block;\r\n}\r\n\r\nscenario-list {\r\n    display: block;\r\n}\r\n\r\n/* Semantic Status Colors (Separation of Concerns) */\r\n.status-positive {\r\n    color: #34d399;\r\n}\r\n\r\n/* emerald-400 */\r\n.status-negative {\r\n    color: #f472b6;\r\n}\r\n\r\n/* pink-400 */\r\n.status-neutral {\r\n    color: #94a3b8;\r\n}\r\n\r\n/* slate-400 */\r\n.bg-status-positive {\r\n    background-color: rgba(52, 211, 153, 0.1);\r\n    border-color: rgba(52, 211, 153, 0.2);\r\n}\r\n\r\n.bg-status-negative {\r\n    background-color: rgba(236, 72, 153, 0.1);\r\n    border-color: rgba(236, 72, 153, 0.2);\r\n}\r\n","v":2}

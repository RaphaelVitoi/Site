{"version":2,"initialFileContents":[["file:///c%3A/Users/Raphael/OneDrive/Documentos/Site/components/interactive/icm_toy_game_simulator.html","939695e"]],"timeline":{"checkpoints":[{"checkpointId":"78a3be02-e144-4685-afcb-7b65724cad74","epoch":0,"label":"Initial State","description":"Starting point before any edits"},{"checkpointId":"087a736b-ef49-4c5f-9592-f1e8f324d390","requestId":"request_b87b0cfb-3ff9-4b1a-8763-0d19c6ab89cb","epoch":1,"label":"Request request_b87b0cfb-3ff9-4b1a-8763-0d19c6ab89cb"}],"currentEpoch":4,"fileBaselines":[["file:///c%3A/Users/Raphael/OneDrive/Documentos/Site/components/interactive/icm_toy_game_simulator.html::request_b87b0cfb-3ff9-4b1a-8763-0d19c6ab89cb",{"uri":{"$mid":1,"fsPath":"c:\\Users\\Raphael\\OneDrive\\Documentos\\Site\\components\\interactive\\icm_toy_game_simulator.html","_sep":1,"external":"file:///c%3A/Users/Raphael/OneDrive/Documentos/Site/components/interactive/icm_toy_game_simulator.html","path":"/c:/Users/Raphael/OneDrive/Documentos/Site/components/interactive/icm_toy_game_simulator.html","scheme":"file"},"requestId":"request_b87b0cfb-3ff9-4b1a-8763-0d19c6ab89cb","content":"<!DOCTYPE html>\r\n<html lang=\"pt-BR\">\r\n\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Simulador de Toy-Game ICM</title>\r\n    <style>\r\n        :root {\r\n            --background-color: #ffffff;\r\n            --text-color: #333;\r\n            --primary-color: #007bff;\r\n            --secondary-color: #6c757d;\r\n            --border-color: #ccc;\r\n            --label-color: #555;\r\n        }\r\n\r\n        body {\r\n            font-family: -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif;\r\n            background-color: var(--background-color);\r\n            color: var(--text-color);\r\n            margin: 0;\r\n            padding: 1.5rem;\r\n            box-sizing: border-box;\r\n        }\r\n\r\n        .simulator-container {\r\n            max-width: 600px;\r\n            margin: auto;\r\n            padding: 1.5rem;\r\n            border: 1px solid var(--border-color);\r\n            border-radius: 8px;\r\n            background-color: #f9f9f9;\r\n        }\r\n\r\n        .controls {\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 1.5rem;\r\n            margin-bottom: 2rem;\r\n        }\r\n\r\n        .slider-group {\r\n            display: flex;\r\n            flex-direction: column;\r\n        }\r\n\r\n        .slider-group label {\r\n            margin-bottom: 0.5rem;\r\n            color: var(--label-color);\r\n            font-weight: 500;\r\n        }\r\n\r\n        input[type=\"range\"] {\r\n            -webkit-appearance: none;\r\n            width: 100%;\r\n            height: 8px;\r\n            border-radius: 5px;\r\n            background: #ddd;\r\n            outline: none;\r\n            opacity: 0.7;\r\n            -webkit-transition: .2s;\r\n            transition: opacity .2s;\r\n        }\r\n\r\n        input[type=\"range\"]:hover {\r\n            opacity: 1;\r\n        }\r\n\r\n        input[type=\"range\"]::-webkit-slider-thumb {\r\n            -webkit-appearance: none;\r\n            appearance: none;\r\n            width: 20px;\r\n            height: 20px;\r\n            border-radius: 50%;\r\n            background: var(--primary-color);\r\n            cursor: pointer;\r\n        }\r\n\r\n        input[type=\"range\"]::-moz-range-thumb {\r\n            width: 20px;\r\n            height: 20px;\r\n            border-radius: 50%;\r\n            background: var(--primary-color);\r\n            cursor: pointer;\r\n        }\r\n\r\n        .outputs {\r\n            margin-bottom: 1.5rem;\r\n        }\r\n\r\n        .chart {\r\n            display: flex;\r\n            flex-direction: column;\r\n            gap: 1rem;\r\n        }\r\n\r\n        .bar-group {\r\n            display: flex;\r\n            flex-direction: column;\r\n        }\r\n\r\n        .bar-group label {\r\n            color: var(--label-color);\r\n            font-size: 0.9rem;\r\n            margin-bottom: 0.25rem;\r\n        }\r\n\r\n        .bar-container {\r\n            width: 100%;\r\n            display: flex;\r\n            align-items: center;\r\n            gap: 0.5rem;\r\n        }\r\n\r\n        progress {\r\n            flex: 1;\r\n            height: 24px;\r\n            border-radius: 4px;\r\n            border: none;\r\n            overflow: hidden;\r\n        }\r\n\r\n        #bluff-bar {\r\n            accent-color: var(--primary-color);\r\n        }\r\n\r\n        #defense-bar {\r\n            accent-color: var(--secondary-color);\r\n        }\r\n\r\n        .bar-group span {\r\n            align-self: flex-end;\r\n            margin-top: 0.25rem;\r\n            font-weight: 500;\r\n        }\r\n\r\n        .notes {\r\n            font-size: 0.8rem;\r\n            color: #6c757d;\r\n            text-align: center;\r\n            border-top: 1px solid var(--border-color);\r\n            padding-top: 1rem;\r\n            margin-top: 2rem;\r\n        }\r\n\r\n        @media (max-width: 600px) {\r\n            body {\r\n                padding: 0.5rem;\r\n            }\r\n\r\n            .simulator-container {\r\n                padding: 1rem;\r\n            }\r\n\r\n            .controls {\r\n                gap: 1rem;\r\n            }\r\n        }\r\n    </style>\r\n</head>\r\n\r\n<body>\r\n\r\n    <div class=\"simulator-container\">\r\n        <div class=\"controls\">\r\n            <div class=\"slider-group\">\r\n                <label for=\"rp-ip\">Risk Premium do Agressor (IP): <span id=\"rp-ip-value\">3%</span></label>\r\n                <input type=\"range\" id=\"rp-ip\" min=\"0\" max=\"25\" value=\"3\" step=\"1\">\r\n            </div>\r\n            <div class=\"slider-group\">\r\n                <label for=\"rp-oop\">Risk Premium do Defensor (OOP): <span id=\"rp-oop-value\">9%</span></label>\r\n                <input type=\"range\" id=\"rp-oop\" min=\"0\" max=\"25\" value=\"9\" step=\"1\">\r\n            </div>\r\n        </div>\r\n        <div class=\"outputs\">\r\n            <div class=\"chart\">\r\n                <div class=\"bar-group\">\r\n                    <label for=\"bluff-bar\">Freq. de Bluff do Agressor (IP)</label>\r\n                    <div class=\"bar-container\">\r\n                        <progress id=\"bluff-bar\" min=\"0\" max=\"100\" value=\"0\"></progress>\r\n                        <span id=\"bluff-value\"></span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"bar-group\">\r\n                    <label for=\"defense-bar\">Freq. de Defesa do Defensor (OOP)</label>\r\n                    <div class=\"bar-container\">\r\n                        <progress id=\"defense-bar\" min=\"0\" max=\"100\" value=\"0\"></progress>\r\n                        <span id=\"defense-value\"></span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"notes\">\r\n            <p><small>Nota: Esta é uma ferramenta didática para ilustrar os conceitos do Módulo 2. Os valores são\r\n                    interpolações baseadas nos 8 \"Toy-Games\" e não substituem a análise de um solver GTO.</small></p>\r\n        </div>\r\n    </div>\r\n\r\n    <script>\r\n        document.addEventListener('DOMContentLoaded', () => {\r\n            const rpIpSlider = document.getElementById('rp-ip');\r\n            const rpOopSlider = document.getElementById('rp-oop');\r\n            const rpIpValueSpan = document.getElementById('rp-ip-value');\r\n            const rpOopValueSpan = document.getElementById('rp-oop-value');\r\n            const bluffBar = document.getElementById('bluff-bar');\r\n            const defenseBar = document.getElementById('defense-bar');\r\n            const bluffValueSpan = document.getElementById('bluff-value');\r\n            const defenseValueSpan = document.getElementById('defense-value');\r\n\r\n            function calculateOutputs(rp_ip, rp_oop) {\r\n                // ==================================================================================\r\n                // ALERTA DE IMPLEMENTAÇÃO: LÓGICA DE CÁLCULO PROVISÓRIA (PLACEHOLDER)\r\n                // Esta função usa uma lógica simplificada e dados mockados.\r\n                // Ela DEVE ser substituída pela lógica de interpolação baseada nos dados\r\n                // exatos dos 8 Toy-Games, assim que a Tarefa 1 for desbloqueada.\r\n                // ==================================================================================\r\n\r\n                // Pontos de dados conhecidos (valores de bluff e defesa são placeholders)\r\n                // Formato: { ip: RP_IP, oop: RP_OOP, bluff: FreqBluff, defense: FreqDefesa }\r\n                const dataPoints = [\r\n                    // Parte 1: RP crescente no OOP\r\n                    { ip: 0, oop: 0, bluff: 50, defense: 50 },  // TG1: ChipEV\r\n                    { ip: 3, oop: 6, bluff: 60, defense: 45 },  // TG2\r\n                    { ip: 3, oop: 9, bluff: 75, defense: 40 },  // TG3: Teto do RP começa aqui\r\n                    { ip: 3, oop: 18, bluff: 85, defense: 40 }, // TG4\r\n                    { ip: 3, oop: 24, bluff: 90, defense: 40 }, // TG5\r\n\r\n                    // Parte 2: RP invertido\r\n                    { ip: 9, oop: 3, bluff: 55, defense: 35 },  // TG6\r\n                    { ip: 18, oop: 3, bluff: 55, defense: 20 }, // TG7\r\n                    { ip: 21, oop: 3, bluff: 55, defense: 15 }  // TG8\r\n                ];\r\n\r\n                // Lógica de interpolação simplificada (provisória)\r\n                // Encontra o ponto de dado mais próximo usando distância euclidiana simples\r\n                let closestPoint = dataPoints[0];\r\n                let minDistance = Infinity;\r\n\r\n                for (const point of dataPoints) {\r\n                    const distance = Math.sqrt(Math.pow(rp_ip - point.ip, 2) + Math.pow(rp_oop - point.oop, 2));\r\n                    if (distance < minDistance) {\r\n                        minDistance = distance;\r\n                        closestPoint = point;\r\n                    }\r\n                }\r\n\r\n                // Lógica mais robusta de interpolação linear entre os 2 pontos mais próximos\r\n                // será implementada quando os dados reais estiverem disponíveis.\r\n                // Por enquanto, apenas retornamos o ponto mais próximo.\r\n                return {\r\n                    bluff: closestPoint.bluff,\r\n                    defense: closestPoint.defense\r\n                };\r\n            }\r\n\r\n            function updateSimulator() {\r\n                const rp_ip = Number.parseInt(rpIpSlider.value, 10);\r\n                const rp_oop = Number.parseInt(rpOopSlider.value, 10);\r\n\r\n                rpIpValueSpan.textContent = `${rp_ip}%`;\r\n                rpOopValueSpan.textContent = `${rp_oop}%`;\r\n\r\n                const { bluff, defense } = calculateOutputs(rp_ip, rp_oop);\r\n\r\n                bluffValueSpan.textContent = `${bluff.toFixed(0)}%`;\r\n                bluffBar.value = bluff;\r\n\r\n                defenseValueSpan.textContent = `${defense.toFixed(0)}%`;\r\n                defenseBar.value = defense;\r\n            }\r\n\r\n            rpIpSlider.addEventListener('input', updateSimulator);\r\n            rpOopSlider.addEventListener('input', updateSimulator);\r\n\r\n            // Initial call\r\n            updateSimulator();\r\n        });\r\n    </script>\r\n\r\n</body>\r\n\r\n</html>","epoch":2,"telemetryInfo":{}}]],"operations":[{"type":"textEdit","uri":{"$mid":1,"fsPath":"c:\\Users\\Raphael\\OneDrive\\Documentos\\Site\\components\\interactive\\icm_toy_game_simulator.html","_sep":1,"external":"file:///c%3A/Users/Raphael/OneDrive/Documentos/Site/components/interactive/icm_toy_game_simulator.html","path":"/c:/Users/Raphael/OneDrive/Documentos/Site/components/interactive/icm_toy_game_simulator.html","scheme":"file"},"requestId":"request_b87b0cfb-3ff9-4b1a-8763-0d19c6ab89cb","epoch":3,"edits":[{"text":"    <script>\n        function calculateOutputs(rp_ip, rp_oop) {\n            // ==================================================================================\n            // ALERTA DE IMPLEMENTAÇÃO: LÓGICA DE CÁLCULO PROVISÓRIA (PLACEHOLDER)\n            // Esta função usa uma lógica simplificada e dados mockados.\n            // Ela DEVE ser substituída pela lógica de interpolação baseada nos dados\n            // exatos dos 8 Toy-Games, assim que a Tarefa 1 for desbloqueada.\n            // ==================================================================================\n\n            // Pontos de dados conhecidos (valores de bluff e defesa são placeholders)\n            // Formato: { ip: RP_IP, oop: RP_OOP, bluff: FreqBluff, defense: FreqDefesa }\n            const dataPoints = [\n                // Parte 1: RP crescente no OOP\n                { ip: 0, oop: 0, bluff: 50, defense: 50 },  // TG1: ChipEV\n                { ip: 3, oop: 6, bluff: 60, defense: 45 },  // TG2\n                { ip: 3, oop: 9, bluff: 75, defense: 40 },  // TG3: Teto do RP começa aqui\n                { ip: 3, oop: 18, bluff: 85, defense: 40 }, // TG4\n                { ip: 3, oop: 24, bluff: 90, defense: 40 }, // TG5\n\n                // Parte 2: RP invertido\n                { ip: 9, oop: 3, bluff: 55, defense: 35 },  // TG6\n                { ip: 18, oop: 3, bluff: 55, defense: 20 }, // TG7\n                { ip: 21, oop: 3, bluff: 55, defense: 15 }  // TG8\n            ];\n\n            // Lógica de interpolação simplificada (provisória)\n            // Encontra o ponto de dado mais próximo usando distância euclidiana simples\n            let closestPoint = dataPoints[0];\n            let minDistance = Infinity;\n\n            for (const point of dataPoints) {\n                const distance = Math.sqrt(Math.pow(rp_ip - point.ip, 2) + Math.pow(rp_oop - point.oop, 2));\n                if (distance < minDistance) {\n                    minDistance = distance;\n                    closestPoint = point;\n                }\n            }\n\n            // Lógica mais robusta de interpolação linear entre os 2 pontos mais próximos\n            // será implementada quando os dados reais estiverem disponíveis.\n            // Por enquanto, apenas retornamos o ponto mais próximo.\n            return {\n                bluff: closestPoint.bluff,\n                defense: closestPoint.defense\n            };\n        }\n\n        document.addEventListener('DOMContentLoaded', () => {\n            const rpIpSlider = document.getElementById('rp-ip');\n            const rpOopSlider = document.getElementById('rp-oop');\n            const rpIpValueSpan = document.getElementById('rp-ip-value');\n            const rpOopValueSpan = document.getElementById('rp-oop-value');\n            const bluffBar = document.getElementById('bluff-bar');\n            const defenseBar = document.getElementById('defense-bar');\n            const bluffValueSpan = document.getElementById('bluff-value');\n            const defenseValueSpan = document.getElementById('defense-value');\n\n            function updateSimulator() {\n                const rp_ip = Number.parseInt(rpIpSlider.value, 10);\n                const rp_oop = Number.parseInt(rpOopSlider.value, 10);\n\n                rpIpValueSpan.textContent = `${rp_ip}%`;\n                rpOopValueSpan.textContent = `${rp_oop}%`;\n\n                const { bluff, defense } = calculateOutputs(rp_ip, rp_oop);\n\n                bluffValueSpan.textContent = `${bluff.toFixed(0)}%`;\n                bluffBar.value = bluff;\n\n                defenseValueSpan.textContent = `${defense.toFixed(0)}%`;\n                defenseBar.value = defense;\n            }\n\n            rpIpSlider.addEventListener('input', updateSimulator);\n            rpOopSlider.addEventListener('input', updateSimulator);\n\n            // Initial call\n            updateSimulator();\n        });\n    </script>\n","range":{"startLineNumber":200,"startColumn":1,"endLineNumber":280,"endColumn":1}}]}],"epochCounter":4},"recentSnapshot":{"entries":[{"resource":"file:///c%3A/Users/Raphael/OneDrive/Documentos/Site/components/interactive/icm_toy_game_simulator.html","languageId":"html","originalHash":"cb91330","currentHash":"cb91330","state":1,"snapshotUri":"chat-editing-snapshot-text-model:/c%3A/Users/Raphael/OneDrive/Documentos/Site/components/interactive/icm_toy_game_simulator.html?%7B%22session%22%3A%7B%22%24mid%22%3A1%2C%22external%22%3A%22vscode-chat-session%3A%2F%2Flocal%2FYTNmMDNkNWMtNjNjYy00NGNjLThhYWMtNzdiNjI1MzExMDY3%22%2C%22path%22%3A%22%2FYTNmMDNkNWMtNjNjYy00NGNjLThhYWMtNzdiNjI1MzExMDY3%22%2C%22scheme%22%3A%22vscode-chat-session%22%2C%22authority%22%3A%22local%22%7D%2C%22requestId%22%3A%22%22%2C%22undoStop%22%3A%22%22%7D","telemetryInfo":{"requestId":"request_b87b0cfb-3ff9-4b1a-8763-0d19c6ab89cb","agentId":"github.copilot.editingSessionEditor","command":"fix","modelId":"copilot/auto","modeId":"ask"}}]}}
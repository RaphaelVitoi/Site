<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulador de Toy-Game ICM</title>
    <style>
        :root {
            --background-color: #ffffff;
            --text-color: #333;
            --primary-color: #007bff;
            --secondary-color: #6c757d;
            --border-color: #ccc;
            --label-color: #555;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background-color: var(--background-color);
            color: var(--text-color);
            margin: 0;
            padding: 1.5rem;
            box-sizing: border-box;
        }

        .simulator-container {
            max-width: 600px;
            margin: auto;
            padding: 1.5rem;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            background-color: #f9f9f9;
        }

        .controls {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .slider-group {
            display: flex;
            flex-direction: column;
        }

        .slider-group label {
            margin-bottom: 0.5rem;
            color: var(--label-color);
            font-weight: 500;
        }

        input[type="range"] {
            -webkit-appearance: none;
            width: 100%;
            height: 8px;
            border-radius: 5px;
            background: #ddd;
            outline: none;
            opacity: 0.7;
            -webkit-transition: .2s;
            transition: opacity .2s;
        }

        input[type="range"]:hover {
            opacity: 1;
        }

        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--primary-color);
            cursor: pointer;
        }

        input[type="range"]::-moz-range-thumb {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background: var(--primary-color);
            cursor: pointer;
        }

        .outputs {
            margin-bottom: 1.5rem;
        }

        .chart {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .bar-group {
            display: flex;
            flex-direction: column;
        }

        .bar-group label {
            color: var(--label-color);
            font-size: 0.9rem;
            margin-bottom: 0.25rem;
        }

        .bar-container {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        progress {
            flex: 1;
            height: 24px;
            border-radius: 4px;
            border: none;
            overflow: hidden;
        }

        #bluff-bar {
            accent-color: var(--primary-color);
        }

        #defense-bar {
            accent-color: var(--secondary-color);
        }

        .bar-group span {
            align-self: flex-end;
            margin-top: 0.25rem;
            font-weight: 500;
        }

        .notes {
            font-size: 0.8rem;
            color: #6c757d;
            text-align: center;
            border-top: 1px solid var(--border-color);
            padding-top: 1rem;
            margin-top: 2rem;
        }

        @media (max-width: 600px) {
            body {
                padding: 0.5rem;
            }

            .simulator-container {
                padding: 1rem;
            }

            .controls {
                gap: 1rem;
            }
        }
    </style>
</head>

<body>

    <div class="simulator-container">
        <div class="controls">
            <div class="slider-group">
                <label for="rp-ip">Risk Premium do Agressor (IP): <span id="rp-ip-value">3%</span></label>
                <input type="range" id="rp-ip" min="0" max="25" value="3" step="1">
            </div>
            <div class="slider-group">
                <label for="rp-oop">Risk Premium do Defensor (OOP): <span id="rp-oop-value">9%</span></label>
                <input type="range" id="rp-oop" min="0" max="25" value="9" step="1">
            </div>
        </div>
        <div class="outputs">
            <div class="chart">
                <div class="bar-group">
                    <label for="bluff-bar">Freq. de Bluff do Agressor (IP)</label>
                    <div class="bar-container">
                        <progress id="bluff-bar" min="0" max="100" value="0"></progress>
                        <span id="bluff-value"></span>
                    </div>
                </div>
                <div class="bar-group">
                    <label for="defense-bar">Freq. de Defesa do Defensor (OOP)</label>
                    <div class="bar-container">
                        <progress id="defense-bar" min="0" max="100" value="0"></progress>
                        <span id="defense-value"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="notes">
            <p><small>Nota: Esta é uma ferramenta didática para ilustrar os conceitos do Módulo 2. Os valores são
                    interpolações baseadas nos 8 "Toy-Games" e não substituem a análise de um solver GTO.</small></p>
        </div>
    </div>

    <script>
        function calculateOutputs(rp_ip, rp_oop) {
            // ==================================================================================
            // ALERTA DE IMPLEMENTAÇÃO: LÓGICA DE CÁLCULO PROVISÓRIA (PLACEHOLDER)
            // Esta função usa uma lógica simplificada e dados mockados.
            // Ela DEVE ser substituída pela lógica de interpolação baseada nos dados
            // exatos dos 8 Toy-Games, assim que a Tarefa 1 for desbloqueada.
            // ==================================================================================

            // Pontos de dados conhecidos (valores de bluff e defesa são placeholders)
            // Formato: { ip: RP_IP, oop: RP_OOP, bluff: FreqBluff, defense: FreqDefesa }
            const dataPoints = [
                // Parte 1: RP crescente no OOP
                { ip: 0, oop: 0, bluff: 50, defense: 50 },  // TG1: ChipEV
                { ip: 3, oop: 6, bluff: 60, defense: 45 },  // TG2
                { ip: 3, oop: 9, bluff: 75, defense: 40 },  // TG3: Teto do RP começa aqui
                { ip: 3, oop: 18, bluff: 85, defense: 40 }, // TG4
                { ip: 3, oop: 24, bluff: 90, defense: 40 }, // TG5

                // Parte 2: RP invertido
                { ip: 9, oop: 3, bluff: 55, defense: 35 },  // TG6
                { ip: 18, oop: 3, bluff: 55, defense: 20 }, // TG7
                { ip: 21, oop: 3, bluff: 55, defense: 15 }  // TG8
            ];

            // Lógica de interpolação simplificada (provisória)
            // Encontra o ponto de dado mais próximo usando distância euclidiana simples
            let closestPoint = dataPoints[0];
            let minDistance = Infinity;

            for (const point of dataPoints) {
                const distance = Math.sqrt(Math.pow(rp_ip - point.ip, 2) + Math.pow(rp_oop - point.oop, 2));
                if (distance < minDistance) {
                    minDistance = distance;
                    closestPoint = point;
                }
            }

            // Lógica mais robusta de interpolação linear entre os 2 pontos mais próximos
            // será implementada quando os dados reais estiverem disponíveis.
            // Por enquanto, apenas retornamos o ponto mais próximo.
            return {
                bluff: closestPoint.bluff,
                defense: closestPoint.defense
            };
        }

        document.addEventListener('DOMContentLoaded', () => {
            const rpIpSlider = document.getElementById('rp-ip');
            const rpOopSlider = document.getElementById('rp-oop');
            const rpIpValueSpan = document.getElementById('rp-ip-value');
            const rpOopValueSpan = document.getElementById('rp-oop-value');
            const bluffBar = document.getElementById('bluff-bar');
            const defenseBar = document.getElementById('defense-bar');
            const bluffValueSpan = document.getElementById('bluff-value');
            const defenseValueSpan = document.getElementById('defense-value');

            function updateSimulator() {
                const rp_ip = Number.parseInt(rpIpSlider.value, 10);
                const rp_oop = Number.parseInt(rpOopSlider.value, 10);

                rpIpValueSpan.textContent = `${rp_ip}%`;
                rpOopValueSpan.textContent = `${rp_oop}%`;

                const { bluff, defense } = calculateOutputs(rp_ip, rp_oop);

                bluffValueSpan.textContent = `${bluff.toFixed(0)}%`;
                bluffBar.value = bluff;

                defenseValueSpan.textContent = `${defense.toFixed(0)}%`;
                defenseBar.value = defense;
            }

            rpIpSlider.addEventListener('input', updateSimulator);
            rpOopSlider.addEventListener('input', updateSimulator);

            // Initial call
            updateSimulator();
        });
    </script>

</body>

</html>
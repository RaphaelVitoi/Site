// ==============================================================================
// IDENTITY: Database Schema for Nash Solver & ICM Lab
// PATH: prisma/schema.prisma
// ROLE: Define a estrutura relacional para armazenar dados de teoria dos jogos de poker,
//       incluindo spots, estrategias, stacks de jogadores e detalhes de torneio,
//       para suportar calculos de ICM, analise de Risk Premium e solucoes GTO.
// BINDING: [Laboratorio de ICM Universal (V2), @implementor, @auditor, Python DAL,
//           Frontend (Next.js/React para visualizacao de dados), @validador]
// TELEOLOGY: Evoluir para suportar percursos complexos em arvores de jogo, simulacoes FGS,
//            e integracao com dados de solvers externos (DeepSolver, GTOWizard).
// ==============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==============================================================================
// Entidades Essenciais: Torneio e Estrutura de Premiacao para Calculos ICM/Risk Premium
// ==============================================================================

model Tournament {
  id               String           @id @default(cuid())
  name             String
  buy_in           Float
  total_prize_pool Float
  start_date       DateTime         @default(now())
  status           String           @default("active") // active, completed, cancelled

  payoutStructure PayoutStructure[]
  scenarios       TournamentScenario[]
}

model PayoutStructure {
  id           String    @id @default(cuid())
  tournamentId String
  rank         Int
  percentage   Float // e.g., 0.50 para 50%
  amount       Float // valor calculado para acesso rapido

  tournament Tournament @relation(fields: [tournamentId], references: [id])

  @@unique([tournamentId, rank])
}

// ==============================================================================
// Dados de Referencia: Tabelas de Consulta Estaticas para Contexto do Jogo
// ==============================================================================

model GameType {
  id   String @id @default(cuid())
  name String @unique // e.g., 'No-Limit Holdem', 'Pot-Limit Omaha'
  spots Spot[]
}

model Position {
  id   String @id @default(cuid())
  name String @unique // e.g., 'UTG', 'BTN', 'SB', 'BB', 'CO', 'MP'
  spots Spot[]
}

model Street {
  id   String @id @default(cuid())
  name String @unique // e.g., 'Preflop', 'Flop', 'Turn', 'River'
  spots Spot[]
}

model ActionType {
  id   String @id @default(cuid())
  name String @unique // e.g., 'Fold', 'Check', 'Call', 'Bet', 'Raise'
  // Futuro: Poderia adicionar 'value_type' (e.g., 'fixed', 'percentage_pot', 'to_N_bb')
  spotFlows     SpotFlow[]
  strategyActions StrategyAction[]
}

// ==============================================================================
// Modelo de Jogador - Para jogadores genericos em cenarios. Pode ser estendido para usuarios.
// ==============================================================================

model Player {
  id   String @id @default(cuid())
  name String @unique // e.g., "Hero", "Villain 1", "SB Player", "Player 3"
  // Para jogadores simulados, um nome simples e suficiente.
  // Para usuarios reais da plataforma, isso seria estendido para incluir detalhes do usuario.

  spotsToAct     Spot[] @relation("PlayerToAct")
  playerStacks   PlayerStackAtSpot[]
  strategies     Strategy[]
}

// ==============================================================================
// Estado do Jogo e Arvore de Decisao: Spots, Fluxos, Stacks, Estrategias
// ==============================================================================

model TournamentScenario {
  id           String    @id @default(cuid())
  tournamentId String
  name         String? // e.g., "Mesa Final 3-Handed"
  description  String?
  initial_stacks String? // Stacks iniciais (JSON array persistido obrigatoriamente como String no SQLite).

  tournament   Tournament @relation(fields: [tournamentId], references: [id])
  spots        Spot[]
}

model Spot {
  id                     String             @id @default(cuid())
  scenarioId             String // Liga a um contexto de torneio especifico
  parentFlowId           String? @unique // O SpotFlow que levou a este Spot (nulo para spots iniciais)
  playerToActId          String // ID do jogador que esta tomando uma decisao neste spot
  positionToActId        String? // Posicao do jogador a agir
  streetId               String
  pot_size_before_action Float
  board_cards            String? // String JSON: '["As", "Kd", "7h"]' ou '["As", "Kd", "7h", "2c"]'
  gameTypeId             String? // Assumindo que um Spot pertence a um GameType para regras

  // Relacionamentos
  scenario             TournamentScenario @relation(fields: [scenarioId], references: [id])
  parentFlow           SpotFlow?          @relation("NextSpotFromSpotFlow", fields: [parentFlowId], references: [id])
  playerToAct          Player             @relation("PlayerToAct", fields: [playerToActId], references: [id])
  positionToAct        Position?          @relation(fields: [positionToActId], references: [id])
  street               Street             @relation(fields: [streetId], references: [id])
  gameType             GameType?          @relation(fields: [gameTypeId], references: [id])

  playerStacksAtSpot PlayerStackAtSpot[]
  spotFlows          SpotFlow[]           @relation("CurrentSpot") // As acoes que podem ser tomadas a partir deste spot
  strategies         Strategy[]
}

model SpotFlow {
  id               String      @id @default(cuid())
  currentSpotId    String
  actionTypeId     String
  action_value     String? // e.g., "10bb", "pot", "all_in". String para flexibilidade.
  frequency        Float       // Com que frequencia esta acao e tomada (0.0 a 1.0)

  // Liga ao proximo estado (Spot) ou nulo se for um no terminal
  nextSpot         Spot?       @relation("NextSpotFromSpotFlow")
  nextSpotId       String?

  currentSpot      Spot        @relation("CurrentSpot", fields: [currentSpotId], references: [id])
  actionType       ActionType  @relation(fields: [actionTypeId], references: [id])
}

model PlayerStackAtSpot {
  id           String @id @default(cuid())
  spotId       String
  playerId     String // Representa o ID unico do jogador neste cenario
  stack_size   Float

  spot   Spot   @relation(fields: [spotId], references: [id])
  player Player @relation(fields: [playerId], references: [id])

  @@unique([spotId, playerId]) // Um jogador so pode ter uma stack em um spot especifico
}

// ==============================================================================
// Resultados do Solver: Estrategias e Valores Esperados (EV)
// ==============================================================================

model Strategy {
  id        String   @id @default(cuid())
  spotId    String
  playerId  String   // O jogador para quem esta estrategia e otima
  ev_total  Float    // EV total para este jogador neste spot, considerando a estrategia otima
  timestamp DateTime @default(now()) // Quando esta estrategia foi computada/armazenada

  spot            Spot             @relation(fields: [spotId], references: [id])
  player          Player           @relation(fields: [playerId], references: [id])
  strategyActions StrategyAction[]
}

model StrategyAction {
  id              String     @id @default(cuid())
  strategyId      String
  actionTypeId    String
  action_value    String? // e.g., "10bb", "pot", "all_in"
  frequency       Float      // 0.0 a 1.0, para estrategias mistas
  ev_contribution Float      // EV contribuido ao tomar esta acao especifica

  strategy   Strategy   @relation(fields: [strategyId], references: [id])
  actionType ActionType @relation(fields: [actionTypeId], references: [id])

  @@unique([strategyId, actionTypeId, action_value]) // Uma estrategia tem acoes unicas
}

// ==============================================================================
// NÚCLEO DE SIMULAÇÃO, USUÁRIOS E EDUCAÇÃO SOTA (Absorvido da Fase 1)
// ==============================================================================

model User {
  id          String       @id @default(cuid())
  email       String?      @unique
  name        String?
  emailVerified DateTime?
  image       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  simulations Simulation[]
  accounts    Account[]
  sessions    Session[]
}

// SOTA: Standard NextAuth.js Integration Models
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?
  access_token       String?
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Simulation {
  id          String    @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  status      String    @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED
  scenario    Scenario  @relation(fields: [scenarioId], references: [id])
  scenarioId  String
  results     Result[]
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?
  snapshots   AnalysisSnapshot[]
}

model Scenario {
  id          String       @id @default(cuid())
  name        String       @unique
  description String?
  payouts     String       // Ex: "[1000, 600, 400]"
  stacks      String       // Ex: "[50000, 35000, 20000, 15000, 10000]"
  blinds      String?      // Ex: "500/1000"
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  simulations Simulation[]
}

model Result {
  id           String     @id @default(cuid())
  simulation   Simulation @relation(fields: [simulationId], references: [id])
  simulationId String
  action       String     // Ex: "Hero (SB) Push 20bb"
  chipEv       Float?
  icmEv        Float
  icmEquity    Float?     // A equidade em % do prize pool
  ranges       String?    // Opcional: para armazenar os ranges de maos
  createdAt    DateTime   @default(now())
}

model AnalysisSnapshot {
  id           String     @id @default(cuid())
  name         String
  description  String?
  simulation   Simulation @relation(fields: [simulationId], references: [id])
  simulationId String
  resultData   String     // Um snapshot dos resultados no momento da criacao
  createdAt    DateTime   @default(now())
}

model IcmScenario {
  id                String    @id @default(cuid())
  slug              String    @unique
  name              String
  category          String    // 'clinical', 'baseline', 'toyGame'
  narrativeTitle    String
  narrativeSubtitle String
  theory            String    // Conteúdo HTML/Rich Text do fundamento
  exploit           String?   // JSON Array: Vetor de exploração (Strings)
  verdict           String?   // Ex: "FOLD ESTRUTURAL"
  stacks            String    // JSON Array: [9.4, 52.4, 22.2, ...]
  prizes            String    // JSON Array: [237.34, 170.96, ...]
  ipPos             String    // Ex: "BTN"
  oopPos            String    // Ex: "BB"
  ipRp              Float     // Risk Premium Baseline IP
  oopRp             Float     // Risk Premium Baseline OOP
  ipMorph           String?   // Morfologia IP
  oopMorph          String?   // Morfologia OOP
  sprData           String    // JSON Array
  defaultStreetFreqs String   // JSON Object
  isPublished       Boolean   @default(false)
  authorId          String?
  quizzes           IcmQuiz[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@index([category])
}

model IcmQuiz {
  id              String       @id @default(cuid())
  question        String
  explanation     String       // Por que a resposta está correta (Insight)
  options         String       // JSON Array
  scenarioId      String
  scenario        IcmScenario  @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
}

model Lesson {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  markdown_body String
  type          String   @default("Lesson") // 'Lesson' ou 'Article'
  tags          String   // CSV ou JSON string para correlacao com tags do Quiz
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Content {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    String
  title       String
  description String?
  body        String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// PROJETO PANÓPTICO: TELEMETRIA E APRENDIZADO
// ==========================================
model TelemetryEvent {
  id              String   @id @default(uuid())
  userId          String   @default("anonymous") // Evoluir para ID real com NextAuth
  category        String
  scenarioContext String?
  userAction      String?
  optimalAction   String?
  evLoss          Float    @default(0)
  isCorrect       Boolean  @default(true)
  latency         Int      @default(0)
  componentName   String?
  metadata        String?  // JSON string (SQLite)
  createdAt       DateTime @default(now())

  @@index([category])
  @@index([userId, createdAt])
  @@index([userId, category, isCorrect]) // SOTA: Otimização p/ queries de Leaks no Dashboard Preditivo
}

// ==========================================
// SOTA: Tabela de Telemetria e Perspectiva Matemática Vitoi (Motor Híbrido)
// ==========================================
model VitoiPerspectiveMetrics {
  id                        String   @id @default(cuid())
  scenarioId                String?  // Opcional, permitindo linkar ao MasterSimulator

  // Base State
  chipEvFold                Float
  icmValuation              Float

  // Modificadores Dinâmicos
  timeToBlindJumpMinutes    Float
  payjumpProximityFactor    Float
  positionalUrgency         String   // Ex: "UTG", "BTN", "BB"

  // Passivos Estruturais
  multiwayOpponents         Int
  reverseImpliedOddsPenalty Float

  // Amortização de Edge
  stackDepthBb              Float
  humanNoiseFactor          Float
  technicalSuperiority      Float

  // Análise de Insolvência
  potOddsRatio              Float
  perspectiveUtility        Float
  insolvencyCoefficient     Float    // Ci = PotOdds / PM
  isViable                  Boolean  // O Veredito final

  createdAt                 DateTime @default(now())
}

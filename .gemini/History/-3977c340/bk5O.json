{
  "protected_agents_from_cleanup": [
    "@maverick",
    "@chico",
    "@architect",
    "@securitychief",
    "@organizador",
    "@skillmaster",
    "@bibliotecario",
    "@sequenciador"
  ],
  "handoff_pipeline": {
    "@dispatcher": "@architect",
    "@architect": "@planner",
    "@planner": "@pesquisador",
    "@pesquisador": "@prompter",
    "@prompter": "@auditor",
    "@auditor": "@implementor",
    "@implementor": "@verifier",
    "@verifier": "@curator"
  },
  "workflow_flags": {
    "enable_dynamic_fallback": true,
    "enable_dispatcher_schema_retry": true,
    "enable_security_gate": false,
    "enable_domain_validation_gate": true,
    "enable_strategy_gate": true,
    "enable_research_gate": true,
    "prefer_cost_saving_mode": true,
    "anthropic_last": true
  },
  "routing_heuristics": {
    "research_terms": [
      "pesquisa",
      "research",
      "benchmark",
      "mercado",
      "competidor",
      "fonte",
      "referencia",
      "web",
      "sota"
    ],
    "strategic_terms": [
      "estrateg",
      "roadmap",
      "visao",
      "tradeoff",
      "produto",
      "governanca",
      "hipotese",
      "cenario"
    ],
    "security_terms": [
      "auth",
      "autentic",
      "token",
      "rbac",
      "cors",
      "secret",
      "chave",
      "vazamento",
      "seguranca",
      "privacy"
    ],
    "domain_terms": [
      "icm",
      "gto",
      "nash",
      "ev",
      "roi",
      "matemat",
      "calculo",
      "jurid",
      "medic",
      "financ"
    ]
  },
  "agent_sla": {
    "default": {
      "llm_timeout_seconds": 600,
      "provider_retries": 1,
      "dispatcher_schema_retries": 1
    },
    "@dispatcher": {
      "llm_timeout_seconds": 240,
      "provider_retries": 1,
      "dispatcher_schema_retries": 1
    },
    "@implementor": {
      "llm_timeout_seconds": 900,
      "provider_retries": 2
    }
  },
  "model_health_gate": {
    "enabled": true,
    "window_minutes": 180,
    "min_attempts": 3,
    "min_success_rate_pct": 10.0,
    "drop_only_free_models": true,
    "protect_models": [
      "meta-llama/llama-3.1-8b-instruct"
    ]
  },
  "model_routing": {
    "deep_thinking": [
      "gemini-1.5-pro",
      "gemini-2.0-flash"
    ],
    "fast_operations": [
      "gemini-2.0-flash"
    ]
  },
  "openrouter_alternatives": []
}
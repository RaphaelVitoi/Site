models:
  - name: "Gemini 2.5 Pro (Lógica)"
    provider: google-sdk
    model: google/gemini-2.5-pro
    apiKey: ${GEMINI_API_KEY} # Referência dinâmica
    roles:
      - chat

  - name: "Gemini 2.0 Flash (Escrita)"
    provider: google-sdk
    model: google/gemini-2.0-flash
    apiKey: ${GEMINI_API_KEY}
    roles:
      - chat
      - edit
      - apply
      - autocomplete
    autocompleteOptions:
      debounceDelay: 350

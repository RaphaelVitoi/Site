generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model IcmScenario {
  id                 String    @id @default(cuid())
  slug               String    @unique
  name               String
  category           String
  narrativeTitle     String?
  narrativeSubtitle  String?
  theory             String?
  exploit            String?
  verdict            String?
  stacks             String
  prizes             String
  ipPos              String
  oopPos             String
  ipRp               Float
  oopRp              Float
  ipMorph            String?
  oopMorph           String?
  sprData            String?
  defaultStreetFreqs String?
  isPublished        Boolean   @default(false)
  quizzes            IcmQuiz[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([category])
  @@index([isPublished])
}

model IcmQuiz {
  id          String      @id @default(cuid())
  scenarioId  String
  scenario    IcmScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  question    String
  explanation String?
  options     String
  createdAt   DateTime    @default(now())
}

model Lesson {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  markdown_body String
  type          String?
  tags          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([type])
}

model Content {
  id          String   @id @default(cuid())
  slug        String   @unique
  category    String
  title       String
  description String?
  body        String
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isPublished])
}

model TelemetryEvent {
  id              String   @id @default(cuid())
  userId          String?
  category        String
  scenarioContext String?
  userAction      String?
  optimalAction   String?
  evLoss          Float    @default(0)
  isCorrect       Boolean  @default(true)
  latency         Float    @default(0)
  componentName   String
  metadata        String?
  createdAt       DateTime @default(now())

  @@index([category])
  @@index([userId])
}

model VitoiPerspectiveMetric {
  id                        String   @id @default(cuid())
  scenarioId                String?
  chipEvFold                Float
  icmValuation              Float
  timeToBlindJumpMinutes    Float
  payjumpProximityFactor    Float
  positionalUrgency         Float
  multiwayOpponents         Float
  reverseImpliedOddsPenalty Float
  stackDepthBb              Float
  humanNoiseFactor          Float
  technicalSuperiority      Float
  potOddsRatio              Float
  perspectiveUtility        Float
  insolvencyCoefficient     Float?
  isViable                  Boolean
  createdAt                 DateTime @default(now())

  @@index([scenarioId])
}

{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SOTA: Vigília Ativa (File Watcher)",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy",
                "Bypass",
                "-File",
                "${workspaceFolder}/do.ps1",
                "-Watch"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "isBackground": true
        },
        {
            "label": "SOTA: Servidor Frontend (Turbopack)",
            "type": "shell",
            "command": "npm",
            "args": [
                "run",
                "dev",
                "--workspace",
                "frontend"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "new"
            }
        }
    ]
}

{
    /* PROTOCOLO VITOI v3.2 | NÚCLEO: GEMINI 3.1 PRO (REASONING ENGINE)
       ARQUITETURA: SÍNTESE POLIFÓRMICA | LEI DE SHANNON | ANTEVISÃO SEMÂNTICA
    */
    /* --- [DOMÍNIO 1] INFRAESTRUTURA E RUNTIME (PYTHON, NODE, PS1) --- */
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.analysis.typeCheckingMode": "standard",
    "python.analysis.autoImportCompletions": true,
    "python.analysis.autoFormatStrings": true,
    "python.analysis.inlayHints.functionReturnTypes": true,
    "python.analysis.inlayHints.variableTypes": true,
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": true,
    "python.terminal.activateEnvInCurrentTerminal": true,
    "python.terminal.focusAfterLaunch": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",
    "terminal.integrated.profiles.windows": {
        "PowerShell": {
            "source": "PowerShell",
            "icon": "terminal-powershell",
            "args": [
                "-NoExit",
                "-ExecutionPolicy",
                "Bypass",
                "-Command",
                "& { $root = '${workspaceFolder}'; $venv = Join-Path $root '.venv/Scripts/Activate.ps1'; if (Test-Path $venv) { . $venv } else { Write-Host '[ENTROPIA] .venv nao detectado.' -ForegroundColor Red } }"
            ]
        }
    },
    "powershell.codeFormatting.autoCorrectAliases": true,
    "powershell.analyzeOpenDocumentsOnly": true,
    "npm.enableRunFromFolder": true,
    "npm.runSilent": true,
    /* --- [DOMÍNIO 2] CÓRTEX IA & ORQUESTRAÇÃO --- */
    "google.cloudcode.gemini.experimental.customInstructions": "Adote o Protocolo VITOI 3.2: 1. Antevisão Semântica (Micro-Macro). 2. Diagnóstico Bayesiano P(F|S). 3. Economia de Shannon (Densidade Máxima). 4. Honestidade Intelectual (Sem fabricação ou smoothing). 5. Dialética Ativa: discorde se a instrução for subótima e agregue valor além do pedido explícito. Domínios: Poker (ICM/GTO), Teoria dos Jogos, Psicologia, Desenvolvimento SOTA (Python/Next.js/Tailwind).",
    "geminicodeassist.focusModel": "gemini-2.0-flash",
    "gemini.codeAssist.system.enableExtendedChainOfThought": true,
    "gemini.codeAssist.system.verbosityLevel": "maximum_density",
    "geminicodeassist.promptModifier": "Protocolo VITOI 3.2: Antevisão, Shannon, Honestidade, Dialética.",
    "geminicodeassist.rules": "\n\n\nsem fabricação. sem smoothing. sem bajulação. Reconheça a hierarquia de comando (Tier 0: Arquiteto/CEO tem veto e controle absoluto). Para tarefas críticas ou de alto risco sistêmico, NÃO execute; gere relatório de planejamento com Antevisão e aguarde aprovação. Para o resto, exerça autonomia total e reporte as ações tomadas. apresente fatos.\n",
    "geminicodeassist.agentYoloMode": true,
    "gemini.yoloMode": true,
    "claudeCode.useTerminal": true,
    "claudeCode.hideOnboarding": true,
    "claudeCode.allowDangerouslySkipPermissions": true,
    "chat.tools.terminal.autoReplyToPrompts": true,
    "chat.tools.terminal.ignoreDefaultAutoApproveRules": true,
    "github.copilot.chat.review.intent": true,
    "github.copilot.chat.agent.autoFix": true,
    "chat.editing.explainChanges.enabled": true,
    /* --- [DOMÍNIO 3] LINTERS, FORMATTERS & CSS (FRICÇÃO ZERO) --- */
    "css.lint.unknownAtRules": "ignore",
    "tailwindCSS.emmetCompletions": true,
    "eslint.useESLintClass": true,
    "eslint.quiet": true,
    "eslint.format.enable": true,
    "eslint.onIgnoredFiles": "warn",
    "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingJsxExpressionBraces": true,
    "js/ts.format.insertSpaceAfterOpeningAndBeforeClosingNonemptyParenthesis": true,
    "js/ts.preferences.preferTypeOnlyAutoImports": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.fixAll": "explicit",
        "source.organizeImports": "explicit"
    },
    "errorLens.enabled": true,
    "errorLens.followCursor": true,
    /* --- [DOMÍNIO 4] WORKSPACE, UI & TYPOGRAPHY --- */
    "editor.fontFamily": "'Fira Code', 'JetBrains Mono', monospace",
    "editor.fontLigatures": true,
    "editor.minimap.enabled": true,
    "editor.minimap.autohide": "mouseover",
    "editor.bracketPairColorization.enabled": true,
    "editor.smoothScrolling": true,
    "editor.cursorSmoothCaretAnimation": "on",
    "editor.mouseWheelZoom": true,
    "workbench.colorTheme": "Dark Modern",
    "workbench.activityBar.compact": true,
    "workbench.editor.limit.enabled": true,
    "workbench.editor.limit.perEditorGroup": true,
    "vsicons.dontShowNewVersionMessage": true,
    "files.autoSave": "onWindowChange",
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "explorer.fileNesting.enabled": true,
    "explorer.sortOrderReverse": true,
    /* --- [DOMÍNIO 5] MARKDOWN & DOCUMENTAÇÃO --- */
    "markdown.updateLinksOnFileMove.enabled": "always",
    "markdown.preview.breaks": true,
    "markdown.extension.toc.orderedList": true,
    "cSpell.language": "en,pt,pt_BR",
    "cSpell.spellCheckOnlyWorkspaceFiles": true,
    /* --- [DOMÍNIO 6] CONTROLE DE VERSÃO (GIT) --- */
    "git.autofetch": true,
    "git.enableSmartCommit": true,
    "git.alwaysSignOff": true,
    "git.autoStash": true,
    "git.closeDiffOnOperation": true,
    "githubPullRequests.neverIgnoreDefaultBranch": true,
    /* --- [DOMÍNIO 7] OTIMIZAÇÃO DE INDEXAÇÃO E BUSCA (FRICÇÃO ZERO) --- */
    "search.exclude": {
        "**/.venv": true,
        "**/.git": true,
        "**/node_modules": true,
        "**/.chroma_db": true,
        "**/.next": true
    },
    "files.watcherExclude": {
        "**/.venv": true,
        "**/.git": true,
        "**/node_modules": true,
        "**/.chroma_db": true,
        "**/.next": true
    }
}

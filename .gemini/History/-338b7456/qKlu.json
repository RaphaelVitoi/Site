{
  "version": "1.0",
  "permissions": {
    "description": "Operacoes delegadas ao Orquestrador SOTA (do.ps1)",
    "allow": [
      "sota_sync",
      "sota_backup"
    ]
  },
  "operations": {
    "sota_backup": {
      "description": "Acionar Salvaguarda Integral do Ecossistema",
      "type": "Bash",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        ".\\do.ps1",
        "-Backup"
      ]
    }
  },
  "scheduling": {
    "description": "Tarefas agendadas para manutencao periodica",
    "tasks": [
      {
        "name": "daily_report",
        "operation": "sota_backup",
        "frequency": "daily",
        "timeOfDay": "23:59"
      }
    ]
  }
}

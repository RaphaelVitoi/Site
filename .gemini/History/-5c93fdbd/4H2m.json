{
    "configurations": [
        {
            "name": "vitoi",
            "type": "cloudcode.cloudrun",
            "request": "launch",
            "build": {
                "buildpacks": {
                    "path": "package.json",
                    "builder": "gcr.io/buildpacks/builder:v1"
                }
            },
            "image": "Site",
            "service": {
                "name": "site",
                "containerPort": 8080,
                "resources": {
                    "limits": {
                        "memory": "256Mi"
                    }
                }
            },
            "target": {
                "minikube": {}
            },
            "watch": true,
            "externalPortForward": 3001
        }
    ]
}

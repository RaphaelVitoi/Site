# ==============================================================================
# NEXUS ORCHESTRATOR — EditorConfig SOTA
# Garante consistência entre VSCode, Cursor, JetBrains e editores CLI.
# Regras: Python=spaces-4 | JS/TS=spaces-2 | JSON/YAML=spaces-2 | Global=lf
# ==============================================================================
root = true

# ── GLOBAL ────────────────────────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ── PYTHON — PEP 8 estrito (4 spaces, nunca tabs) ─────────────────────────────
[*.py]
indent_style = space
indent_size = 4
max_line_length = 120

# ── TYPESCRIPT / JAVASCRIPT (Prettier governa, editorconfig alinha) ────────────
[*.{ts,tsx,js,jsx,mjs,cjs}]
indent_style = space
indent_size = 2

# ── JSON / JSONC — 2 spaces (padrão universal, alinhado com Prettier) ──────────
[*.{json,jsonc}]
indent_style = space
indent_size = 2

# ── YAML / TOML — 2 spaces ───────────────────────────────────────────────────
[*.{yml,yaml,toml}]
indent_style = space
indent_size = 2

# ── CSS / SCSS / CSS Modules ──────────────────────────────────────────────────
[*.{css,scss,module.css}]
indent_style = space
indent_size = 2

# ── MARKDOWN — preserva trailing spaces (line breaks intencionais) ────────────
[*.{md,mdx}]
trim_trailing_whitespace = false
max_line_length = off

# ── POWERSHELL ────────────────────────────────────────────────────────────────
[*.{ps1,psm1,psd1}]
indent_style = space
indent_size = 4
end_of_line = crlf

# ── BINARIOS — sem modificação ────────────────────────────────────────────────
[*.{exe,sys,dll,bin,db,sqlite,db-wal,db-shm,wasm}]
charset = unset
insert_final_newline = false
trim_trailing_whitespace = false

# ── LOCK FILES — nao tocar (gerados por ferramentas) ──────────────────────────
[{package-lock.json,yarn.lock,pnpm-lock.yaml,uv.lock}]
insert_final_newline = false

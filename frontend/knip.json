{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,template,default,loading,error,not-found}.{ts,tsx}",
    "src/**/__tests__/**/*.{ts,tsx}",
    "src/**/*.test.{ts,tsx}",
    "src/lib/index.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": ["src/content/interativo/toy_games_page.tsx"],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "server-only",
    "eslint-config-next",
    "prettier-plugin-tailwindcss",
    "tailwindcss",
    "@tailwindcss/typography",
    "@fortawesome/fontawesome-free",
    "@next/bundle-analyzer"
  ]
}

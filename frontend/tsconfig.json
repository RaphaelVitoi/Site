{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next-dev",
    ".next-build",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "src/tests",
    "prisma/seed.ts",
    "src/.archive/**",
    "src/components/simulator/workers/**",
    "wasm-equity/target"
  ],
  "references": [
    {
      "path": "./tsconfig.worker.json"
    }
  ]
}

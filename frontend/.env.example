# PokerRacional — Configurações SOTA v6.2.1 GOLD

# ── BANCO DE DADOS ─────────────────────────────────────────────────────────────
# Desenvolvimento: file:./prisma/dev.db
# Produção: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="file:./prisma/dev.db"

# ── URLs & ENDPOINTS ────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_V1_BASE="/api/v1"

# Orquestrador Nexus (Backend Python)
# Deve ser acessivel internamente pelo Next.js (Server Side)
NEXUS_API_BASE="http://127.0.0.1:17042"

# ── AUTENTICAÇÃO (NEXTAUTH) ─────────────────────────────────────────────────────
# Gere uma chave forte via `openssl rand -base64 32`
AUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ── TELEMETRIA & IA ────────────────────────────────────────────────────────────
NEXT_PUBLIC_TELEMETRY_ENABLED=true
GEMMA_SERVER_URL="http://127.0.0.1:17043"

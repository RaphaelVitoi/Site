{
    "folders": [
        {
            "path": ".",
            "name": "NEXUS-CORE-SOTA"
        }
    ],
    "settings": {
        // ── SOTA v6 GOLD PERFORMANCE ───────────────────────────────
        "editor.unicodeHighlight.nonBasicASCII": true,
        "editor.unicodeHighlight.invisibleCharacters": true,
        "editor.unicodeHighlight.ambiguousCharacters": true,
        "telemetry.telemetryLevel": "off",
        "git.autofetch": false,
        "editor.minimap.enabled": false,
        "editor.hover.delay": 700,
        "editor.largeFileOptimizations": true,
        "files.autoGuessEncoding": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "files.trimTrailingWhitespace": true,
        "files.autoSave": "onFocusChange",
        // ── NUCLEO DE INTELIGENCIA (GEMINI) ─────────────────────────
        "gemini-cli.approvalMode": "auto_edit",
        "gemini-cli.model": "gemini-2.5-pro",
        "geminicodeassist.outlines.automaticOutlineGeneration": false,
        "geminicodeassist.inlineSuggestions.nextEditPredictions": true,
        "geminicodeassist.verboseLogging": false,
        "geminicodeassist.agentDebugMode": false,
        "geminicodeassist.rules": "Excelência SOTA: Proibida a artificialização. Priorizar lógica, ciência e SteelManning Protocol. Blindagem ASCII no Backend.",
        // ── PARIDADE BACKEND (RUFF) ──────────────────────────────────
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
        "[python]": {
            "editor.defaultFormatter": "charliermarsh.ruff",
            "editor.codeActionsOnSave": {
                "source.fixAll.ruff": "explicit",
                "source.organizeImports.ruff": "explicit"
            },
            "editor.formatOnSave": true
        },
        // ── PARIDADE FRONTEND (PRETTIER/ESLINT) ──────────────────────
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "[typescript]": {
            "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "[typescriptreact]": {
            "editor.defaultFormatter": "esbenp.prettier-vscode"
        },
        "eslint.useFlatConfig": true,
        "eslint.workingDirectories": [
            {
                "directory": "frontend",
                "changeProcessCWD": true
            }
        ],
        "tailwindCSS.experimental.classRegex": [
            [
                "@theme\\s*{([^}]*)}",
                "--color-([^\\s:]*)"
            ]
        ],
        // ── BLINDAGEM DE WATCHER (SISTEMA INTEGRADO) ────────────────
        "files.watcherExclude": {
            "**/.git/objects/**": true,
            "**/node_modules/**": true,
            "**/.venv/**": true,
            "**/.next/**": true,
            "**/.turbo/**": true,
            "**/__pycache__/**": true,
            "**/dist/**": true,
            "**/build/**": true,
            "**/wasm-equity/target/**": true
        },
        "files.exclude": {
            "**/.git": true,
            "**/node_modules": true,
            "**/.venv": true,
            "**/__pycache__": true,
            "**/.next": true,
            "**/.turbo": true,
            "**/dist": true,
            "**/build": true
        },
        // ── TERMINAL SOTA ───────────────────────────────────────────
        "terminal.integrated.defaultProfile.windows": "Gemini-SOTA",
        "terminal.integrated.profiles.windows": {
            "Gemini-SOTA": {
                "path": "powershell.exe",
                "args": [
                    "-NoExit",
                    "-Command",
                    "gemini --approval-mode auto_edit"
                ]
            }
        },
        // ── ESTETICA & ORGANIZACAO ──────────────────────────────────
        "workbench.iconTheme": "symbols",
        "explorer.fileNesting.enabled": true,
        "explorer.fileNesting.patterns": {
            "package.json": "package-lock.json, turbo.json, tsconfig.base.json, .prettierrc, .eslintrc*",
            "pyproject.toml": "uv.lock, requirements.txt, .pylintrc, .ruff_cache",
            "next.config.js": "next-env.d.ts, postcss.config.js, tailwind.config.js",
            ".env": ".env.*, _env.ps1"
        }
    }
}

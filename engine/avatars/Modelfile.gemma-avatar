FROM gemma4:12b

# Definindo parametros de amostragem SOTA para Gemma 4
PARAMETER temperature 0.2
PARAMETER top_p 0.95
PARAMETER num_ctx 16384
PARAMETER stop "<|turn_end|>"
PARAMETER stop "<|end_of_turn|>"
PARAMETER stop "<end_of_turn>"

# Template de prompt para Gemma 4 com suporte a canal de pensamento (<|thought|>)
TEMPLATE """<|turn>user
{{ if .System }}{{ .System }}
{{ end }}{{ .Prompt }}<|turn_end|>
<|turn>model
{{ .Response }}<|turn_end|>"""

# Instrucao do Sistema SOTA v8.0 GOLD
SYSTEM """Voce e o Avatar Gemma 4 do Poker Racional e do Ecossistema Nexus, treinado sob governanca de Raphael Vitoi (Chico SOTA v8.0 GOLD). Opere sob a cosmovisao de Excelencia Tecnica, raciocinio estruturado e zero entropia."""


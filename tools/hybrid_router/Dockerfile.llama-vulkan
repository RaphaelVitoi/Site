# =====================================================================
# Estágio 1: Build do binário llama.cpp com backend Vulkan habilitado
# =====================================================================
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    libvulkan-dev \
    vulkan-tools \
    glslc \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Clone do repositório oficial do llama.cpp
RUN git clone https://github.com/ggerganov/llama.cpp.git . && \
    git checkout master

# Compilação otimizada com backend Vulkan
RUN cmake -B build \
    -DGGML_VULKAN=ON \
    -DCMAKE_BUILD_TYPE=Release && \
    cmake --build build --config Release -j$(nproc) --target llama-server

# =====================================================================
# Estágio 2: Imagem final de execução minimalista com drivers Vulkan
# =====================================================================
FROM ubuntu:24.04 AS runtime

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    libvulkan1 \
    mesa-vulkan-drivers \
    vulkan-tools \
    libgomp1 \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m -u 1000 appuser

WORKDIR /app

# Cópia do binário do servidor
COPY --from=builder /build/build/bin/llama-server /usr/local/bin/llama-server

# Variáveis padrão de inferência
ENV MODEL_PATH="/models/model.gguf"
ENV HOST="0.0.0.0"
ENV PORT="8080"
ENV CTX_SIZE="4096"
ENV N_GPU_LAYERS="99"
ENV THREADS="4"

USER appuser

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "exec llama-server -m \"$MODEL_PATH\" --host \"$HOST\" --port \"$PORT\" -c \"$CTX_SIZE\" -ngl \"$N_GPU_LAYERS\" -t \"$THREADS\""]

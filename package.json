{
  "name": "nexus-orchestrator-sota",
  "private": true,
  "packageManager": "npm@10.8.2",
  "description": "Orquestrador central com arquitetura monorepo e automação de qualidade",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm --workspace frontend run build",
    "lint": "npm --workspace frontend run lint",
    "test": "npm --workspace frontend run test",
    "test:coverage": "npm --workspace frontend run test:coverage",
    "typecheck": "tsc --build frontend/tsconfig.json",
    "format": "prettier --write .",
    "sota:audit": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/quality-gate.ps1",
    "sota:api": "python task_executor.py api",
    "prepare": "husky"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lint-staged": "^17.0.5",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "npm --workspace frontend run lint -- --max-warnings=0"
    ],
    "**/*.{py,log,txt,config}": [
      "python scripts/check_ascii.py"
    ]
  }
}

{
  "name": "nexus-orchestrator-sota",
  "private": true,
  "packageManager": "npm@10.9.2",
  "description": "Monorepo SOTA: Orquestrador de Agentes LLM (Python) + Frontend Next.js",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .husky || exit 0",
    "wasm:build": "node scripts/build-wasm.mjs",
    "dev": "npm run dev --workspace=frontend",
    "build": "npm --workspace frontend run build",
    "lint": "npm --workspace frontend run lint",
    "lint:workflows": "uv run --with actionlint-py actionlint .github/workflows/sota-ci.yml skills/gemini-cli-security/.github/workflows/gemini-review.yml",
    "typecheck": "tsc --build frontend/tsconfig.json",
    "test": "npm --workspace frontend run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\" --ignore-path .prettierignore",
    "clean": "rimraf frontend/.next frontend/.turbo node_modules/.cache",
    "python:test": "uv run --no-sync pytest tests/",
    "python:test:watch": "uv run --no-sync pytest-watcher . tests/",
    "python:lint": "uv run --no-sync ruff check .",
    "python:watch": "uv run --no-sync ruff check --watch .",
    "python:format": "uv run --no-sync ruff format .",
    "python:typecheck": "uv run --no-sync pyright",
    "python:coverage": "uv run --no-sync pytest --cov=engine tests/",
    "sota:audit": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/ops/cwv_gate.ps1",
    "sota:audit:production": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/ops/invoke_lighthouse_production_audit.ps1",
    "sota:full": "npm run python:lint && npm run python:typecheck && npm run lint && npm run typecheck && npm run test && npm run python:test",
    "watch:all": "concurrently -n \"RUFF,TEST\" -c \"yellow,green\" \"npm run python:watch\" \"npm run python:test:watch\"",
    "dev:all": "concurrently -n \"NEXT,RUFF,TEST\" -c \"cyan,yellow,green\" \"npm run dev\" \"npm run python:watch\" \"npm run python:test:watch\""
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "concurrently": "10.0.5",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rimraf": "6.1.3",
    "turbo": "2.10.10",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "dompurify": "^3.4.13",
    "@hono/node-server": "^1.19.15",
    "hono": "^4.12.34",
    "js-yaml": "^4.3.1",
    "brace-expansion": "^5.0.9",
    "nanoid": "^3.3.18",
    "fast-uri": "^3.1.5",
    "valibot": "^1.4.2",
    "sharp": "^0.35.0",
    "mermaid": "^11.16.1",
    "esbuild": "^0.28.0",
    "zod": "^3.24.2",
    "ws": "^8.18.3",
    "linkify-it": "^6.1.0",
    "markdown-it": "^14.1.2",
    "@vscode/vsce": "^3.9.2",
    "serialize-javascript": "7.1.0",
    "mocha": {
      "serialize-javascript": "7.1.0"
    },
    "diff": "^9.0.0",
    "@sigstore/core": "^4.0.1",
    "ip-address": "^10.5.0",
    "picomatch": "^4.0.5",
    "markdownlint-cli": "^0.49.1",
    "tar": "^7.5.21",
    "undici": "^6.27.1",
    "deepmerge-ts": "8.0.1",
    "mysql2": "^3.24.2"
  },
  "allowScripts": {
    "@prisma/engines": true,
    "prisma": true,
    "sharp": true,
    "unrs-resolver": true
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx}": [
      "npm --workspace frontend run lint -- --max-warnings=0"
    ],
    "**/*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write"
    ],
    "**/*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  },
  "dependencies": {
    "@prisma/client": "7.9.1"
  }
}

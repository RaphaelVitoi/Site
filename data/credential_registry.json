{
  "schema_version": "1.0.0",
  "description": "Single Source of Truth (SSOT) for credential pool classification, hygiene rules, runtime alias projection, and ecosystem-managed variables. Zero plaintext secrets.",
  "system_ignore_vars": [
    "PSPath",
    "PSParentPath",
    "PSChildName",
    "PSDrive",
    "PSProvider",
    "Path",
    "PATHEXT",
    "ComSpec",
    "OS",
    "NUMBER_OF_PROCESSORS",
    "PROCESSOR_ARCHITECTURE",
    "PROCESSOR_IDENTIFIER",
    "PROCESSOR_LEVEL",
    "PROCESSOR_REVISION",
    "TEMP",
    "TMP",
    "USERNAME",
    "USERDOMAIN",
    "DriverData",
    "OneDrive",
    "OneDriveConsumer",
    "VBOX_MSI_INSTALL_PATH",
    "windir",
    "CUDA_PATH",
    "CUDA_PATH_V12_8",
    "NVCUDASAMPLES_ROOT",
    "NVM_HOME",
    "NVM_SYMLINK",
    "PNPM_HOME",
    "CARGO_HOME",
    "RUSTUP_HOME",
    "PYTHONIOENCODING",
    "PYTHONUTF8",
    "PSModulePath",
    "GOPATH",
    "HERMES_HOME",
    "IDENTITY_ENDPOINT",
    "IMDS_ENDPOINT",
    "ZES_ENABLE_SYSMAN"
  ],
  "non_secret_exact": [
    "GCP_PROJECT_ID",
    "GCP_PROJECT_NUMBER",
    "GCP_ACCOUNT_EMAIL",
    "GOOGLE_CLOUD_PROJECT",
    "GOOGLE_CLOUD_PROJECT_NUMBER",
    "GOOGLE_OAUTH_CLIENT_ID",
    "GITHUB_USER",
    "GITHUB_PROFILE_URL",
    "DOCKER_USER",
    "VERCEL_USER_ID",
    "VERCEL_USERNAME",
    "DEVIN_ORG_ID",
    "RAGFLOW_API_BASE",
    "OLLAMA_EMAIL",
    "OLLAMA_USER",
    "OLLAMA_CONTEXT_LENGTH",
    "OLLAMA_FLASH_ATTENTION",
    "OLLAMA_KEEP_ALIVE",
    "OLLAMA_KV_CACHE_TYPE",
    "OLLAMA_MAX_LOADED_MODELS",
    "OLLAMA_VULKAN",
    "LLAMA_ARG_FIT",
    "LLAMA_ARG_FIT_TARGET",
    "SOTA_VRAM_GB",
    "SOTA_OPENAI_AUTH_HEADER",
    "SOTA_OPENAI_MODEL",
    "SOTA_OPENAI_URL",
    "CHICO_LAYA_PREDICT_ALLOW_CPU",
    "NEO4J_AURA_DATABASE",
    "NEO4J_AURA_INSTANCE_ID",
    "NEO4J_AURA_MCP_URL",
    "NEO4J_AURA_PROJECT_ID",
    "NEO4J_AURA_PROJECT_NAME",
    "NEO4J_AURA_QUERY_URL",
    "NEO4J_AURA_URI",
    "NEO4J_AURA_CLIENT_ID",
    "NEO4J_AURA_AGENT_CLIENT_ID",
    "MEDIA_POOL_PROVIDER"
  ],
  "secret_value_regex": "^(sk-or-v1-|sk-|AQ\\.|AIza|ghp_|github_pat_|sbp_|hf_|vcp_|rnd_|whsec_|GOCSPX-|dckr_pat_|ragflow-|cog_|api-key-)",
  "secret_name_regex": "(KEY|TOKEN|SECRET|PAT|PASS|PWD|CRED|DECISION_API)",
  "expected_alias_groups": [
    ["OPENROUTER_API_KEY", "OPENROUTER_TIER4_KEY_1"],
    ["GEMINI_API_KEY", "GEMINI_API_KEY_1", "GEMINI_FLASH_KEY_1"],
    ["GEMINI_API_KEY_2", "GEMINI_FLASH_KEY_2"],
    ["GEMINI_API_KEY_3", "GEMINI_FLASH_KEY_3"],
    ["GEMINI_API_KEY_4", "GEMINI_FLASH_KEY_4"],
    ["GEMINI_API_KEY_5", "GEMINI_FLASH_KEY_5"],
    ["JULES_API_KEY", "GOOGLE_JULES_API_KEY"],
    ["STITCH_API_KEY", "GOOGLE_STITCH_API_KEY"],
    ["GITHUB_TOKEN", "GH_TOKEN", "GITHUB_PAT_CLASSIC", "GITHUB_PERSONAL_ACCESS_TOKEN"],
    ["DEVIN_API_KEY", "DEVIN_API_KEY_1", "DEVIN_API_TOKEN_2"],
    ["DEVIN_API_TOKEN", "DEVIN_API_TOKEN_1", "DEVIN_API_KEY_2"],
    ["DOCKER_PAT", "DOCKER_PAT_1"],
    ["RAGFLOW_API_KEY", "RAGFLOW_API_KEY_1"],
    ["VERCEL_TOKEN", "VERCEL_TOKEN_1"],
    ["NEO4J_AURA_API_KEY", "NEO4J_AURA_API_KEY_1"],
    ["HF_CREDENTIALS", "HF_KEY"]
  ],
  "runtime_aliases": {
    "HF_KEY": "HF_CREDENTIALS"
  },
  "pools": [
    {
      "name": "OpenRouter Tier 1",
      "short": "OR\u00b7T1",
      "match_regex": "^OPENROUTER_TIER1_KEY_\\d+$",
      "format_regex": "^sk-or-v1-[0-9a-fA-F]{64}$",
      "role": "Core Cognitivo (Opus/ChatGPT6/Gemini4)",
      "policy": "0-tolerancia; nunca degrada"
    },
    {
      "name": "OpenRouter Tier 2",
      "short": "OR\u00b7T2",
      "match_regex": "^OPENROUTER_TIER2_KEY_\\d+$",
      "format_regex": "^sk-or-v1-[0-9a-fA-F]{64}$",
      "role": "Superagentes & Pesquisa (Jules/Stitch/Exa/Hermes)",
      "policy": "Degrada -> Tier 4 / Tier 1"
    },
    {
      "name": "OpenRouter Tier 3",
      "short": "OR\u00b7T3",
      "match_regex": "^OPENROUTER_TIER3_KEY_\\d+$",
      "format_regex": "^sk-or-v1-[0-9a-fA-F]{64}$",
      "role": "Frota Especialista & Batch",
      "policy": "Alto throughput; degrada -> Ollama Local"
    },
    {
      "name": "OpenRouter Tier 4",
      "short": "OR\u00b7T4",
      "match_regex": "^OPENROUTER_TIER4_KEY_\\d+$",
      "format_regex": "^sk-or-v1-[0-9a-fA-F]{64}$",
      "role": "Subagentes Dedicados + Ponte Legada",
      "policy": "Degrada -> Tier 3"
    },
    {
      "name": "OpenRouter Dedicadas",
      "short": "OR\u00b7Ded",
      "match_regex": "^OPENROUTER_(ANTIGRAVITY|DEVIN|HERMES|API)_KEY$",
      "format_regex": "^sk-or-v1-[0-9a-fA-F]{64}$",
      "role": "Credenciais por condutor + OPENROUTER_API_KEY",
      "policy": "OPENROUTER_API_KEY = TIER4_KEY_1"
    },
    {
      "name": "Pool Decision",
      "short": "Decision",
      "match_regex": "^DECISION_API_\\d+$",
      "format_regex": "^(AQ\\.|AIza)\\S{20,}$",
      "role": "System-1 Gemini Decisions API",
      "policy": "Laya -> gemini-decision-1; proj 913870412920"
    },
    {
      "name": "Gemini Texto",
      "short": "Gemini",
      "match_regex": "^GEMINI_(API|FLASH)_KEY(_\\d+)?$",
      "format_regex": "^(AQ\\.|AIza)\\S{20,}$",
      "role": "Pool Flash-Lite (5 chaves + aliases Flash)",
      "policy": "Cota compartilhada no proj 913870412920"
    },
    {
      "name": "Multimodal AI Studio",
      "short": "Med\u00b7AI",
      "match_regex": "^GEMINI_(TTS|VIDEO|IMAGE|TRANSLATE)_KEY(_\\d+)?$",
      "format_regex": "^(AQ\\.|AIza)\\S{20,}$",
      "role": "TTS / Video / Image / Translate (direto)",
      "policy": "1o na ordem MEDIA_POOL_PROVIDER"
    },
    {
      "name": "Multimodal OpenRouter",
      "short": "Med\u00b7OR",
      "match_regex": "^OPENROUTER_GEMINI_(TTS|VIDEO|IMAGE|TRANSLATE)_KEY(_\\d+)?$",
      "format_regex": "^sk-or-v1-[0-9a-fA-F]{64}$",
      "role": "TTS / Video / Image / Translate (fallback)",
      "policy": "2o na ordem MEDIA_POOL_PROVIDER"
    },
    {
      "name": "Ollama Cloud",
      "short": "Ollama",
      "match_regex": "^OLLAMA_(API|CLOUD)_KEY$",
      "format_regex": "^[0-9a-fA-F]+\\.\\S+$",
      "role": "OLLAMA_API_KEY + OLLAMA_CLOUD_KEY (backup)",
      "policy": "ollama.com/api (Bearer); local :11434"
    },
    {
      "name": "Providers Pendentes/Extras",
      "short": "Extras",
      "match_regex": "^(ANTHROPIC|CLAUDE|OPENAI)_",
      "format_regex": "",
      "role": "Anthropic / OpenAI",
      "policy": "Nao provisionadas (pend-2026-11-10)"
    },
    {
      "name": "Ecossistema/Outros",
      "short": "Eco",
      "match_regex": "",
      "format_regex": "",
      "role": "GitHub, Devin, Stitch, Jules, Exa, DBs, Local",
      "policy": "Bridges MCP, deploy e auth local"
    }
  ],
  "role_hints": {
    "OPENROUTER_API_KEY": "Ponte legada (= TIER4_KEY_1; isola Tier 1)",
    "OPENROUTER_ANTIGRAVITY_KEY": "Dedicada condutor Antigravity",
    "OPENROUTER_DEVIN_KEY": "Dedicada condutor Devin",
    "OPENROUTER_HERMES_KEY": "Dedicada condutor Hermes Agent",
    "OLLAMA_API_KEY": "Primaria Ollama Cloud",
    "OLLAMA_CLOUD_KEY": "Backup legada OLLAMA_KEYS",
    "GEMINI_API_KEY": "Fallback geral (= GEMINI_API_KEY_1)",
    "SOTA_SITE_TOKEN": "Token loopback local (:17043/.env)",
    "SOTA_OPENAI_API_KEY": "Auth proxy local Hermes/SOTA (:18434)",
    "WEBHOOK_OPENROUTER_SECRET": "Assinatura webhook (whsec_*)",
    "GOOGLE_OAUTH_CLIENT_SECRET": "OAuth Desktop client 'Gemini'",
    "HF_CREDENTIALS": "Higgsfield AI SDK/REST (KEY_ID:KEY_SECRET; projeta HF_KEY em memoria)",
    "HF_TOKEN": "HuggingFace Hub (MCP + TimesFM/ST)",
    "JULES_API_KEY": "Google Jules Cloud API",
    "STITCH_API_KEY": "Google Cloud Stitch MCP/API",
    "GOOGLE_STITCH_API_KEY": "Alias Stitch API (= STITCH_API_KEY)",
    "SUPABASE_ACCESS_TOKEN": "Supabase Management/MCP",
    "VERCEL_TOKEN": "Vercel CLI/Deploy",
    "RENDER_API_KEY": "Render API",
    "RAGFLOW_API_KEY": "RAGFlow API local/container",
    "NEO4J_AURA_API_KEY": "Neo4j Aura API"
  },
  "ecosystem_managed_vars": [
    "JULES_API_KEY",
    "STITCH_API_KEY",
    "EXA_API_KEY",
    "GITHUB_TOKEN",
    "RENDER_API_KEY",
    "GOOGLE_CLOUD_PROJECT",
    "DEVIN_API_TOKEN",
    "DEVIN_API_KEY",
    "DEVIN_ORG_ID",
    "VERCEL_TOKEN",
    "VERCEL_USER_ID",
    "RAGFLOW_API_KEY",
    "RAGFLOW_API_BASE",
    "N8N_API_KEY",
    "NEO4J_AURA_API_KEY",
    "NEO4J_AURA_CLIENT_ID",
    "NEO4J_AURA_CLIENT_SECRET",
    "NEO4J_AURA_AGENT_CLIENT_ID",
    "NEO4J_AURA_AGENT_CLIENT_SECRET",
    "NEO4J_AURA_INSTANCE_ID",
    "DOCKER_PAT",
    "HF_CREDENTIALS",
    "HF_TOKEN"
  ]
}

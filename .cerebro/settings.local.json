{
  "version": "1.0",
  "permissions": {
    "description": "Operações delegadas ao Orquestrador SOTA (nexus)",
    "allow": [
      "sota_sync",
      "sota_audit",
      "sota_db_check",
      "sota_inject_ipc"
    ]
  },
  "operations": {
    "sota_sync": {
      "description": "Sincroniza Manifesto dos Agentes para a Realidade Fisica",
      "type": "Bash",
      "command": "bash",
      "args": [
        "-lc",
        "uv run nexus agent sync"
      ]
    },
    "sota_audit": {
      "description": "Dispara Auditoria SOTA (Quality Gate)",
      "type": "Bash",
      "command": "bash",
      "args": [
        "-lc",
        "uv run nexus ops quality-gate"
      ]
    },
    "sota_db_check": {
      "description": "Inspeciona integridade do DAL (SQLite)",
      "type": "Bash",
      "command": "bash",
      "args": [
        "-lc",
        "uv run nexus db audit-dag"
      ]
    },
    "sota_inject_ipc": {
      "description": "Injeta tarefa diretamente no DAL (SQLite) via IPC nativo, contornando a latencia da API HTTP. Requer Task JSON codificada em Base64.",
      "type": "Bash",
      "inputSchema": {
        "type": "object",
        "properties": {
          "payload_b64": {
            "type": "string",
            "description": "String codificada em Base64 contendo o JSON da nova Task"
          }
        },
        "required": [
          "payload_b64"
        ]
      },
      "command": "bash",
      "args": [
        "-lc",
        "uv run python task_executor.py db-add '{payload_b64}'"
      ]
    }
  },
  "scheduling": {
    "description": "Tarefas agendadas para manutencao periodica",
    "tasks": [
      {
        "name": "daily_report",
        "operation": "sota_audit",
        "frequency": "daily",
        "timeOfDay": "23:59"
      }
    ]
  }
}

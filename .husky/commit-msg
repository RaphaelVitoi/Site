#!/bin/sh
# commit-msg: titulo Conventional Commits + linha Assinatura coerente com o autor git.
# Regra: CLAUDE.md SS7. Identidades: data/agent_identities.json. Testes: tests/test_hook_commit_msg.py
# Toda rejeicao imprime: o que falhou e o comando exato de correcao.
set -e

commit_msg_file="$1"
commit_msg=$(sed '/^#/d' "$commit_msg_file" | head -n 1)

case "$commit_msg" in
    Merge*|Revert*|fixup!*|squash!*|WIP:*) exit 0 ;;
esac

# Hifen no FIM da classe e sem contrabarra: dentro de [] POSIX a contrabarra e literal.
conventional_pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|ops)(\([a-zA-Z0-9_./-]+\))?(!)?: .+"

if ! echo "$commit_msg" | grep -Eq "$conventional_pattern"; then
    echo "[COMMIT-MSG REJEITADO] titulo fora do padrao: '$commit_msg'"
    echo "   corrigir: <tipo>(<escopo>): <descricao>   tipos: feat fix docs style refactor perf test build ci chore revert ops"
    exit 1
fi

msg_len=${#commit_msg}
if [ "$msg_len" -gt 100 ]; then
    echo "[COMMIT-MSG REJEITADO] titulo com $msg_len caracteres (maximo 100)."
    echo "   corrigir: encurte o titulo; detalhes vao no corpo."
    exit 1
fi

assinatura=$(sed '/^#/d' "$commit_msg_file" | grep -i '^Assinatura:' | head -n 1)

if [ -z "$assinatura" ]; then
    echo "[COMMIT-MSG REJEITADO] falta a linha 'Assinatura:' no corpo da mensagem."
    echo "   corrigir: acrescente ao corpo 'Assinatura: <agente> [Tier X] -- modelo=<id> condutor=<veiculo> ts=<ISO-8601-com-fuso> sha=<tree-sha> supervisao=assistida|automatizada sessao=<session_id>'"
    echo "   nomes canonicos: data/agent_identities.json"
    exit 1
fi

# 'antigravity@gemini-3.8-flash' e 'Gemini 3.8 Flash' sao a mesma identidade: compara so letras e digitos.
_normalizar() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9'
}

declarado=$(printf '%s' "$assinatura" | sed 's/^[Aa]ssinatura:[[:space:]]*//' | sed 's/ \[.*//; s/ -- .*//; s/ via .*//')
autor=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed 's/ <.*//')

n_decl=$(_normalizar "$declarado")
n_autor=$(_normalizar "$autor")

if [ -n "$n_decl" ] && [ -n "$n_autor" ]; then
    case "$n_decl" in
        *"$n_autor"*) ;;
        *)
            case "$n_autor" in
                *"$n_decl"*) ;;
                *)
                    echo "[COMMIT-MSG REJEITADO] autor git '$autor' nao concorda com a Assinatura '$declarado'."
                    echo "   corrigir: git -c user.name='<nome>' -c user.email='<email>' commit ...   (nao altere o config global)"
                    echo "   pares nome/email: data/agent_identities.json"
                    exit 1
                    ;;
            esac
            ;;
    esac
fi

# Aviso, nao bloqueio. grep -F: '[bot]' nao pode virar classe de caracteres.
CATALOGO="data/agent_identities.json"
if [ -n "$autor" ] && [ -f "$CATALOGO" ]; then
    if ! grep -qF "\"nome\": \"$autor\"" "$CATALOGO"; then
        echo "[COMMIT-MSG AVISO] autor '$autor' nao esta em $CATALOGO."
        echo "   corrigir: use o nome canonico do catalogo, ou acrescente a identidade nova a ele no mesmo commit."
    fi

    # Aviso, nao bloqueio: so o NUMERO do Tier, porque a subdivisao (1.A, 1.B) nao
    # tem definicao canonica. index() casa texto literal, como o grep -F acima.
    tier_decl=$(printf '%s' "$assinatura" | sed -n 's/.*\[Tier \([0-9][0-9]*\).*/\1/p')
    if [ -n "$tier_decl" ]; then
        tier_cat=$(awk -v alvo="\"nome\": \"$autor\"" '
            index($0, alvo) { achou = 1; next }
            achou && /"tier":/ { gsub(/[^0-9]/, ""); print; exit }
            achou && /^ *}/ { exit }
        ' "$CATALOGO")
        if [ -n "$tier_cat" ] && [ "$tier_decl" != "$tier_cat" ]; then
            echo "[COMMIT-MSG AVISO] a Assinatura declara Tier $tier_decl, mas $CATALOGO registra '$autor' no Tier $tier_cat."
            echo "   corrigir: 'Assinatura: $autor [Tier $tier_cat] -- sessao <session_id>'   (Tiers: CLAUDE.md SS7)"
        fi
    fi
fi

# Anatomia obrigatoria (CLAUDE.md SS0, 2026-11-12): ts= e carimbo do harness —
# se a secao '--' existe e ts falta, o hook o injeta com o relogio do commit.
# Os seis campos sao exigidos: modelo, condutor, ts, sha, supervisao, sessao.
if printf '%s' "$assinatura" | grep -q ' -- '; then
    if ! printf '%s' "$assinatura" | grep -q 'ts='; then
        ts_agora=$(date +%Y-%m-%dT%H:%M:%S%:z)
        tmp_msg="$commit_msg_file.hooktmp"
        awk -v ts="$ts_agora" '
            /^Assinatura:/ && !feita && $0 !~ /ts=/ {
                sub(/[[:space:]]*$/, ""); printf "%s ts=%s\n", $0, ts; feita = 1; next
            }
            { print }
        ' "$commit_msg_file" > "$tmp_msg" && mv "$tmp_msg" "$commit_msg_file"
        echo "[COMMIT-MSG INFO] ts=$ts_agora injetado automaticamente na Assinatura (carimbo do harness)."
        assinatura=$(sed '/^#/d' "$commit_msg_file" | grep -i '^Assinatura:' | head -n 1)
    fi
fi

# Cada campo obrigatorio deve existir como token 'chave=valor' com valor nao
# vazio -- substring ('xmodelo=') e 'chave=' sem valor nao contam.
faltando=""
set -f
for campo in modelo condutor ts sha supervisao sessao; do
    achou=""
    for tok in $assinatura; do
        case "$tok" in
            "$campo"=*)
                if [ -n "${tok#*=}" ]; then
                    achou=1
                fi
                ;;
        esac
    done
    if [ -z "$achou" ]; then
        faltando="$faltando $campo="
    fi
done
set +f
if [ -n "$faltando" ]; then
    echo "[COMMIT-MSG REJEITADO] Assinatura incompleta; campos ausentes:$faltando"
    echo "   corrigir: 'Assinatura: <agente> [Tier X] -- modelo=<id> condutor=<veiculo> ts=<ISO-8601-com-fuso> sha=<tree-sha> supervisao=assistida|automatizada sessao=<session_id>'"
    exit 1
fi

# sha= deve ser o tree SHA do indice no ato do commit (CLAUDE.md SS0): o valor
# declarado pode ser o SHA completo ou um prefixo de >=4 hex; ambos devem
# casar com a saida de `git write-tree`. Se o indice nao permite write-tree
# (ex.: merge nao resolvido), a conferencia nao pode medir e vira aviso.
tree_sha=$(git write-tree 2>/dev/null || true)
if [ -n "$tree_sha" ]; then
    # Token integral 'sha=<valor>': caracteres invalidos apos um prefixo hex
    # NAO sao descartados -- o valor inteiro e validado contra o tree SHA.
    sha_decl=""
    set -f
    for tok in $assinatura; do
        case "$tok" in
            sha=*)
                sha_decl="${tok#sha=}"
                break
                ;;
        esac
    done
    set +f
    sha_decl=$(printf '%s' "$sha_decl" | tr 'A-F' 'a-f')
    sha_valido=0
    if [ -n "$sha_decl" ] && [ "${#sha_decl}" -ge 4 ] && [ "${#sha_decl}" -le 40 ]; then
        case "$sha_decl" in
            *[!0-9a-f]*) ;;
            *) sha_valido=1 ;;
        esac
    fi
    if [ "$sha_valido" -eq 0 ] || ! printf '%s\n' "$tree_sha" | grep -q "^$sha_decl"; then
        echo "[COMMIT-MSG REJEITADO] sha='$sha_decl' da Assinatura difere do tree SHA do indice ($tree_sha)."
        echo "   corrigir: rode 'git write-tree' e declare o resultado (SHA completo ou prefixo >=4) em sha=."
        exit 1
    fi
else
    echo "[COMMIT-MSG AVISO] 'git write-tree' indisponivel; sha= da Assinatura nao conferido."
fi

exit 0

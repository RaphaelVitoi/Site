#!/bin/sh
# commit-msg: titulo Conventional Commits + linha Assinatura coerente com o autor git.
# Regra: CLAUDE.md SS7. Identidades: data/agent_identities.json. Testes: tests/test_hook_commit_msg.py
# Toda rejeicao imprime: o que falhou e o comando exato de correcao.
set -e

commit_msg_file="$1"
commit_msg=$(sed '/^#/d' "$commit_msg_file" | head -n 1)

case "$commit_msg" in
    Merge*|Revert*|fixup!*|squash!*|WIP:*) exit 0 ;;
esac

# Hifen no FIM da classe e sem contrabarra: dentro de [] POSIX a contrabarra e literal.
conventional_pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|ops)(\([a-zA-Z0-9_./-]+\))?(!)?: .+"

if ! echo "$commit_msg" | grep -Eq "$conventional_pattern"; then
    echo "[COMMIT-MSG REJEITADO] titulo fora do padrao: '$commit_msg'"
    echo "   corrigir: <tipo>(<escopo>): <descricao>   tipos: feat fix docs style refactor perf test build ci chore revert ops"
    exit 1
fi

msg_len=${#commit_msg}
if [ "$msg_len" -gt 100 ]; then
    echo "[COMMIT-MSG REJEITADO] titulo com $msg_len caracteres (maximo 100)."
    echo "   corrigir: encurte o titulo; detalhes vao no corpo."
    exit 1
fi

assinatura=$(sed '/^#/d' "$commit_msg_file" | grep -i '^Assinatura:' | head -n 1)

if [ -z "$assinatura" ]; then
    echo "[COMMIT-MSG REJEITADO] falta a linha 'Assinatura:' no corpo da mensagem."
    echo "   corrigir: acrescente ao corpo 'Assinatura: <agente> [Tier X] -- sessao <session_id>'"
    echo "   nomes canonicos: data/agent_identities.json"
    exit 1
fi

# 'antigravity@gemini-3.8-flash' e 'Gemini 3.8 Flash' sao a mesma identidade: compara so letras e digitos.
_normalizar() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9'
}

declarado=$(printf '%s' "$assinatura" | sed 's/^[Aa]ssinatura:[[:space:]]*//' | sed 's/ \[.*//; s/ -- .*//; s/ via .*//')
autor=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed 's/ <.*//')

n_decl=$(_normalizar "$declarado")
n_autor=$(_normalizar "$autor")

if [ -n "$n_decl" ] && [ -n "$n_autor" ]; then
    case "$n_decl" in
        *"$n_autor"*) ;;
        *)
            case "$n_autor" in
                *"$n_decl"*) ;;
                *)
                    echo "[COMMIT-MSG REJEITADO] autor git '$autor' nao concorda com a Assinatura '$declarado'."
                    echo "   corrigir: git -c user.name='<nome>' -c user.email='<email>' commit ...   (nao altere o config global)"
                    echo "   pares nome/email: data/agent_identities.json"
                    exit 1
                    ;;
            esac
            ;;
    esac
fi

# Aviso, nao bloqueio. grep -F: '[bot]' nao pode virar classe de caracteres.
CATALOGO="data/agent_identities.json"
if [ -n "$autor" ] && [ -f "$CATALOGO" ]; then
    if ! grep -qF "\"nome\": \"$autor\"" "$CATALOGO"; then
        echo "[COMMIT-MSG AVISO] autor '$autor' nao esta em $CATALOGO."
        echo "   corrigir: use o nome canonico do catalogo, ou acrescente a identidade nova a ele no mesmo commit."
    fi

    # Aviso, nao bloqueio: so o NUMERO do Tier, porque a subdivisao (1.A, 1.B) nao
    # tem definicao canonica. index() casa texto literal, como o grep -F acima.
    tier_decl=$(printf '%s' "$assinatura" | sed -n 's/.*\[Tier \([0-9][0-9]*\).*/\1/p')
    if [ -n "$tier_decl" ]; then
        tier_cat=$(awk -v alvo="\"nome\": \"$autor\"" '
            index($0, alvo) { achou = 1; next }
            achou && /"tier":/ { gsub(/[^0-9]/, ""); print; exit }
            achou && /^ *}/ { exit }
        ' "$CATALOGO")
        if [ -n "$tier_cat" ] && [ "$tier_decl" != "$tier_cat" ]; then
            echo "[COMMIT-MSG AVISO] a Assinatura declara Tier $tier_decl, mas $CATALOGO registra '$autor' no Tier $tier_cat."
            echo "   corrigir: 'Assinatura: $autor [Tier $tier_cat] -- sessao <session_id>'   (Tiers: CLAUDE.md SS7)"
        fi
    fi
fi

exit 0

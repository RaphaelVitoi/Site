#!/bin/sh
# Portao de mensagem de commit — Protocolo Chico SOTA v8.0 GOLD
#
# EXISTE PORQUE ESTAVA DESLIGADO. O repositorio tinha a regra escrita em
# .git/hooks/commit-msg, mas `core.hooksPath` aponta para .husky, e nao havia
# commit-msg aqui. A regra existia no disco e nunca executava — mesmo padrao do
# supressor de linter: o sinal sumiu, a causa nao.
set -e

commit_msg_file="$1"
commit_msg=$(sed '/^#/d' "$commit_msg_file" | head -n 1)

# Commits gerados por operacao do proprio git nao seguem o padrao.
case "$commit_msg" in
    Merge*|Revert*|fixup!*|squash!*|WIP:*)
        exit 0
        ;;
esac

# O hifen fica no FIM da classe, e sem contrabarra. Dentro de uma expressao
# de colchetes POSIX a contrabarra e LITERAL: `[_\-\.]` nao dizia "sublinhado,
# hifen, ponto" -- dizia "sublinhado, a faixa de \ ate \, ponto". O hifen
# virava operador de faixa e sumia do conjunto, enquanto a propria contrabarra
# entrava nele. Resultado medido em 2026-08-28: `feat(frente-4):` era rejeitado
# apesar de o autor ter escrito a contrabarra justamente para admiti-la -- e um
# escopo contendo contrabarra, que ninguem quer, passava. Regra que nao
# implementa a propria intencao declarada, e que nenhum teste exercitava.
conventional_pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|ops)(\([a-zA-Z0-9_./-]+\))?(!)?: .+"

if ! echo "$commit_msg" | grep -Eq "$conventional_pattern"; then
    echo "[COMMIT-MSG REJEITADO] Fora do padrao Conventional Commits SOTA v8.0 GOLD."
    echo "   Recebido: '$commit_msg'"
    echo "   Esperado: <tipo>(<escopo opcional>): <descricao>"
    echo "   Tipos:    feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert, ops"
    echo "   Exemplo:  feat(engine): implementar avaliacao de equidade assincrona"
    exit 1
fi

msg_len=${#commit_msg}
if [ "$msg_len" -gt 100 ]; then
    echo "[COMMIT-MSG REJEITADO] Titulo com $msg_len caracteres (maximo 100)."
    exit 1
fi

# ---------------------------------------------------------------------------
# IDENTIDADE DE AUTORIA -- a SS7 vira executavel aqui.
#
# MEDIDO EM 2026-09-12. A SS7 exige que todo commit de agente declare a
# Assinatura no corpo, e que o campo de autor -- o unico que o GitHub le --
# identifique o agente. Nenhuma das duas metades era verificada:
#
#   - 16 dos 40 commits mais recentes NAO tinham linha `Assinatura:`;
#   - 5 dos 6 commits de 12/09 assinados `Codex GPT-5` eram do Gemini 3.8 Flash
#     via Antigravity CLI, que herda a identidade residual do condutor anterior
#     e nao a sobrescreve no comando.
#
# O desenho obvio -- comparar corpo com campo de autor -- nao pegaria NENHUM
# dos cinco: os tres commits do Gemini daquele dia nao tinham corpo a comparar.
# Por isso a exigencia da Assinatura vem PRIMEIRO; ela e o que torna a
# comparacao possivel. Uma regra so vale o que a outra habilita.
#
# O hook NAO adivinha quem esta conduzindo, e nao pode: o condutor declara, e o
# portao cobra que o campo de autor concorde com a declaracao. Tambem nao mexe
# em `git config` global -- a propria SS7 diz que isso so empurra a heranca para
# o proximo condutor. A correcao e por comando, e a mensagem abaixo a entrega
# pronta.
assinatura=$(sed '/^#/d' "$commit_msg_file" | grep -i '^Assinatura:' | head -n 1)

if [ -z "$assinatura" ]; then
    # AVISA, nao bloqueia -- e a escada da SS8.2 aplicada com honestidade sobre o
    # alcance. Bloquear aqui atingiria tambem o Tier 0 commitando a mao, que nao e
    # agente e nao deve satisfazer regra de agente; e o hook nao tem como
    # distinguir os dois sem confiar num campo que o proprio agente escolhe --
    # confiar nele daria ao agente o botao de se isentar. Promover isto a bloqueio
    # e reducao material, e cabe ao Tier 0.
    echo "[COMMIT-MSG AVISO] Sem linha 'Assinatura:'. A SS7 do CLAUDE.md a exige em commit de agente."
    echo "   O GitHub liga o commit a um perfil pelo E-MAIL do autor, nao pelo nome nem pelo corpo."
    echo "   Sem a assinatura, a malha nao audita quem escreveu o que -- e o portao abaixo,"
    echo "   que compara autor com assinatura, fica sem o que comparar."
    echo "   Formato: Assinatura: <agente> [Tier X] -- sessao <session_id>"
    exit 0
fi

# Nome declarado: o que vem antes de ' [', ' -- ' ou ' via '. Normalizado para
# so letras e digitos minusculos, porque 'antigravity@gemini-3.8-flash' e
# 'Gemini 3.8 Flash' sao a MESMA identidade escrita em duas convencoes -- a
# composta veiculo@modelo da SS7, e o nome que vai no campo de autor.
_normalizar() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9'
}

declarado=$(printf '%s' "$assinatura" | sed 's/^[Aa]ssinatura:[[:space:]]*//' | sed 's/ \[.*//; s/ -- .*//; s/ via .*//')
autor=$(git var GIT_AUTHOR_IDENT 2>/dev/null | sed 's/ <.*//')

n_decl=$(_normalizar "$declarado")
n_autor=$(_normalizar "$autor")

if [ -n "$n_decl" ] && [ -n "$n_autor" ]; then
    case "$n_decl" in
        *"$n_autor"*) ;;
        *)
            case "$n_autor" in
                *"$n_decl"*) ;;
                *)
                    echo "[COMMIT-MSG REJEITADO] O campo de autor nao concorda com a Assinatura declarada."
                    echo "   Assinatura diz: '$declarado'"
                    echo "   git dira:       '$autor'"
                    echo ""
                    echo "   Identidade do git e RESIDUAL: sobrevive a sessao que a escreveu, e numa malha"
                    echo "   em que os condutores se revezam o padrao e herdar a de quem operou por ultimo."
                    echo "   Foi assim que 5 commits do Gemini sairam assinados 'Codex GPT-5' em 12/09."
                    echo ""
                    echo "   Passe a identidade NO COMANDO -- nao altere a configuracao global,"
                    echo "   que so empurraria a heranca para o proximo condutor:"
                    echo "     git -c user.name='<nome canonico>' -c user.email='<noreply>' commit ..."
                    echo "   Os pares canonicos estao em data/agent_identities.json."
                    exit 1
                    ;;
            esac
            ;;
    esac
fi

# Autor fora do catalogo canonico: AVISA.
#
# MEDIDO EM 2026-09-12: o repositorio acumulou VINTE grafias de autor para cerca
# de cinco agentes -- 'Claude' e 'Claude Opus 5', 'Codex', 'Codex GPT-5' e
# 'Codex [Tier 1.B]', 'Gemini 3.8 Flash' e 'Gemini 3.8 Flash High'. Havia ate
# 'Chico SOTA v8.0 GOLD', que e o GRUPO no campo do autor individual.
#
# A checagem de coerencia acima nao pega isso: ela compara autor com assinatura,
# e as duas erram juntas quando o condutor escreve a mesma grafia nas duas. Por
# isso a fonte e um catalogo, e nao a propria mensagem.
#
# O grep e por nome exato entre aspas: casar por substring aceitaria 'Claude'
# dentro de 'Claude Opus 5' e derrotaria o proposito, que e distinguir variantes.
# `-F` NAO e zelo: sem ele, 'google-labs-jules[bot]' e uma EXPRESSAO, e `[bot]` vira
# classe de caracteres -- casa b, o ou t, nunca o colchete literal. O guard pegou
# isso na primeira execucao, e e o mesmo genero de defeito que o cabecalho de
# tests/test_hook_commit_msg.py documenta sobre colchetes em POSIX.
CATALOGO="data/agent_identities.json"
if [ -n "$autor" ] && [ -f "$CATALOGO" ]; then
    if ! grep -qF "\"nome\": \"$autor\"" "$CATALOGO"; then
        echo "[COMMIT-MSG AVISO] Autor '$autor' nao esta em $CATALOGO."
        echo "   Variante nova de um agente conhecido divide o historico dele em dois nomes,"
        echo "   e nenhuma medicao por autor volta a fechar. Use o nome canonico, ou"
        echo "   acrescente a identidade ao catalogo no mesmo commit se ela for nova."
    fi
fi

exit 0

#!/bin/sh
# pre-push: LFS + suite Python. set -e: qualquer etapa que falhe bloqueia o push.
#
# O portao de qualidade (npm run sota:audit) NAO roda aqui: ja rodou no pre-commit de cada
# commit e roda de novo no CI. Repeti-lo no push custava 26-42 s sem medir nada novo.
#
# suite_verde.py so mede se o CONTEUDO mudou desde o ultimo verde (~6 min quando mede).
# Rode antes de commitar para o push sair em segundos:  python scripts/ops/suite_verde.py
set -e

if command -v git-lfs >/dev/null 2>&1; then
    git lfs pre-push "$@"
fi

if command -v uv >/dev/null 2>&1; then
    uv run --no-sync python scripts/ops/suite_verde.py
elif [ -x ".venv/Scripts/python.exe" ]; then
    .venv/Scripts/python.exe scripts/ops/suite_verde.py
elif [ -x ".venv/bin/python" ]; then
    .venv/bin/python scripts/ops/suite_verde.py
else
    python scripts/ops/suite_verde.py
fi

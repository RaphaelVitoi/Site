# SOTA v7.0 GOLD: Autopoiese de Ambiente (Cross-OS Invariance)

export GEMINI_SOTA_MODE="v7"

# Descoberta Heurística do Sistema Hospedeiro (Nash Equilibrium de PATH)
if [ -n "$WSL_DISTRO_NAME" ] || [ "$(uname -s)" = "Linux" ]; then
    export UV_LINK_MODE="copy"
    export UV_PROJECT_ENVIRONMENT=".venv-wsl"
else
    export UV_PROJECT_ENVIRONMENT=".venv"
fi

export VIRTUAL_ENV="$PWD/$UV_PROJECT_ENVIRONMENT"

# Injeção Dinâmica na Memória (Agnosticismo de Shell)
PATH_add "$UV_PROJECT_ENVIRONMENT/bin"
PATH_add "$UV_PROJECT_ENVIRONMENT/Scripts"
